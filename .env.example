NODE_ENV=development
PORT=3000

DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

SEED_SYSTEM_ADMIN_PASSWORD=

# Authentication & Security Secrets
# AUTH_CSRF_SECRET must be different from AUTH_JWT_SECRET (minimum 32 characters each).
AUTH_JWT_SECRET=
AUTH_CSRF_SECRET=
AUTH_SESSION_TTL_DAYS=30

AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=15

# Number of trusted reverse-proxy hops.
# Keep 0 when the application is directly exposed.
# Use 1 only when the application is reachable exclusively through one trusted reverse proxy such as Nginx.
TRUST_PROXY_HOPS=0

