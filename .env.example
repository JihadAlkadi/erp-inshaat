NODE_ENV=development
PORT=3000

DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

SEED_SYSTEM_ADMIN_PASSWORD=

AUTH_JWT_SECRET=
AUTH_CSRF_SECRET=
AUTH_SESSION_TTL_DAYS=30
AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=15
# TRUST_PROXY_HOPS: Number of reverse proxy hops to trust (default: 0 = direct/disabled).
# Set to 1 if behind a single reverse proxy (e.g. Nginx). Only configure based on actual network topology.
TRUST_PROXY_HOPS=0
