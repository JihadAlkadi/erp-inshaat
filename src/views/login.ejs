<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تسجيل الدخول - ERP</title>
  
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  
  <style>
    body { 
      font-family: 'Cairo', sans-serif; 
      background-color: #714B67; /* لون أودو الرسمي */
      background-image: radial-gradient(circle at 50% 0%, #8a5e7e 0%, #714b67 70%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .login-wrapper {
      width: 100%;
      max-width: 400px;
      padding: 15px;
    }
    .login-card {
      background: white;
      border-radius: 12px;
      padding: 2.5rem;
      box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    }
    .form-control {
      background-color: #F3F4F6;
      border: 1px solid #E5E7EB;
    }
    .form-control:focus {
      background-color: #fff;
      border-color: #714B67;
      box-shadow: 0 0 0 3px rgba(113, 75, 103, 0.15);
    }
    .password-input-group {
      position: relative;
    }
    .password-input-group .form-control {
      padding-left: 2.75rem !important; /* مساحة لزر إظهار كلمة المرور على أقصى اليسار */
    }
    /* عند التحقق (صحيح أو خطأ)، توضع أيقونة التحقق قبل زر الإظهار (إلى يمينه) وتزداد إزاحة النص لمنع التداخل */
    .was-validated .password-input-group .form-control:valid,
    .password-input-group .form-control.is-valid,
    .was-validated .password-input-group .form-control:invalid,
    .password-input-group .form-control.is-invalid {
      background-position: left 2.35rem center !important;
      padding-left: 4.25rem !important;
    }
    .btn-toggle-password {
      position: absolute;
      left: 8px;
      top: 0;
      height: 38px;
      background: none;
      border: none;
      color: #9CA3AF;
      padding: 0.25rem 0.4rem;
      cursor: pointer;
      z-index: 5;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.15s ease;
    }
    .btn-toggle-password:hover {
      color: #714B67;
    }
    .btn-submit {
      background-color: #714B67;
      color: white;
      transition: all 0.2s;
    }
    .btn-submit:hover {
      background-color: #5a3c52;
      color: white;
    }
  </style>
</head>
<body>

  <div class="login-wrapper">
    <div class="login-card">
      <div class="text-center mb-4">
        <h2 class="fw-bold mb-1" style="color: #714B67;">نظام ERP</h2>
        <p class="text-muted small">تسجيل الدخول لبدء الجلسة</p>
      </div>

      <!-- صندوق عرض الأخطاء -->
      <div id="errorAlert" class="alert alert-danger d-none small fw-bold text-center py-2 mb-3"></div>

      <form id="loginForm" class="needs-validation" novalidate>
        <!-- حقل رقم الهاتف -->
        <div class="mb-3 text-start">
          <label class="form-label fw-bold text-dark small mb-2">رقم الهاتف</label>
          <div class="input-group has-validation">
            <span class="input-group-text bg-light border-end-0 text-muted ps-3"><i class="fa-solid fa-phone"></i></span>
            <input 
              type="tel" 
              name="phone" 
              id="phoneInput" 
              class="form-control border-start-0 px-2 text-start" 
              dir="ltr" 
              inputmode="numeric"
              placeholder="09XXXXXXXX" 
              pattern="^09[0-9]{8}$" 
              minlength="10" 
              maxlength="10" 
              required
            >
            <div class="invalid-feedback mt-1 small" id="phoneFeedback">
              يرجى إدخال رقم الهاتف
            </div>
          </div>
        </div>

        <!-- حقل كلمة المرور -->
        <div class="mb-4 text-start">
          <div class="d-flex justify-content-between mb-2">
            <label class="form-label fw-bold text-dark small mb-0">كلمة المرور</label>
            <a href="#" class="small text-decoration-none" style="color: #714B67;">نسيت كلمة المرور؟</a>
          </div>
          <div class="input-group has-validation password-input-group">
            <span class="input-group-text bg-light border-end-0 text-muted ps-3"><i class="fa-solid fa-lock"></i></span>
            <input 
              type="password" 
              name="password" 
              id="passwordInput"
              class="form-control border-start-0 px-2 text-start" 
              dir="ltr" 
              placeholder="••••••••" 
              minlength="6" 
              required
            >
            <!-- زر إظهار / إخفاء كلمة المرور على أقصى اليسار -->
            <button 
              type="button" 
              class="btn-toggle-password" 
              id="togglePassword" 
              tabindex="-1"
              aria-label="إظهار / إخفاء كلمة المرور"
            >
              <i class="fa-solid fa-eye-slash"></i>
            </button>
            <div class="invalid-feedback mt-1 small" id="passwordFeedback">
              يرجى إدخال كلمة المرور
            </div>
          </div>
        </div>

        <!-- زر تسجيل الدخول -->
        <button type="submit" class="btn btn-submit w-100 py-2 fw-bold fs-5 rounded-3 mt-2">
          تسجيل الدخول
        </button>
      </form>
    </div>
    
    <div class="text-center mt-4">
      <p class="text-white-50 small">جميع الحقوق محفوظة &copy; 2026</p>
    </div>
  </div>

  <!-- سكربت التحقق الخاص بصفحة تسجيل الدخول -->
  <script src="/js/login.js"></script>
</body>
</html>
