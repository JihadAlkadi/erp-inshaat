<link rel="stylesheet" href="/css/studies.css">

<!-- Header with Back Button (Matching Standard) -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-1" style="color: #1F2937;">
      إنشاء قالب تصنيع جديد <i class="fa-solid fa-compass-drafting text-muted fs-5 ms-2"></i>
    </h3>
    <p class="text-muted mb-0 small">تعريف منتج أو نموذج تصنيعي جديد مع كوده التقني ومواصفاته الأولية</p>
  </div>
  <a href="/studies/templates" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
    <i class="fa-solid fa-arrow-right"></i>
    <span>العودة للقائمة</span>
  </a>
</div>

<!-- Alert Container -->
<div id="formAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

<form id="createTemplateForm" class="needs-validation" novalidate>
  <div class="row g-4">
    <!-- Left Column: Basic Information -->
    <div class="col-12 col-lg-7">
      <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
        <div class="card-header bg-white border-bottom py-3">
          <h6 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-cube me-2 text-muted"></i> البيانات الأساسية للقالب
          </h6>
        </div>
        <div class="card-body p-4">
          <!-- Template Name -->
          <div class="mb-4">
            <label for="templateName" class="form-label fw-bold text-dark">اسم القالب <span class="text-danger">*</span></label>
            <div class="input-group has-validation">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-cubes"></i></span>
              <input type="text" class="form-control" id="templateName" name="name" required maxlength="150" placeholder="مثال: غرفة سكنية نموذج A">
              <div class="invalid-feedback">يرجى إدخال اسم القالب.</div>
            </div>
            <div class="form-text text-muted">الاسم المعياري للمنتج أو الغرفة المصنعة.</div>
          </div>

          <!-- Technical Code -->
          <div class="mb-4">
            <label for="templateCode" class="form-label fw-bold text-dark">الكود التقني (Code) <span class="text-danger">*</span></label>
            <div class="input-group has-validation">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-barcode"></i></span>
              <input type="text" class="form-control text-uppercase font-monospace" id="templateCode" name="code" required maxlength="50" placeholder="مثال: ROOM-A">
              <div class="invalid-feedback">يرجى إدخال الكود التقني.</div>
            </div>
            <div class="form-text text-muted">رمز فريد وثابت في النظام لا يمكن تعديله بعد الإنشاء، ويُشترط عدم تكراره إطلاقاً.</div>
          </div>

          <!-- Reference Number -->
          <div class="mb-4">
            <label for="templateReferenceNumber" class="form-label fw-bold text-dark">رقم / مرجع المنتج (Reference Number)</label>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-hashtag"></i></span>
              <input type="text" class="form-control" id="templateReferenceNumber" name="referenceNumber" maxlength="100" placeholder="مثال: REF-A01-2026">
            </div>
            <div class="form-text text-muted">الرقم المرجعي التجاري أو الهندسي المستخدم للتعريف في أوامر العمل والمخططات.</div>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label for="templateDescription" class="form-label fw-bold text-dark">الوصف والتفاصيل الهندسية</label>
            <textarea class="form-control" id="templateDescription" name="description" rows="3" placeholder="ملاحظات تفصيلية أو شروط تخطيطية للقالب..."></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Initial Specifications (Optional) -->
    <div class="col-12 col-lg-5">
      <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
          <h6 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-ruler-combined me-2 text-muted"></i> المواصفات الهندسية الأولية
          </h6>
          <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddSpecRow">
            <i class="fa-solid fa-plus me-1"></i> إضافة خاصية
          </button>
        </div>
        <div class="card-body p-3">
          <p class="text-muted small mb-3">يمكنك إدخال المواصفات الديناميكية (مثل: الطول، العرض، الارتفاع، العزل) الآن أو إدارتها لاحقاً في صفحة القالب.</p>
          <div id="specificationsListContainer" class="d-flex flex-column gap-2">
            <!-- Dynamic Spec Input Rows -->
          </div>
        </div>
      </div>
    </div>

    <!-- Submit Footer -->
    <div class="col-12">
      <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-3 d-flex justify-content-between align-items-center">
          <a href="/studies/templates" class="btn btn-light px-4">إلغاء</a>
          <button type="submit" id="btnSubmitTemplate" class="btn studies-theme-btn px-5 d-inline-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm d-none" id="submitSpinner" role="status" aria-hidden="true"></span>
            <i class="fa-solid fa-floppy-disk"></i>
            <span>حفظ القالب</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</form>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('createTemplateForm');
    const alertBox = document.getElementById('formAlert');
    const btnSubmit = document.getElementById('btnSubmitTemplate');
    const spinner = document.getElementById('submitSpinner');
    const btnAddSpec = document.getElementById('btnAddSpecRow');
    const specContainer = document.getElementById('specificationsListContainer');

    function createSpecRow(nameVal = '', valueVal = '', unitVal = '') {
      const row = document.createElement('div');
      row.className = 'card bg-light border-0 p-2 position-relative spec-input-card';
      row.innerHTML = `
        <div class="row g-2 align-items-center">
          <div class="col-5">
            <input type="text" class="form-control form-control-sm spec-name" placeholder="الخاصية (مثلاً: الطول)" value="${nameVal}">
          </div>
          <div class="col-4">
            <input type="text" class="form-control form-control-sm spec-val" placeholder="القيمة (مثلاً: 6)" value="${valueVal}">
          </div>
          <div class="col-2">
            <input type="text" class="form-control form-control-sm spec-unit" placeholder="الوحدة (متر)" value="${unitVal}">
          </div>
          <div class="col-1 text-center">
            <button type="button" class="btn btn-sm btn-link text-danger p-0 btn-remove-spec"><i class="fa-solid fa-times"></i></button>
          </div>
        </div>
      `;
      row.querySelector('.btn-remove-spec').addEventListener('click', () => row.remove());
      specContainer.appendChild(row);
    }

    // Add 3 default rows as convenient suggestions (الطول، العرض، الارتفاع)
    createSpecRow('الطول', '', 'متر');
    createSpecRow('العرض', '', 'متر');
    createSpecRow('الارتفاع', '', 'متر');

    btnAddSpec.addEventListener('click', () => createSpecRow());

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.classList.add('d-none');
      alertBox.textContent = '';

      if (!form.checkValidity()) {
        form.classList.add('was-validated');
        return;
      }

      const name = document.getElementById('templateName').value.trim();
      const code = document.getElementById('templateCode').value.trim().toUpperCase();
      const referenceNumber = document.getElementById('templateReferenceNumber').value.trim() || undefined;
      const description = document.getElementById('templateDescription').value.trim() || undefined;

      const specifications = [];
      const specRows = specContainer.querySelectorAll('.spec-input-card');
      specRows.forEach((r, idx) => {
        const sName = r.querySelector('.spec-name').value.trim();
        const sVal = r.querySelector('.spec-val').value.trim();
        const sUnit = r.querySelector('.spec-unit').value.trim();
        if (sName && sVal) {
          specifications.push({
            name: sName,
            value: sVal,
            unit: sUnit || undefined,
            sortOrder: idx + 1
          });
        }
      });

      const payload = {
        name,
        code,
        referenceNumber,
        description,
        specifications: specifications.length > 0 ? specifications : undefined
      };

      btnSubmit.disabled = true;
      spinner.classList.remove('d-none');

      try {
        const res = await window.erpFetch('/api/studies/templates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok && data.success) {
          sessionStorage.setItem('pendingToast', 'تم إنشاء قالب التصنيع بنجاح');
          window.location.href = `/studies/templates/${data.data.id}`;
        } else {
          const msg = data.message || (data.errors ? Object.values(data.errors).flat().join('، ') : 'حدث خطأ أثناء حفظ القالب');
          alertBox.textContent = msg;
          alertBox.classList.remove('d-none');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      } catch (err) {
        alertBox.textContent = 'تعذر الاتصال بالخادم. يرجى المحاولة مرة أخرى.';
        alertBox.classList.remove('d-none');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } finally {
        btnSubmit.disabled = false;
        spinner.classList.add('d-none');
      }
    });
  });
</script>
