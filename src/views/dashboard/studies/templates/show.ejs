<link rel="stylesheet" href="/css/studies.css">

<!-- Template Master Header -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; border-right: 5px solid #4F46E5 !important;">
  <div class="card-body p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <div class="d-flex align-items-center gap-3 mb-1">
          <h2 class="fw-bold mb-0 text-dark"><%= template.name %></h2>
          <% if (template.isActive) { %>
            <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">
              <i class="fa-solid fa-circle-check me-1"></i> نشط
            </span>
          <% } else { %>
            <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill">
              <i class="fa-solid fa-circle-xmark me-1"></i> معطل
            </span>
          <% } %>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 text-muted small mt-2">
          <span><i class="fa-solid fa-barcode me-1 text-secondary"></i> الكود التقني: <strong class="text-dark font-monospace"><%= template.code %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-hashtag me-1 text-secondary"></i> المرجع: <strong class="text-dark"><%= template.referenceNumber || 'غير محدد' %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-layer-group me-1 text-secondary"></i> عدد المراحل: <strong class="text-dark" id="headerStageCount"><%= template.stages ? template.stages.length : 0 %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-calendar me-1 text-secondary"></i> تاريخ الإنشاء: <%= new Date(template.createdAt).toLocaleDateString('ar-EG') %></span>
        </div>
        <% if (template.description) { %>
          <p class="text-muted small mt-3 mb-0" style="max-width: 800px;"><%= template.description %></p>
        <% } %>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-2">
        <a href="/studies/templates" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
          <i class="fa-solid fa-arrow-right"></i>
          <span>العودة للقائمة</span>
        </a>
        <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
          <a href="/studies/templates/<%= template.id %>/edit" class="btn btn-outline-primary d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>تعديل المعلومات</span>
          </a>
          <button type="button" id="btnToggleTemplateStatus" class="btn <%= template.isActive ? 'btn-outline-warning' : 'btn-outline-success' %> d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
            <i class="fa-solid <%= template.isActive ? 'fa-ban' : 'fa-check' %>"></i>
            <span><%= template.isActive ? 'تعطيل القالب' : 'تفعيل القالب' %></span>
          </button>
        <% } %>
        <% if (typeof canDeleteTemplate !== 'undefined' && canDeleteTemplate) { %>
          <button type="button" id="btnArchiveTemplate" class="btn btn-outline-danger d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
            <i class="fa-solid fa-trash-can"></i>
            <span>أرشفة</span>
          </button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Main Workspace: Specifications & Workflow Grid -->
<div class="row g-4">
  <!-- Right Column (on RTL): Specifications Section (col-12 col-xl-4) -->
  <div class="col-12 col-xl-4">
    <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <div>
          <h6 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-ruler-combined me-2 text-primary" style="color: #4F46E5 !important;"></i> المواصفات الهندسية
          </h6>
          <span class="text-muted small">المعايير والأبعاد الديناميكية للقالب</span>
        </div>
        <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
          <button type="button" class="btn btn-sm btn-outline-primary" id="btnOpenAddSpecModal">
            <i class="fa-solid fa-plus me-1"></i> إضافة خاصية
          </button>
        <% } %>
      </div>
      <div class="card-body p-3">
        <div id="specificationsContainer" class="d-flex flex-column gap-2">
          <% if (template.specifications && template.specifications.length > 0) { %>
            <% template.specifications.forEach(function(spec, index) { %>
              <div class="card border p-2 spec-item" data-spec-id="<%= spec.id %>" data-sort-order="<%= spec.sortOrder %>" style="border-radius: 8px;">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <strong class="text-dark spec-display-name"><%= spec.name %></strong>
                    <div class="text-muted small">
                      <span class="badge bg-light text-dark border spec-display-value"><%= spec.value %></span>
                      <% if (spec.unit) { %>
                        <span class="ms-1 spec-display-unit"><%= spec.unit %></span>
                      <% } %>
                    </div>
                  </div>
                  <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
                    <div class="d-flex align-items-center gap-1">
                      <button type="button" class="btn btn-sm btn-light p-1 btn-move-spec-up" title="تحريك لأعلى" <%= index === 0 ? 'disabled' : '' %>>
                        <i class="fa-solid fa-arrow-up text-secondary"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-light p-1 btn-move-spec-down" title="تحريك لأسفل" <%= index === template.specifications.length - 1 ? 'disabled' : '' %>>
                        <i class="fa-solid fa-arrow-down text-secondary"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-light p-1 btn-edit-spec" title="تعديل">
                        <i class="fa-solid fa-pen text-primary"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-light p-1 btn-delete-spec" title="حذف">
                        <i class="fa-solid fa-trash-can text-danger"></i>
                      </button>
                    </div>
                  <% } %>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div id="emptySpecsNotice" class="text-center py-4 text-muted border border-dashed rounded-3 bg-light bg-opacity-50">
              <i class="fa-solid fa-ruler-combined fs-2 mb-2 text-secondary opacity-50"></i>
              <p class="mb-1 fw-bold">لا توجد مواصفات محددة</p>
              <p class="small text-muted mb-0">انقر على زر "إضافة خاصية" لإدخال أبعاد ومواصفات المنتج.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Left Column (on RTL): Stages & Workflow Section (col-12 col-xl-8) -->
  <div class="col-12 col-xl-8">
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
      <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <h5 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-diagram-project me-2" style="color: #4F46E5;"></i> مراحل التصنيع وسير العمل (Workflow)
          </h5>
          <p class="text-muted small mb-0">
            ترتيب عالمي للمراحل مع تجميع بصري تلقائي للأقسام المتجاورة. اسحب المقبض <i class="fa-solid fa-grip-vertical text-muted"></i> لإعادة الترتيب.
          </p>
        </div>
        <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
          <div>
            <button type="button" class="btn studies-theme-btn px-3 d-inline-flex align-items-center gap-2" id="btnOpenAddStageModal">
              <i class="fa-solid fa-plus"></i>
              <span>إضافة مرحلة جديدة</span>
            </button>
          </div>
        <% } %>
      </div>

      <div class="card-body p-4">
        <!-- Consecutive Department Groups Container -->
        <div id="workflowGroupsContainer">
          <!-- Dynamically populated or rendered server-side -->
        </div>

        <!-- Empty Stages State Notice -->
        <div id="emptyStagesNotice" class="text-center py-5 text-muted border border-dashed rounded-3 bg-light bg-opacity-50 <%= template.stages && template.stages.length > 0 ? 'd-none' : '' %>">
          <i class="fa-solid fa-diagram-project fs-1 mb-3 text-secondary opacity-50"></i>
          <h5 class="fw-bold mb-1 text-dark">لم يتم إضافة مراحل تصنيع لهذا القالب بعد</h5>
          <p class="small text-muted mb-3">ابدأ بإضافة أول مرحلة تصنيع وتحديد القسم التشغيلي والمواد المخططة لها.</p>
          <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
            <button type="button" class="btn studies-theme-btn px-4" onclick="document.getElementById('btnOpenAddStageModal').click()">
              <i class="fa-solid fa-plus me-1"></i> إضافة أول مرحلة
            </button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ======================================================== -->
<!-- MODALS                                                   -->
<!-- ======================================================== -->

<!-- 1. Modal: Add Specification -->
<div class="modal fade" id="addSpecModal" tabindex="-1" aria-labelledby="addSpecModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom">
        <h6 class="modal-title fw-bold" id="addSpecModalLabel"><i class="fa-solid fa-plus text-primary me-2"></i> إضافة خاصية جديدة</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="addSpecForm" class="needs-validation" novalidate>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label for="newSpecName" class="form-label fw-bold small text-dark">اسم الخاصية <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="newSpecName" required placeholder="مثال: الطول، العزل، عدد النوافذ">
            <div class="invalid-feedback">يرجى إدخال اسم الخاصية.</div>
          </div>
          <div class="mb-3">
            <label for="newSpecValue" class="form-label fw-bold small text-dark">القيمة <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="newSpecValue" required placeholder="مثال: 6، بولي يوريثان، 2">
            <div class="invalid-feedback">يرجى إدخال القيمة.</div>
          </div>
          <div class="mb-3">
            <label for="newSpecUnit" class="form-label fw-bold small text-dark">وحدة القياس (اختياري)</label>
            <input type="text" class="form-control" id="newSpecUnit" placeholder="مثال: متر، سم، ملم، كغ">
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">إلغاء</button>
          <button type="submit" id="btnSubmitAddSpec" class="btn studies-theme-btn px-4">إضافة الخاصية</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 2. Modal: Edit Specification -->
<div class="modal fade" id="editSpecModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom">
        <h6 class="modal-title fw-bold"><i class="fa-solid fa-pen text-primary me-2"></i> تعديل الخاصية</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editSpecForm" class="needs-validation" novalidate>
        <input type="hidden" id="editSpecId">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label for="editSpecName" class="form-label fw-bold small text-dark">اسم الخاصية <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="editSpecName" required>
            <div class="invalid-feedback">يرجى إدخال اسم الخاصية.</div>
          </div>
          <div class="mb-3">
            <label for="editSpecValue" class="form-label fw-bold small text-dark">القيمة <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="editSpecValue" required>
            <div class="invalid-feedback">يرجى إدخال القيمة.</div>
          </div>
          <div class="mb-3">
            <label for="editSpecUnit" class="form-label fw-bold small text-dark">وحدة القياس (اختياري)</label>
            <input type="text" class="form-control" id="editSpecUnit">
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">إلغاء</button>
          <button type="submit" id="btnSubmitEditSpec" class="btn studies-theme-btn px-4">حفظ التعديل</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 3. Modal: Add Stage -->
<div class="modal fade" id="addStageModal" tabindex="-1" aria-labelledby="addStageModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom">
        <h6 class="modal-title fw-bold" id="addStageModalLabel"><i class="fa-solid fa-plus text-primary me-2"></i> إضافة مرحلة تصنيع جديدة</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="addStageForm" class="needs-validation" novalidate>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label for="newStageName" class="form-label fw-bold small text-dark">اسم المرحلة <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="newStageName" required placeholder="مثال: صب الأرضية، تركيب السقف">
            <div class="invalid-feedback">يرجى إدخال اسم المرحلة.</div>
          </div>

          <div class="mb-3">
            <label for="newStageDepartmentId" class="form-label fw-bold small text-dark">القسم التشغيلي المسؤول <span class="text-danger">*</span></label>
            <select class="form-select" id="newStageDepartmentId" required>
              <option value="">-- اختر القسم الإنتاجي --</option>
              <% if (typeof departments !== 'undefined' && departments) { %>
                <% departments.forEach(function(dept) { %>
                  <option value="<%= dept.id %>"><%= dept.name %> (<%= dept.code %>)</option>
                <% }); %>
              <% } %>
            </select>
            <div class="invalid-feedback">يرجى اختيار القسم التشغيلي.</div>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label for="newStageDuration" class="form-label fw-bold small text-dark">المدة التقديرية (بالدقائق)</label>
              <input type="number" class="form-control" id="newStageDuration" min="1" step="1" placeholder="مثال: 120 (ساعتان)">
              <div class="form-text text-muted">المدة الزمنية التقديرية لإنجاز المرحلة.</div>
            </div>
            <div class="col-6">
              <label for="newStageCost" class="form-label fw-bold small text-dark">التكلفة التقديرية (اختياري)</label>
              <input type="number" class="form-control" id="newStageCost" min="0" step="0.01" placeholder="0.00">
              <div class="form-text text-muted">التكلفة المالية التقديرية.</div>
            </div>
          </div>

          <div class="mb-2">
            <label for="newStageDescription" class="form-label fw-bold small text-dark">الوصف وملاحظات التنفيذ</label>
            <textarea class="form-control" id="newStageDescription" rows="2" placeholder="تعليمات تشغيلية محددة لهذه المرحلة..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">إلغاء</button>
          <button type="submit" id="btnSubmitAddStage" class="btn studies-theme-btn px-4">إضافة المرحلة</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 4. Modal: Edit Stage -->
<div class="modal fade" id="editStageModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom">
        <h6 class="modal-title fw-bold"><i class="fa-solid fa-pen text-primary me-2"></i> تعديل بيانات المرحلة</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editStageForm" class="needs-validation" novalidate>
        <input type="hidden" id="editStageId">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label for="editStageName" class="form-label fw-bold small text-dark">اسم المرحلة <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="editStageName" required>
            <div class="invalid-feedback">يرجى إدخال اسم المرحلة.</div>
          </div>

          <div class="mb-3">
            <label for="editStageDepartmentId" class="form-label fw-bold small text-dark">القسم التشغيلي المسؤول <span class="text-danger">*</span></label>
            <select class="form-select" id="editStageDepartmentId" required>
              <option value="">-- اختر القسم الإنتاجي --</option>
              <% if (typeof departments !== 'undefined' && departments) { %>
                <% departments.forEach(function(dept) { %>
                  <option value="<%= dept.id %>"><%= dept.name %> (<%= dept.code %>)</option>
                <% }); %>
              <% } %>
            </select>
            <div class="form-text text-muted">تعديل القسم يعيد تجميع المجموعات البصرية تلقائياً دون تغيير الترتيب.</div>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label for="editStageDuration" class="form-label fw-bold small text-dark">المدة التقديرية (بالدقائق)</label>
              <input type="number" class="form-control" id="editStageDuration" min="1" step="1">
            </div>
            <div class="col-6">
              <label for="editStageCost" class="form-label fw-bold small text-dark">التكلفة التقديرية</label>
              <input type="number" class="form-control" id="editStageCost" min="0" step="0.01">
            </div>
          </div>

          <div class="mb-2">
            <label for="editStageDescription" class="form-label fw-bold small text-dark">الوصف وملاحظات التنفيذ</label>
            <textarea class="form-control" id="editStageDescription" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">إلغاء</button>
          <button type="submit" id="btnSubmitEditStage" class="btn studies-theme-btn px-4">حفظ التعديل</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 5. Modal: Planned Materials Management -->
<div class="modal fade" id="stageMaterialsModal" tabindex="-1" aria-labelledby="stageMaterialsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom py-3">
        <div>
          <h6 class="modal-title fw-bold text-dark" id="stageMaterialsModalLabel">
            <i class="fa-solid fa-boxes-stacked text-primary me-2"></i> المواد المخططة للمرحلة: <span id="materialsModalStageName" class="text-primary"></span>
          </h6>
          <span class="text-muted small">تحديد المواد والكميات المعيارية المطلوبة من كتالوج المستودعات</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Add Material Form Inside Modal -->
        <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
          <div class="card border mb-4 bg-light bg-opacity-50" style="border-radius: 10px;">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-3 small text-dark"><i class="fa-solid fa-plus-circle me-1 text-primary"></i> إضافة مادة جديدة للمرحلة</h6>
              <form id="addStageMaterialForm" class="row g-2 align-items-end needs-validation" novalidate>
                <div class="col-12 col-md-5">
                  <label for="selectMaterialProduct" class="form-label fw-bold small text-dark">المادة / المنتج من الكتالوج <span class="text-danger">*</span></label>
                  <select class="form-select form-select-sm" id="selectMaterialProduct" required>
                    <option value="">-- اختر مادة من الكتالوج --</option>
                    <% if (typeof products !== 'undefined' && products) { %>
                      <% products.forEach(function(p) { %>
                        <option value="<%= p.id %>"><%= p.name %> (<%= p.code %>)</option>
                      <% }); %>
                    <% } %>
                  </select>
                  <div class="invalid-feedback">يرجى اختيار المادة.</div>
                </div>

                <div class="col-12 col-md-3">
                  <label for="selectMaterialUnit" class="form-label fw-bold small text-dark">وحدة القياس <span class="text-danger">*</span></label>
                  <select class="form-select form-select-sm" id="selectMaterialUnit" required disabled>
                    <option value="">-- اختر الوحدة --</option>
                  </select>
                  <div class="invalid-feedback">يرجى اختيار الوحدة.</div>
                </div>

                <div class="col-12 col-md-2">
                  <label for="inputMaterialQuantity" class="form-label fw-bold small text-dark">الكمية المخططة <span class="text-danger">*</span></label>
                  <input type="number" class="form-control form-control-sm" id="inputMaterialQuantity" min="0.0001" step="any" placeholder="الكمية" required>
                  <div class="invalid-feedback">أدخل كمية صالحة > 0</div>
                </div>

                <div class="col-12 col-md-2">
                  <button type="submit" id="btnSubmitAddMaterial" class="btn btn-sm studies-theme-btn w-100">
                    <i class="fa-solid fa-plus me-1"></i> إضافة
                  </button>
                </div>
              </form>
            </div>
          </div>
        <% } %>

        <!-- Existing Materials Table in Stage -->
        <h6 class="fw-bold mb-2 small text-dark"><i class="fa-solid fa-list me-1 text-muted"></i> المواد المحددة حالياً للمرحلة</h6>
        <div class="table-responsive border rounded-3">
          <table class="table table-hover align-middle mb-0" id="stageMaterialsTable">
            <thead class="table-light">
              <tr class="small text-muted">
                <th>المادة / المنتج</th>
                <th>الكود</th>
                <th>الوحدة</th>
                <th class="text-center">الكمية المخططة</th>
                <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
                  <th class="text-center">إجراءات</th>
                <% } %>
              </tr>
            </thead>
            <tbody id="stageMaterialsTableBody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>

      <div class="modal-footer border-top bg-light py-2">
        <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">إغلاق</button>
      </div>
    </div>
  </div>
</div>

<script>
  window.STUDIES_CONFIG = {
    templateId: '<%= template.id %>',
    canUpdateTemplate: <%= typeof canUpdateTemplate !== 'undefined' ? canUpdateTemplate : false %>,
    canDeleteTemplate: <%= typeof canDeleteTemplate !== 'undefined' ? canDeleteTemplate : false %>,
    departments: <%- JSON.stringify(typeof departments !== 'undefined' && departments ? departments : []) %>,
    products: <%- JSON.stringify(typeof products !== 'undefined' && products ? products : []) %>,
    initialStages: <%- JSON.stringify(template.stages || []) %>
  };
</script>
<script src="/js/studies-template-detail.js"></script>
