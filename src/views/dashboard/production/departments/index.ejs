<div class="container-fluid">
  <!-- Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h3 class="fw-bold mb-1" style="color: #1F2937;">
        أقسام الإنتاج
        <i class="fa-solid fa-building-user text-muted fs-5 ms-2"></i>
      </h3>
      <p class="text-muted mb-0 small">
        إدارة الأقسام التشغيلية المستقلة لتطبيق الإنتاج
      </p>
    </div>
    <div class="d-flex gap-2">
      <% if (canCreate) { %>
        <a href="/production/departments/create" class="btn btn-primary d-inline-flex align-items-center gap-2" style="background-color: #0984E3; border-color: #0984E3;">
          <i class="fa-solid fa-plus"></i>
          <span>إنشاء قسم جديد</span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-3">
      <form method="GET" action="/production/departments" class="row g-2 align-items-center">
        <div class="col-md-6 col-lg-4">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
            <input type="text" name="search" class="form-control border-start-0 bg-light" placeholder="بحث بالاسم أو الرمز التقني..." value="<%= search %>">
          </div>
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-outline-secondary">بحث</button>
          <% if (search) { %>
            <a href="/production/departments" class="btn btn-link text-muted text-decoration-none">إلغاء الفلتر</a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Departments Table Card -->
  <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light text-muted" style="font-size: 0.85rem;">
          <tr>
            <th class="ps-4 py-3">اسم القسم</th>
            <th class="py-3">الرمز التقني</th>
            <th class="py-3 text-center">إجمالي الساحات</th>
            <th class="py-3 text-center">الساحات النشطة</th>
            <th class="py-3 text-center">الحالة</th>
            <th class="py-3">تاريخ الإنشاء</th>
            <th class="pe-4 py-3 text-end">الإجراءات</th>
          </tr>
        </thead>
        <tbody>
          <% if (departments && departments.length > 0) { %>
            <% departments.forEach(function(dept) { %>
              <tr>
                <td class="ps-4">
                  <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex justify-content-center align-items-center text-white fw-bold" style="width: 40px; height: 40px; background-color: #0984E3; font-size: 1rem;">
                      <%= dept.name ? dept.name.charAt(0) : 'D' %>
                    </div>
                    <div>
                      <div class="fw-bold text-dark"><%= dept.name %></div>
                      <% if (dept.description) { %>
                        <div class="text-muted small text-truncate" style="max-width: 250px;"><%= dept.description %></div>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <code class="bg-light text-dark px-2 py-1 rounded border"><%= dept.code %></code>
                </td>
                <td class="text-center">
                  <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill">
                    <%= dept.yardCount || 0 %>
                  </span>
                </td>
                <td class="text-center">
                  <span class="badge bg-info-subtle text-info-emphasis px-3 py-1 rounded-pill">
                    <%= dept.activeYardCount || 0 %>
                  </span>
                </td>
                <td class="text-center">
                  <% if (dept.isActive) { %>
                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">
                      <i class="fa-solid fa-circle-check me-1"></i> نشط
                    </span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill">
                      <i class="fa-solid fa-circle-xmark me-1"></i> معطل
                    </span>
                  <% } %>
                </td>
                <td class="text-muted small">
                  <%= new Date(dept.createdAt).toLocaleDateString('ar-SA', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </td>
                <td class="pe-4 text-end">
                  <div class="dropdown">
                    <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown">
                      <i class="fa-solid fa-ellipsis-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                      <% if (canUpdate) { %>
                        <li>
                          <a class="dropdown-item d-flex align-items-center gap-2" href="/production/departments/<%= dept.id %>/edit">
                            <i class="fa-solid fa-pen-to-square text-primary"></i>
                            <span>تعديل البيانات</span>
                          </a>
                        </li>
                        <li>
                          <button
                            class="dropdown-item d-flex align-items-center gap-2"
                            data-action="toggle-department-status"
                            data-department-id="<%= dept.id %>"
                            data-department-name="<%= dept.name %>"
                            data-new-status="<%= dept.isActive ? 'false' : 'true' %>"
                            data-active-yards="<%= dept.activeYardCount || 0 %>"
                          >
                            <% if (dept.isActive) { %>
                              <i class="fa-solid fa-toggle-off text-warning"></i>
                              <span>تعطيل القسم</span>
                            <% } else { %>
                              <i class="fa-solid fa-toggle-on text-success"></i>
                              <span>تفعيل القسم</span>
                            <% } %>
                          </button>
                        </li>
                      <% } %>
                      <% if (canDelete) { %>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <button
                            class="dropdown-item d-flex align-items-center gap-2 text-danger"
                            data-action="delete-department"
                            data-department-id="<%= dept.id %>"
                            data-department-name="<%= dept.name %>"
                            data-yard-count="<%= dept.yardCount || 0 %>"
                          >
                            <i class="fa-solid fa-box-archive"></i>
                            <span>أرشفة القسم</span>
                          </button>
                        </li>
                      <% } %>
                    </ul>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <i class="fa-solid fa-building-user fs-1 text-secondary mb-3 d-block"></i>
                <p class="mb-0 fw-bold">لا توجد أقسام إنتاج مسجلة حالياً</p>
                <% if (search) { %>
                  <small class="text-muted">جرب البحث بكلمات أخرى أو إلغاء الفلتر</small>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center py-3 px-4">
        <div class="text-muted small">
          إجمالي السجلات: <span class="fw-bold"><%= pagination.total %></span>
        </div>
        <nav>
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= pagination.page - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">السابق</a>
            </li>
            <% for (let p = 1; p <= pagination.totalPages; p++) { %>
              <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= p %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"><%= p %></a>
              </li>
            <% } %>
            <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= pagination.page + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">التالي</a>
            </li>
          </ul>
        </nav>
      </div>
    <% } %>
  </div>
</div>

<script src="/js/production-departments.js"></script>
