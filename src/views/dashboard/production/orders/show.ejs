<link rel="stylesheet" href="/css/production-orders.css">

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
      <h3 class="fw-bold mb-0" style="color: #1F2937;">
        أمر الإنتاج <span class="font-monospace text-primary"><%= order.orderNumber %></span>
      </h3>
      <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-1 rounded-pill">مسودة</span>
      <% if (typeof readiness !== 'undefined' && readiness) { %>
        <% if (readiness.ready) { %>
          <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">
            <i class="fa-solid fa-circle-check me-1"></i> جاهز
          </span>
        <% } %>
      <% } %>
    </div>
    <p class="text-muted mb-0 small">تفاصيل أمر الإنتاج والبنود والخيارات المحددة</p>
  </div>

  <div class="d-flex align-items-center gap-2">
    <a href="/production/orders" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
      <i class="fa-solid fa-arrow-right"></i>
      <span>قائمة الأوامر</span>
    </a>
    <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder && order.status === 'DRAFT') { %>
      <a href="/production/orders/<%= order.id %>/edit" id="editOrderNavBtn" class="btn production-theme-btn d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm" style="border-radius: 8px;">
        <i class="fa-solid fa-pen-to-square"></i>
        <span>تعديل الطلب</span>
      </a>
    <% } %>
  </div>
</div>

<!-- Order Summary & KPIs -->
<div class="row g-3 mb-4">
  <!-- Summary Card -->
  <div class="col-12 col-lg-7">
    <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
      <div class="card-body p-4 d-flex flex-column justify-content-between">
        <div>
          <div class="text-muted small fw-semibold mb-2">الوصف:</div>
          <p class="text-dark mb-3 fs-6">
            <%= order.description || 'لا يوجد وصف محدد لهذا الطلب.' %>
          </p>

          <% if (order.notes) { %>
            <div class="p-2 px-3 rounded bg-light border text-muted small mb-3">
              <strong class="text-secondary"><i class="fa-solid fa-note-sticky me-1"></i> ملاحظات:</strong> <%= order.notes %>
            </div>
          <% } %>
        </div>

        <div class="d-flex align-items-center gap-3 text-muted small pt-2 border-top flex-wrap">
          <span><i class="fa-solid fa-user me-1 text-secondary"></i> منشئ الطلب: <strong><%= order.createdByUser ? order.createdByUser.fullName : 'غير محدد' %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-calendar me-1 text-secondary"></i> تاريخ الإنشاء: <span><%= new Date(order.createdAt).toLocaleDateString('ar-EG') %></span></span>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="col-12 col-lg-5">
    <div class="d-flex flex-column gap-3 h-100 justify-content-center">
      <div class="production-kpi-card">
        <div class="production-kpi-icon">
          <i class="fa-solid fa-cubes"></i>
        </div>
        <div>
          <div class="text-muted small fw-semibold">عدد البنود</div>
          <div class="fs-4 fw-bold text-dark"><%= order.summary.lineCount %></div>
        </div>
      </div>

      <div class="production-kpi-card">
        <div class="production-kpi-icon">
          <i class="fa-solid fa-hashtag"></i>
        </div>
        <div>
          <div class="text-muted small fw-semibold">إجمالي الكمية المخططة</div>
          <div class="fs-4 fw-bold text-dark"><%= order.summary.totalQuantity %> <span class="fs-6 text-muted fw-normal">وحدة</span></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Readiness Issues (if any) -->
<% if (typeof readiness !== 'undefined' && readiness && !readiness.ready && readiness.issues && readiness.issues.length > 0) { %>
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; border-right: 5px solid #FF9F43 !important; background-color: #FFFDF8;">
    <div class="card-body p-3 p-md-4">
      <div class="fw-bold text-warning-emphasis d-flex align-items-center gap-2 mb-2">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>حالة الجاهزية:</span>
      </div>
      <p class="text-muted small mb-2">هناك بيانات تحتاج المراجعة قبل اعتماد الطلب للإنتاج:</p>
      <ul class="mb-0 pe-3">
        <% readiness.issues.forEach(function(issue) { %>
          <li class="small text-danger mb-1"><%= issue.message %></li>
        <% }); %>
      </ul>
    </div>
  </div>
<% } %>

<!-- Lines Section Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h5 class="fw-bold mb-0 text-dark">
      <i class="fa-solid fa-list-check me-2 text-primary"></i> بنود أمر الإنتاج
    </h5>
    <div class="text-muted small">تفاصيل القوالب والكميات والخيارات المحددة لكل بند (عرض فقط)</div>
  </div>
  <span class="badge bg-secondary-subtle text-secondary-emphasis px-3 py-2 rounded-pill">
    <%= (order.lines ? order.lines.length : 0) %> عنصر
  </span>
</div>

<!-- Production Lines Table -->
<% if (!order.lines || order.lines.length === 0) { %>
  <div class="card border-0 shadow-sm text-center py-5" style="border-radius: 12px;">
    <div class="card-body py-4">
      <div class="mb-3 text-secondary" style="font-size: 3rem;">
        <i class="fa-solid fa-cubes-stacked"></i>
      </div>
      <h5 class="fw-bold text-dark mb-1">لا توجد بنود إنتاج في هذا الطلب بعد</h5>
      <p class="text-muted small mb-3">لم تتم إضافة أي بنود إنتاج إلى هذه المسودة حتى الآن.</p>
      <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder && order.status === 'DRAFT') { %>
        <a href="/production/orders/<%= order.id %>/edit" class="btn production-theme-btn btn-sm px-4 py-2">
          <i class="fa-solid fa-pen-to-square me-1"></i> إعداد الطلب
        </a>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="card border-0 shadow-sm show-lines-card mb-4">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr class="text-muted small">
            <th class="py-3 px-3 text-center" style="width: 60px;">#</th>
            <th class="py-3 px-3">القالب</th>
            <th class="py-3 px-3">الكود</th>
            <th class="py-3 px-3 text-center" style="width: 120px;">الكمية</th>
            <th class="py-3 px-3">الأنماط المختارة</th>
          </tr>
        </thead>
        <tbody>
          <% order.lines.forEach(function(line) { %>
            <tr>
              <td class="text-center font-monospace text-muted fw-bold">#<%= line.sortOrder %></td>
              <td>
                <div class="fw-bold text-dark"><%= line.template ? line.template.name : 'قالب غير معروف' %></div>
                <% if (line.template && line.template.referenceNumber) { %>
                  <div class="text-muted small font-monospace">المرجع: <%= line.template.referenceNumber %></div>
                <% } %>
              </td>
              <td>
                <span class="badge bg-light text-secondary font-monospace border"><%= line.template ? line.template.code : '—' %></span>
              </td>
              <td class="text-center">
                <span class="fw-bold text-primary font-monospace fs-6"><%= line.quantity %></span>
              </td>
              <td>
                <% if (!line.patternSelections || line.patternSelections.length === 0) { %>
                  <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill">بدون أنماط اختيارية</span>
                <% } else { %>
                  <div class="d-flex flex-wrap gap-1">
                    <% line.patternSelections.forEach(function(sel) { %>
                      <span class="pattern-chip">
                        <span class="text-muted"><%= sel.patternName %>:</span>
                        <strong><%= sel.selectedOptionName %></strong>
                      </span>
                    <% }); %>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
