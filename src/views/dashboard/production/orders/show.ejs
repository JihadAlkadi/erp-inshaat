<link rel="stylesheet" href="/css/production-orders.css">

<!-- Initial Order JSON Payload (safely escaped) -->
<script type="application/json" id="initialOrderData">
  <%- initialOrderJson %>
</script>

<!-- Top Breadcrumbs & Nav Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
  <div class="d-flex align-items-center gap-2">
    <a href="/production/orders" class="btn btn-outline-secondary btn-sm" style="border-radius: 8px;">
      <i class="fa-solid fa-arrow-right"></i>
      <span class="ms-1">قائمة الأوامر</span>
    </a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark font-monospace" id="headerOrderNumber"><%= order.orderNumber %></span>
    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1" style="font-size: 0.75rem;">مسودة DRAFT</span>
  </div>

  <div class="d-flex align-items-center gap-2">
    <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder && order.status === 'DRAFT') { %>
      <a href="/production/orders/<%= order.id %>/edit" id="editOrderNavBtn" class="btn production-theme-btn btn-sm d-inline-flex align-items-center gap-1" style="border-radius: 8px;">
        <i class="fa-solid fa-pen-to-square"></i>
        <span>تعديل / إعداد الطلب</span>
      </a>
    <% } %>
  </div>
</div>

<!-- Details Header Card -->
<div class="card order-workspace-header border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-4">
    <div class="row g-3 align-items-center">
      <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
          <h4 class="fw-bold mb-0 text-dark font-monospace"><%= order.orderNumber %></h4>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
            <i class="fa-solid fa-clock me-1"></i> قيد الإعداد (مسودة)
          </span>
          <% if (typeof readiness !== 'undefined' && readiness) { %>
            <% if (readiness.ready) { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                <i class="fa-solid fa-circle-check me-1"></i> جاهز للإطلاق
              </span>
            <% } else { %>
              <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                <i class="fa-solid fa-triangle-exclamation me-1"></i> بانتظار استكمال الجاهزية (<%= readiness.issues.length %>)
              </span>
            <% } %>
          <% } %>
        </div>

        <p class="text-secondary mb-2" id="orderDescriptionText">
          <%= order.description || 'لا يوجد وصف محدد لهذا الطلب.' %>
        </p>

        <% if (order.notes) { %>
          <div class="p-2 rounded bg-light border text-muted small mb-2" id="orderNotesBox">
            <i class="fa-solid fa-note-sticky me-1 text-secondary"></i> <strong>ملاحظات:</strong> <%= order.notes %>
          </div>
        <% } %>

        <div class="d-flex align-items-center gap-3 text-muted small flex-wrap">
          <span><i class="fa-solid fa-user me-1"></i> منشئ الطلب: <strong><%= order.createdByUser ? order.createdByUser.fullName : 'غير محدد' %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-calendar me-1"></i> تاريخ الإنشاء: <span id="orderCreatedAt"><%= new Date(order.createdAt).toLocaleDateString('ar-EG') %></span></span>
        </div>
      </div>

      <!-- Quick Metrics -->
      <div class="col-12 col-lg-4">
        <div class="row g-2 text-center">
          <div class="col-6">
            <div class="p-3 rounded bg-light border">
              <div class="text-muted small fw-semibold">عدد البنود</div>
              <div class="fs-4 fw-bold text-dark" id="headerLineCount"><%= order.summary.lineCount %></div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 rounded bg-light border">
              <div class="text-muted small fw-semibold">إجمالي الكمية</div>
              <div class="fs-4 fw-bold text-primary" id="headerTotalQuantity"><%= order.summary.totalQuantity %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Readiness Issues Breakdown (Read-Only) -->
<% if (typeof readiness !== 'undefined' && readiness && !readiness.ready && readiness.issues.length > 0) { %>
  <div class="card border-warning mb-4" style="border-radius: 12px; background-color: #FFFDF5;">
    <div class="card-body p-3">
      <div class="fw-bold text-warning-emphasis d-flex align-items-center gap-2 mb-2">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>ملاحظات الجاهزية للإطلاق المستقبلي:</span>
      </div>
      <ul class="readiness-issues-list mb-2 pe-3">
        <% readiness.issues.forEach(function(issue) { %>
          <li class="small text-danger mb-1"><%= issue.message %></li>
        <% }); %>
      </ul>
      <div class="small text-muted d-flex align-items-center gap-2">
        <i class="fa-solid fa-info-circle text-primary"></i>
        <span>ملاحظة: يمكنك استكمال إعداد البنود أو المزامنة من صفحة "تعديل / إعداد الطلب".</span>
      </div>
    </div>
  </div>
<% } %>

<!-- Lines Section Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h5 class="fw-bold mb-0 text-dark">
      <i class="fa-solid fa-list-check me-2 text-primary"></i> بنود أمر الإنتاج (عرض فقط)
    </h5>
    <div class="text-muted small">تفاصيل القوالب والكميات والخيارات المحددة لكل بند</div>
  </div>
</div>

<!-- Lines List (Read-Only) -->
<% if (!order.lines || order.lines.length === 0) { %>
  <div class="card border-0 shadow-sm text-center py-5" style="border-radius: 12px;">
    <div class="card-body py-4">
      <div class="mb-3 text-muted" style="font-size: 3rem;">
        <i class="fa-solid fa-cubes-stacked"></i>
      </div>
      <h5 class="fw-bold text-dark mb-1">لا توجد بنود إنتاج في هذا الطلب بعد</h5>
      <p class="text-muted small mb-3">لم تتم إضافة أي بنود إنتاج إلى هذه المسودة حتى الآن.</p>
      <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder && order.status === 'DRAFT') { %>
        <a href="/production/orders/<%= order.id %>/edit" class="btn production-theme-btn btn-sm">
          <i class="fa-solid fa-pen-to-square me-1"></i> فتح محرر الطلب لإضافة بنود
        </a>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="d-flex flex-column gap-3" id="readOnlyLinesContainer">
    <% order.lines.forEach(function(line, idx) { %>
      <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-3 p-md-4">
          <div class="row g-3 align-items-center">
            <!-- Line Index & Template Info -->
            <div class="col-12 col-md-5">
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 font-monospace">#<%= line.sortOrder %></span>
                <h6 class="fw-bold mb-0 text-dark"><%= line.template ? line.template.name : 'قالب غير معروف' %></h6>
              </div>
              <div class="text-muted small font-monospace">
                كود القالب: <%= line.template ? line.template.code : '—' %>
                <% if (line.template && line.template.referenceNumber) { %>
                  • المرجع: <%= line.template.referenceNumber %>
                <% } %>
              </div>
            </div>

            <!-- Quantity -->
            <div class="col-6 col-md-2 text-md-center">
              <div class="text-muted small">الكمية المخططة</div>
              <div class="fs-5 fw-bold text-primary font-monospace"><%= line.quantity %> <span class="fs-6 text-muted fw-normal">غرفة / وحدة</span></div>
            </div>

            <!-- Pattern Selections -->
            <div class="col-12 col-md-5">
              <div class="text-muted small mb-1">خيارات الأنماط المحددة:</div>
              <% if (!line.patternSelections || line.patternSelections.length === 0) { %>
                <span class="badge bg-light text-muted border">قالب بدون أنماط اختيارية</span>
              <% } else { %>
                <div class="d-flex flex-wrap gap-2">
                  <% line.patternSelections.forEach(function(sel) { %>
                    <div class="p-1 px-2 rounded bg-light border small">
                      <span class="text-muted"><%= sel.patternName %>:</span>
                      <strong class="text-dark"><%= sel.selectedOptionName %></strong>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<script src="/js/production-order-show.js"></script>
