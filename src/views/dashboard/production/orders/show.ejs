<link rel="stylesheet" href="/css/production-orders.css">
<style>
  .show-order-header {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.5rem;
  }
  .info-badge-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: #475569;
  }
</style>

<!-- Page Header Card -->
<div class="show-order-header mb-4 shadow-sm">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <h3 class="fw-bold mb-0 text-dark">
          أمر الإنتاج <span class="font-monospace text-primary" style="font-weight: 700;"><%= order.orderNumber %></span>
        </h3>
        <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-1 rounded-pill">
          <i class="fa-solid fa-file-pen me-1"></i> مسودة
        </span>
        <% if (typeof readiness !== 'undefined' && readiness) { %>
          <% if (readiness.ready) { %>
            <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">
              <i class="fa-solid fa-circle-check me-1"></i> جاهز للإطلاق
            </span>
          <% } else { %>
            <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill">
              <i class="fa-solid fa-triangle-exclamation me-1"></i> يحتاج مراجعة
            </span>
          <% } %>
        <% } %>
      </div>
      <p class="text-muted mb-0 small">عرض تفاصيل أمر الإنتاج والقوالب المعتمدة والخيارات المحددة (عرض للقراءة فقط)</p>
    </div>

    <div class="d-flex align-items-center gap-2">
      <a href="/production/orders" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2" style="border-radius: 8px;">
        <i class="fa-solid fa-arrow-right"></i>
        <span>قائمة الأوامر</span>
      </a>
      <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder && order.status === 'DRAFT') { %>
        <a href="/production/orders/<%= order.id %>/edit" id="editOrderNavBtn" class="btn production-theme-btn d-inline-flex align-items-center gap-2 px-4 py-2 shadow-sm" style="border-radius: 8px;">
          <i class="fa-solid fa-pen-to-square"></i>
          <span>تعديل الطلب</span>
        </a>
      <% } %>
    </div>
  </div>
</div>

<!-- Statistics & KPIs Row -->
<div class="row g-3 mb-4">
  <!-- KPI 1: Production Lines -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-right: 5px solid #0984E3 !important;">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 fw-bold small">إجمالي بنود الإنتاج</p>
            <h3 class="mb-0 fw-bold font-monospace" style="color: #0984E3;">
              <%= order.summary.lineCount %> <span class="fs-6 text-muted fw-normal">بند</span>
            </h3>
          </div>
          <div class="rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="width: 50px; height: 50px; background-color: rgba(9, 132, 227, 0.1);">
            <i class="fa-solid fa-cubes fs-4" style="color: #0984E3;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI 2: Total Planned Quantity -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-right: 5px solid #10AC84 !important;">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 fw-bold small">إجمالي الكمية المخططة</p>
            <h3 class="mb-0 fw-bold font-monospace" style="color: #10AC84;">
              <%= order.summary.totalQuantity %> <span class="fs-6 text-muted fw-normal">وحدة</span>
            </h3>
          </div>
          <div class="rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="width: 50px; height: 50px; background-color: rgba(16, 172, 132, 0.1);">
            <i class="fa-solid fa-hashtag fs-4" style="color: #10AC84;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI 3: Launch Readiness -->
  <div class="col-12 col-sm-6 col-xl-3">
    <% var isReady = (typeof readiness !== 'undefined' && readiness && readiness.ready); %>
    <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-right: 5px solid <%= isReady ? '#10AC84' : '#FF9F43' %> !important;">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 fw-bold small">جاهزية الإطلاق</p>
            <h4 class="mb-0 fw-bold" style="color: <%= isReady ? '#10AC84' : '#FF9F43' %>;">
              <%= isReady ? 'جاهز للإطلاق' : 'يحتاج مراجعة' %>
            </h4>
          </div>
          <div class="rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="width: 50px; height: 50px; background-color: <%= isReady ? 'rgba(16, 172, 132, 0.1)' : 'rgba(255, 159, 67, 0.1)' %>;">
            <i class="fa-solid <%= isReady ? 'fa-circle-check' : 'fa-triangle-exclamation' %> fs-4" style="color: <%= isReady ? '#10AC84' : '#FF9F43' %>;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI 4: Order Status -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-right: 5px solid #6C5CE7 !important;">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 fw-bold small">حالة أمر الإنتاج</p>
            <h4 class="mb-0 fw-bold" style="color: #6C5CE7;">
              <%= order.status === 'DRAFT' ? 'مسودة نشطة' : order.status %>
            </h4>
          </div>
          <div class="rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="width: 50px; height: 50px; background-color: rgba(108, 92, 231, 0.1);">
            <i class="fa-solid fa-file-signature fs-4" style="color: #6C5CE7;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Order Details Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; border: 1px solid #e2e8f0;">
  <div class="card-body p-4">
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
      <div class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-circle-info text-primary fs-5"></i>
        <h6 class="fw-bold mb-0 text-dark">بيانات وتفاصيل أمر الإنتاج</h6>
      </div>
      <span class="badge bg-light text-secondary border font-monospace px-3 py-1 rounded-pill">
        #<%= order.orderNumber %>
      </span>
    </div>

    <p class="text-dark mb-3 fs-6" style="line-height: 1.7;">
      <%= order.description || 'لا يوجد وصف محدد لهذا الطلب.' %>
    </p>

    <% if (order.notes) { %>
      <div class="p-3 rounded-3 bg-light border border-light-subtle text-muted small mb-3">
        <strong class="text-dark d-block mb-1">
          <i class="fa-solid fa-note-sticky text-warning me-1"></i> ملاحظات إضافية:
        </strong>
        <%= order.notes %>
      </div>
    <% } %>

    <div class="d-flex align-items-center gap-4 text-muted small pt-2 flex-wrap">
      <div class="info-badge-item">
        <i class="fa-solid fa-user-circle text-secondary"></i>
        <span>المنشئ:</span>
        <strong class="text-dark"><%= order.createdByUser ? order.createdByUser.fullName : 'غير محدد' %></strong>
      </div>
      <div class="info-badge-item">
        <i class="fa-solid fa-calendar-day text-secondary"></i>
        <span>تاريخ الإنشاء:</span>
        <span class="text-dark"><%= new Date(order.createdAt).toLocaleDateString('ar-EG') %></span>
      </div>
      <div class="info-badge-item">
        <i class="fa-solid fa-clock text-secondary"></i>
        <span>آخر تحديث:</span>
        <span class="text-dark"><%= new Date(order.updatedAt || order.createdAt).toLocaleDateString('ar-EG') %></span>
      </div>
    </div>
  </div>
</div>

<!-- Readiness Issues (if any) -->
<% if (typeof readiness !== 'undefined' && readiness && !readiness.ready && readiness.issues && readiness.issues.length > 0) { %>
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; border-right: 5px solid #FF9F43 !important; background-color: #FFFDF8; border: 1px solid #fed7aa;">
    <div class="card-body p-4">
      <div class="fw-bold text-warning-emphasis d-flex align-items-center gap-2 mb-2">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>تنبيهات حالة الجاهزية:</span>
      </div>
      <p class="text-muted small mb-2">هناك بيانات ومحددات تحتاج المراجعة قبل اعتماد الطلب للإنتاج:</p>
      <ul class="mb-0 pe-3">
        <% readiness.issues.forEach(function(issue) { %>
          <li class="small text-danger mb-1"><%= issue.message %></li>
        <% }); %>
      </ul>
    </div>
  </div>
<% } %>

<!-- Lines Section Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
      <i class="fa-solid fa-list-check text-primary"></i>
      <span>بنود أمر الإنتاج</span>
    </h5>
    <div class="text-muted small">تفاصيل القوالب والكميات والخيارات المحددة لكل بند في الطلب</div>
  </div>
  <span class="badge bg-secondary-subtle text-secondary-emphasis px-3 py-2 rounded-pill font-monospace">
    <%= (order.lines ? order.lines.length : 0) %> بند
  </span>
</div>

<!-- Production Lines Table -->
<% if (!order.lines || order.lines.length === 0) { %>
  <div class="card border-0 shadow-sm text-center py-5" style="border-radius: 14px; border: 1px solid #e2e8f0;">
    <div class="card-body py-4">
      <div class="mb-3 text-secondary opacity-50" style="font-size: 3rem;">
        <i class="fa-solid fa-cubes-stacked"></i>
      </div>
      <h5 class="fw-bold text-dark mb-1">لا توجد بنود إنتاج في هذا الطلب بعد</h5>
      <p class="text-muted small mb-3">لم تتم إضافة أي بنود إنتاج إلى هذه المسودة حتى الآن.</p>
      <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder && order.status === 'DRAFT') { %>
        <a href="/production/orders/<%= order.id %>/edit" class="btn production-theme-btn btn-sm px-4 py-2">
          <i class="fa-solid fa-pen-to-square me-1"></i> إعداد وإضافة البنود
        </a>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="card border-0 shadow-sm show-lines-card mb-4">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr class="text-muted small">
            <th class="py-3 px-3 text-center" style="width: 70px;">#</th>
            <th class="py-3 px-3">القالب</th>
            <th class="py-3 px-3" style="width: 140px;">الكود</th>
            <th class="py-3 px-3 text-center" style="width: 120px;">الكمية</th>
            <th class="py-3 px-3">الأنماط وخيارات التخصيص</th>
          </tr>
        </thead>
        <tbody>
          <% order.lines.forEach(function(line) { %>
            <tr>
              <td class="text-center font-monospace text-muted fw-bold">#<%= line.sortOrder %></td>
              <td>
                <div class="fw-bold text-dark"><%= line.template ? line.template.name : 'قالب غير معروف' %></div>
                <% if (line.template && line.template.referenceNumber) { %>
                  <div class="text-muted small font-monospace">المرجع: <%= line.template.referenceNumber %></div>
                <% } %>
              </td>
              <td>
                <span class="badge bg-light text-secondary font-monospace border"><%= line.template ? line.template.code : '—' %></span>
              </td>
              <td class="text-center">
                <span class="fw-bold text-primary font-monospace fs-6"><%= line.quantity %></span>
              </td>
              <td>
                <% if (!line.patternSelections || line.patternSelections.length === 0) { %>
                  <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill">بدون أنماط اختيارية</span>
                <% } else { %>
                  <div class="d-flex flex-wrap gap-1">
                    <% line.patternSelections.forEach(function(sel) { %>
                      <span class="pattern-chip">
                        <span class="text-muted"><%= sel.patternName %>:</span>
                        <strong class="text-dark"><%= sel.selectedOptionName %></strong>
                      </span>
                    <% }); %>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" class="py-3 px-3 fw-bold text-dark">الإجمالي الكلي</td>
            <td class="py-3 px-3 text-center font-monospace fw-bold text-primary fs-6"><%= order.summary.totalQuantity %></td>
            <td class="py-3 px-3 text-muted small"><%= order.summary.lineCount %> بنود مسجلة</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
<% } %>
