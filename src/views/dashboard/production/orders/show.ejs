<link rel="stylesheet" href="/css/production-orders.css">

<!-- Initial Order JSON Payload (safely escaped) -->
<script type="application/json" id="initialOrderData">
  <%- initialOrderJson %>
</script>

<!-- Top Breadcrumbs & Back Nav -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
  <div class="d-flex align-items-center gap-2">
    <a href="/production/orders" class="btn btn-outline-secondary btn-sm" style="border-radius: 8px;">
      <i class="fa-solid fa-arrow-right"></i>
      <span class="ms-1">قائمة الأوامر</span>
    </a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark font-monospace" id="headerOrderNumber"><%= order.orderNumber %></span>
    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1" style="font-size: 0.75rem;">مسودة DRAFT</span>
  </div>

  <div class="d-flex align-items-center gap-2">
    <% if (typeof canDeleteOrder !== 'undefined' && canDeleteOrder) { %>
      <button type="button" id="archiveOrderBtn" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1">
        <i class="fa-solid fa-trash-can"></i>
        <span>أرشفة الطلب</span>
      </button>
    <% } %>
  </div>
</div>

<!-- Alert Container -->
<div id="orderAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

<!-- Workspace Header Card -->
<div class="card order-workspace-header border-0 shadow-sm mb-4">
  <div class="card-body p-4">
    <div class="row g-3 align-items-center">
      <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
          <h4 class="fw-bold mb-0 text-dark font-monospace"><%= order.orderNumber %></h4>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
            <i class="fa-solid fa-clock me-1"></i> قيد الإعداد (مسودة)
          </span>
          <div id="readinessStatusBadge">
            <!-- Rendered by JS -->
          </div>
        </div>

        <p class="text-secondary mb-2" id="orderDescriptionText">
          <%= order.description || 'لا يوجد وصف محدد لهذا الطلب.' %>
        </p>

        <% if (order.notes) { %>
          <div class="p-2 rounded bg-light border text-muted small mb-2" id="orderNotesBox">
            <i class="fa-solid fa-note-sticky me-1 text-secondary"></i> <strong>ملاحظات:</strong> <%= order.notes %>
          </div>
        <% } %>

        <div class="d-flex align-items-center gap-3 text-muted small flex-wrap">
          <span><i class="fa-solid fa-user me-1"></i> منشئ الطلب: <strong><%= order.createdByUser ? order.createdByUser.fullName : 'غير محدد' %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-calendar me-1"></i> تاريخ الإنشاء: <span id="orderCreatedAt"><%= new Date(order.createdAt).toLocaleDateString('ar-EG') %></span></span>
          <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder) { %>
            <span>•</span>
            <button type="button" id="editHeaderBtn" class="btn btn-link btn-sm p-0 text-decoration-none text-primary">
              <i class="fa-solid fa-pen-to-square me-1"></i> تعديل الوصف والملاحظات
            </button>
          <% } %>
        </div>
      </div>

      <!-- Quick Metrics -->
      <div class="col-12 col-lg-4">
        <div class="row g-2 text-center">
          <div class="col-6">
            <div class="p-3 rounded bg-light border">
              <div class="text-muted small fw-semibold">عدد البنود</div>
              <div class="fs-4 fw-bold text-dark" id="headerLineCount"><%= order.summary.lineCount %></div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 rounded bg-light border">
              <div class="text-muted small fw-semibold">إجمالي الكمية</div>
              <div class="fs-4 fw-bold text-primary" id="headerTotalQuantity"><%= order.summary.totalQuantity %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Readiness Breakdown Panel (conditionally shown if not ready) -->
<div id="readinessPanel" class="card border-warning mb-4 d-none" style="border-radius: 12px; background-color: #FFFDF5;">
  <div class="card-body p-3">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div class="fw-bold text-warning-emphasis d-flex align-items-center gap-2">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>حالة الجاهزية للإطلاق (قيد المراجعة)</span>
      </div>
      <button type="button" id="recheckReadinessBtn" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;">
        <i class="fa-solid fa-arrows-rotate me-1"></i> إعادة الفحص
      </button>
    </div>
    <ul class="readiness-issues-list mb-2" id="readinessIssuesList">
      <!-- Issues populated dynamically -->
    </ul>
    <div class="small text-muted d-flex align-items-center gap-2">
      <i class="fa-solid fa-info-circle text-primary"></i>
      <span>ملاحظة معمارية: زر الإطلاق الفعلي للإنتاج مع إنشاء لقطات العمليات ووحدات الإنتاج (Release & Snapshots) سيتم تنفيذه في المرحلة التالية.</span>
    </div>
  </div>
</div>

<!-- Lines Section Header & Action Bar -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
  <div>
    <h5 class="fw-bold mb-0 text-dark">
      <i class="fa-solid fa-list-check me-2 text-primary"></i> بنود أمر الإنتاج
    </h5>
    <div class="text-muted small">كل بند يمثل قالباً مع كمية محددة وخيارات منتقاة لجميع الأنماط التابعة له</div>
  </div>

  <div class="d-flex align-items-center gap-2">
    <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder) { %>
      <button type="button" id="openAddLineModalBtn" class="btn production-theme-btn btn-sm d-inline-flex align-items-center gap-1">
        <i class="fa-solid fa-plus"></i>
        <span>إضافة بند إنتاج</span>
      </button>
    <% } %>
  </div>
</div>

<!-- Lines Container -->
<div id="orderLinesContainer">
  <!-- Lines rendered dynamically by JS -->
</div>

<!-- Empty Lines State -->
<div id="emptyLinesState" class="card border-0 shadow-sm text-center py-5 d-none" style="border-radius: 12px;">
  <div class="card-body py-4">
    <div class="mb-3 text-muted" style="font-size: 3rem;">
      <i class="fa-solid fa-cubes-stacked"></i>
    </div>
    <h5 class="fw-bold text-dark mb-1">لا توجد بنود إنتاج في هذا الطلب بعد</h5>
    <p class="text-muted small mb-3">ابدأ بإضافة أول بند إنتاج وحدد القالب والكمية والخيارات المطلوبة.</p>
    <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder) { %>
      <button type="button" id="emptyStateAddLineBtn" class="btn production-theme-btn btn-sm">
        <i class="fa-solid fa-plus me-1"></i> إضافة أول بند
      </button>
    <% } %>
  </div>
</div>

<!-- Add Line Modal -->
<div class="modal fade" id="addLineModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom py-3">
        <h6 class="modal-title fw-bold text-dark">
          <i class="fa-solid fa-plus-circle me-2 text-primary"></i> إضافة بند إنتاج جديد للطلب
        </h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div id="addLineAlert" class="alert alert-danger d-none mb-3" role="alert"></div>

        <form id="addLineForm" novalidate>
          <!-- Step 1: Select Template -->
          <div class="mb-3">
            <label class="form-label fw-bold text-dark">
              1. اختيار قالب التصنيع <span class="text-danger">*</span>
            </label>
            <div class="input-group mb-2">
              <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-search"></i></span>
              <input type="text" id="templatePickerSearch" class="form-control border-start-0 bg-light" placeholder="ابحث عن اسم القالب أو الكود...">
            </div>

            <!-- Templates List Container -->
            <div class="border rounded p-2 bg-light" style="max-height: 180px; overflow-y: auto;" id="templatePickerList">
              <div class="text-center py-3 text-muted small">
                <div class="spinner-border spinner-border-sm me-1 text-primary"></div> جاري تحميل القوالب...
              </div>
            </div>
            <input type="hidden" id="selectedTemplateId" name="templateId" required>
            <div id="selectedTemplateSummary" class="form-text text-primary fw-semibold mt-1 d-none"></div>
          </div>

          <!-- Step 2: Quantity -->
          <div class="mb-3">
            <label for="lineQuantityInput" class="form-label fw-bold text-dark">
              2. الكمية المخططة (عدد الغرف / الوحدات) <span class="text-danger">*</span>
            </label>
            <div class="input-group" style="max-width: 250px;">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-hashtag"></i></span>
              <input type="number" class="form-control" id="lineQuantityInput" name="quantity" min="1" max="10000" step="1" value="1" required>
            </div>
            <div class="form-text text-muted">عدد صحيح موجب بين 1 و 10,000.</div>
          </div>

          <!-- Step 3: Pattern Selections Preview -->
          <div class="mb-3 d-none" id="patternsPreviewSection">
            <label class="form-label fw-bold text-dark d-flex justify-content-between align-items-center">
              <span>3. خيارات الأنماط (الافتراضية المحددة)</span>
              <span class="badge bg-light text-muted border fw-normal" style="font-size: 0.75rem;">يمكن تعديلها لاحقاً</span>
            </label>
            <div id="patternsPreviewContainer" class="p-3 border rounded bg-light">
              <!-- Patterns with dropdowns populated dynamically -->
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" id="confirmAddLineBtn" class="btn production-theme-btn btn-sm d-inline-flex align-items-center gap-1" disabled>
              <i class="fa-solid fa-check"></i>
              <span>إضافة البند للطلب</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Edit Line Quantity Modal -->
<div class="modal fade" id="editQuantityModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom py-3">
        <h6 class="modal-title fw-bold text-dark">تعديل كمية البند</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-3">
        <div id="editQuantityAlert" class="alert alert-danger d-none mb-2" role="alert"></div>
        <form id="editQuantityForm">
          <input type="hidden" id="editQuantityLineId">
          <label class="form-label fw-bold text-dark small">الكمية الجديدة (1..10000):</label>
          <input type="number" id="editQuantityInput" class="form-control mb-3" min="1" max="10000" step="1" required>
          <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" id="confirmEditQuantityBtn" class="btn production-theme-btn btn-sm">حفظ</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Edit Header Modal -->
<div class="modal fade" id="editHeaderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom py-3">
        <h6 class="modal-title fw-bold text-dark">تعديل بيانات طلب الإنتاج</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div id="editHeaderAlert" class="alert alert-danger d-none mb-3" role="alert"></div>
        <form id="editHeaderForm">
          <div class="mb-3">
            <label for="editDescriptionInput" class="form-label fw-bold text-dark">الوصف:</label>
            <input type="text" id="editDescriptionInput" class="form-control" maxlength="500">
          </div>
          <div class="mb-3">
            <label for="editNotesInput" class="form-label fw-bold text-dark">الملاحظات:</label>
            <textarea id="editNotesInput" class="form-control" rows="3" maxlength="2000"></textarea>
          </div>
          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" id="confirmEditHeaderBtn" class="btn production-theme-btn btn-sm">حفظ التعديلات</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/production-order-detail.js"></script>
