<link rel="stylesheet" href="/css/production-orders.css">

<!-- Initial Order JSON Payload (safely escaped) -->
<script type="application/json" id="initialOrderData">
  <%- initialOrderJson %>
</script>

<!-- Top Breadcrumbs & Nav Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
  <div class="d-flex align-items-center gap-2">
    <a href="/production/orders" class="btn btn-outline-secondary btn-sm" style="border-radius: 8px;">
      <i class="fa-solid fa-arrow-right"></i>
      <span class="ms-1">قائمة الأوامر</span>
    </a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark font-monospace" id="headerOrderNumber"><%= order.orderNumber %></span>
    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size: 0.75rem;">محرر المسودة DRAFT EDITOR</span>
  </div>

  <div class="d-flex align-items-center gap-2">
    <a href="/production/orders/<%= order.id %>" id="viewOrderNavBtn" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" style="border-radius: 8px;">
      <i class="fa-solid fa-eye"></i>
      <span>عرض الطلب</span>
    </a>
    <% if (typeof canDeleteOrder !== 'undefined' && canDeleteOrder) { %>
      <button type="button" id="archiveOrderBtn" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1" style="border-radius: 8px;">
        <i class="fa-solid fa-trash-can"></i>
        <span>أرشفة الطلب</span>
      </button>
    <% } %>
  </div>
</div>

<!-- Alert Container -->
<div id="orderAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

<!-- Workspace Header Card -->
<div class="card order-workspace-header border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-4">
    <div class="row g-3 align-items-center">
      <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
          <h4 class="fw-bold mb-0 text-dark font-monospace"><%= order.orderNumber %></h4>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
            <i class="fa-solid fa-clock me-1"></i> قيد الإعداد (مسودة)
          </span>
          <div id="readinessStatusBadge">
            <!-- Rendered by JS -->
          </div>
        </div>

        <p class="text-secondary mb-2" id="orderDescriptionText">
          <%= order.description || 'لا يوجد وصف محدد لهذا الطلب.' %>
        </p>

        <% if (order.notes) { %>
          <div class="p-2 rounded bg-light border text-muted small mb-2" id="orderNotesBox">
            <i class="fa-solid fa-note-sticky me-1 text-secondary"></i> <strong>ملاحظات:</strong> <%= order.notes %>
          </div>
        <% } %>

        <div class="d-flex align-items-center gap-3 text-muted small flex-wrap">
          <span><i class="fa-solid fa-user me-1"></i> منشئ الطلب: <strong><%= order.createdByUser ? order.createdByUser.fullName : 'غير محدد' %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-calendar me-1"></i> تاريخ الإنشاء: <span id="orderCreatedAt"><%= new Date(order.createdAt).toLocaleDateString('ar-EG') %></span></span>
          <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder) { %>
            <span>•</span>
            <button type="button" id="editHeaderBtn" class="btn btn-link btn-sm p-0 text-decoration-none text-primary">
              <i class="fa-solid fa-pen-to-square me-1"></i> تعديل الوصف والملاحظات
            </button>
          <% } %>
        </div>
      </div>

      <!-- Quick Metrics -->
      <div class="col-12 col-lg-4">
        <div class="row g-2 text-center">
          <div class="col-6">
            <div class="p-3 rounded bg-light border">
              <div class="text-muted small fw-semibold">عدد البنود</div>
              <div class="fs-4 fw-bold text-dark" id="headerLineCount"><%= order.summary.lineCount %></div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 rounded bg-light border">
              <div class="text-muted small fw-semibold">إجمالي الكمية</div>
              <div class="fs-4 fw-bold text-primary" id="headerTotalQuantity"><%= order.summary.totalQuantity %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Readiness Breakdown Panel (dynamically populated) -->
<div id="readinessPanel" class="card border-warning mb-4 d-none" style="border-radius: 12px; background-color: #FFFDF5;">
  <div class="card-body p-3">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div class="fw-bold text-warning-emphasis d-flex align-items-center gap-2">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>حالة الجاهزية للإطلاق المستقبلي</span>
      </div>
      <button type="button" id="recheckReadinessBtn" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;">
        <i class="fa-solid fa-arrows-rotate me-1"></i> إعادة الفحص
      </button>
    </div>
    <ul class="readiness-issues-list mb-2 pe-3" id="readinessIssuesList">
      <!-- Issues populated dynamically -->
    </ul>
  </div>
</div>

<!-- Add Line Composer Card -->
<div class="card border-0 shadow-sm mb-4" id="addLineComposerCard" style="border-radius: 12px;">
  <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
    <h5 class="fw-bold mb-0 text-dark">
      <i class="fa-solid fa-plus-circle me-2 text-primary"></i> إضافة بند إنتاج جديد
    </h5>
    <span class="badge bg-light text-muted border fw-normal">إدخال مباشر شامل</span>
  </div>
  <div class="card-body p-4">
    <div id="composerAlert" class="alert alert-danger d-none mb-3" role="alert"></div>

    <div class="row g-4">
      <!-- Left Column: Search & Select Template -->
      <div class="col-12 col-lg-5 border-end-lg">
        <label class="form-label fw-bold text-dark mb-2">
          1. البحث عن قالب التصنيع <span class="text-danger">*</span>
        </label>
        <div class="input-group mb-2">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-search"></i></span>
          <input type="text" id="templateSearchInput" class="form-control border-start-0 bg-light" placeholder="ابحث بالاسم أو الكود أو المرجع..." autocomplete="off">
        </div>

        <!-- Template Results List -->
        <div class="border rounded p-2 bg-light mb-2" style="max-height: 240px; overflow-y: auto;" id="templateListContainer">
          <div class="text-center py-3 text-muted small">
            <div class="spinner-border spinner-border-sm me-1 text-primary"></div> جاري تحميل القوالب...
          </div>
        </div>

        <!-- Load More Button -->
        <button type="button" id="templateLoadMoreBtn" class="btn btn-sm btn-outline-secondary w-100 d-none">
          <i class="fa-solid fa-arrow-down me-1"></i> تحميل المزيد من القوالب
        </button>

        <!-- Selected Template Summary Box -->
        <div id="selectedTemplateBox" class="p-3 rounded bg-primary-subtle border border-primary-subtle mt-3 d-none">
          <div class="d-flex align-items-start justify-content-between">
            <div>
              <div class="small text-muted fw-semibold">القالب المختار:</div>
              <h6 class="fw-bold text-dark mb-1" id="selectedTemplateName">—</h6>
              <div class="small text-secondary font-monospace" id="selectedTemplateMeta">—</div>
            </div>
            <button type="button" id="resetSelectedTemplateBtn" class="btn btn-link btn-sm text-danger p-0 text-decoration-none">
              <i class="fa-solid fa-xmark"></i> تغيير
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Quantity & Pattern Selections -->
      <div class="col-12 col-lg-7">
        <!-- Quantity Input -->
        <div class="mb-4">
          <label for="composerQuantityInput" class="form-label fw-bold text-dark mb-1">
            2. الكمية المخططة (عدد الغرف / الوحدات) <span class="text-danger">*</span>
          </label>
          <div class="input-group" style="max-width: 260px;">
            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-hashtag"></i></span>
            <input type="number" class="form-control font-monospace fs-5" id="composerQuantityInput" min="1" max="10000" step="1" value="1" required>
          </div>
          <div class="form-text text-muted">عدد صحيح موجب بين 1 و 10,000 (الكمية لا تمثل جزءاً من هوية البند).</div>
        </div>

        <!-- Patterns Configuration -->
        <div class="mb-4">
          <label class="form-label fw-bold text-dark d-flex align-items-center justify-content-between mb-2">
            <span>3. خيارات الأنماط لقالب البند</span>
            <span class="badge bg-light text-muted border fw-normal" style="font-size: 0.75rem;">خيار واحد لكل نمط فعال</span>
          </label>

          <div id="composerPatternsContainer" class="p-3 border rounded bg-light">
            <div class="text-center py-3 text-muted small" id="composerPatternsPlaceholder">
              يرجى اختيار قالب تصنيع أولاً لعرض خيارات الأنماط التابعة له.
            </div>
          </div>
        </div>

        <!-- Pre-check Warning Notice -->
        <div id="composerDuplicateNotice" class="alert alert-warning d-none py-2 px-3 small" role="alert">
          <i class="fa-solid fa-triangle-exclamation me-1"></i>
          <span id="composerDuplicateNoticeText"></span>
        </div>

        <!-- Add Button -->
        <div class="d-flex justify-content-end">
          <button type="button" id="composerAddLineBtn" class="btn production-theme-btn px-4 py-2 d-inline-flex align-items-center gap-2" disabled>
            <i class="fa-solid fa-plus"></i>
            <span class="fw-bold">إضافة البند للطلب</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Lines Section Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h5 class="fw-bold mb-0 text-dark">
      <i class="fa-solid fa-cubes me-2 text-primary"></i> البنود الحالية في الطلب
    </h5>
    <div class="text-muted small">يمكنك تعديل الكميات، تغيير الخيارات، إعادة الترتيب، أو مزامنة البنود مع تحديثات القوالب</div>
  </div>
</div>

<!-- Lines Container (Editable Cards) -->
<div id="orderLinesContainer" class="d-flex flex-column gap-3 mb-4">
  <!-- Rendered dynamically by production-order-edit.js -->
</div>

<!-- Empty Lines State -->
<div id="emptyLinesState" class="card border-0 shadow-sm text-center py-5 d-none" style="border-radius: 12px;">
  <div class="card-body py-4">
    <div class="mb-3 text-muted" style="font-size: 3rem;">
      <i class="fa-solid fa-cubes-stacked"></i>
    </div>
    <h5 class="fw-bold text-dark mb-1">لا توجد بنود إنتاج في هذا الطلب بعد</h5>
    <p class="text-muted small mb-0">استخدم قسم الإضافة أعلاه لتحديد القالب والكمية والخيارات وإضافة أول بند.</p>
  </div>
</div>

<!-- Edit Header Modal -->
<div class="modal fade" id="editHeaderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom py-3">
        <h6 class="modal-title fw-bold text-dark">تعديل بيانات طلب الإنتاج</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div id="editHeaderAlert" class="alert alert-danger d-none mb-3" role="alert"></div>
        <form id="editHeaderForm">
          <div class="mb-3">
            <label for="editDescriptionInput" class="form-label fw-bold text-dark">الوصف:</label>
            <input type="text" id="editDescriptionInput" class="form-control" maxlength="500">
          </div>
          <div class="mb-3">
            <label for="editNotesInput" class="form-label fw-bold text-dark">الملاحظات:</label>
            <textarea id="editNotesInput" class="form-control" rows="3" maxlength="2000"></textarea>
          </div>
          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" id="confirmEditHeaderBtn" class="btn production-theme-btn btn-sm">حفظ التعديلات</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Archive Order Modal -->
<div class="modal fade" id="archiveOrderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom py-3">
        <h6 class="modal-title fw-bold text-danger">تأكيد الأرشفة</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-3 text-center">
        <p class="small text-muted mb-0">هل أنت متأكد من أرشفة هذا الطلب بالكامل؟</p>
      </div>
      <div class="modal-footer border-top py-2 bg-light">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
        <button type="button" id="confirmArchiveOrderBtn" class="btn btn-danger btn-sm">أرشفة</button>
      </div>
    </div>
  </div>
</div>

<script src="/js/production-order-edit.js"></script>
