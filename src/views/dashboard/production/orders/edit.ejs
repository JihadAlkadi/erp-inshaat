<link rel="stylesheet" href="/css/production-orders.css">

<!-- Initial Order JSON Payload (safely escaped) -->
<script type="application/json" id="initialOrderData">
  <%- initialOrderJson %>
</script>

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
      <h3 class="fw-bold mb-0" style="color: #1F2937;">
        إعداد أمر الإنتاج <span class="font-monospace text-primary" id="headerOrderNumber"><%= order.orderNumber %></span>
      </h3>
      <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-1 rounded-pill">مسودة</span>
      <div id="readinessStatusBadge" class="d-inline-flex"></div>
    </div>
    <p class="text-muted mb-0 small">أضف البنود واضبط الكميات وخيارات الأنماط</p>
  </div>

  <div class="d-flex align-items-center gap-2 flex-wrap">
    <a href="/production/orders/<%= order.id %>" id="viewOrderNavBtn" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
      <i class="fa-solid fa-eye"></i>
      <span>عرض الطلب</span>
    </a>
    <a href="/production/orders" id="backToListNavBtn" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
      <i class="fa-solid fa-arrow-right"></i>
      <span>قائمة الأوامر</span>
    </a>
    <% if (typeof canDeleteOrder !== 'undefined' && canDeleteOrder) { %>
      <button type="button" id="archiveOrderBtn" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1" style="border-radius: 8px;">
        <i class="fa-solid fa-trash-can"></i>
        <span>أرشفة الطلب</span>
      </button>
    <% } %>
  </div>
</div>

<!-- Alert Container -->
<div id="orderAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

<!-- Compact Order Summary Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-3 p-md-4">
    <div class="row g-3 align-items-center">
      <div class="col-12 col-lg-7">
        <div class="text-muted small fw-semibold mb-1">الوصف والملاحظات:</div>
        <p class="text-dark mb-1 small" id="orderDescriptionText">
          <%= order.description || 'لا يوجد وصف محدد لهذا الطلب.' %>
        </p>

        <div class="p-2 rounded bg-light border text-muted small mb-2 <%= order.notes ? '' : 'd-none' %>" id="orderNotesBox">
          <% if (order.notes) { %>
            <i class="fa-solid fa-note-sticky me-1 text-secondary"></i> <strong>ملاحظات:</strong> <%= order.notes %>
          <% } %>
        </div>

        <div class="d-flex align-items-center gap-3 text-muted small flex-wrap pt-1">
          <span><i class="fa-solid fa-user me-1 text-secondary"></i> المنشئ: <strong><%= order.createdByUser ? order.createdByUser.fullName : 'غير محدد' %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-calendar me-1 text-secondary"></i> التاريخ: <span id="orderCreatedAt"><%= new Date(order.createdAt).toLocaleDateString('ar-EG') %></span></span>
          <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder) { %>
            <span>•</span>
            <button type="button" id="editHeaderBtn" class="btn btn-link btn-sm p-0 text-decoration-none text-primary">
              <i class="fa-solid fa-pen-to-square me-1"></i> تعديل الوصف والملاحظات
            </button>
          <% } %>
        </div>
      </div>

      <div class="col-12 col-lg-5">
        <div class="row g-2 text-center">
          <div class="col-6">
            <div class="p-2 rounded bg-light border">
              <div class="text-muted small">عدد البنود</div>
              <div class="fs-5 fw-bold text-dark font-monospace" id="headerLineCount"><%= order.summary.lineCount %></div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 rounded bg-light border">
              <div class="text-muted small">إجمالي الكمية</div>
              <div class="fs-5 fw-bold text-primary font-monospace" id="headerTotalQuantity"><%= order.summary.totalQuantity %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Readiness Breakdown Panel (Dynamically shown when issues exist) -->
<div id="readinessPanel" class="card border-0 shadow-sm mb-4 d-none" style="border-radius: 12px; border-right: 5px solid #FF9F43 !important; background-color: #FFFDF8;">
  <div class="card-body p-3">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div class="fw-bold text-warning-emphasis d-flex align-items-center gap-2">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>حالة الجاهزية</span>
      </div>
      <button type="button" id="recheckReadinessBtn" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;">
        <i class="fa-solid fa-arrows-rotate me-1"></i> تحديث الفحص
      </button>
    </div>
    <ul class="readiness-issues-list mb-0 pe-3" id="readinessIssuesList">
      <!-- Populated dynamically -->
    </ul>
  </div>
</div>

<!-- ========================================================================= -->
<!-- Search-First Composer Card -->
<!-- ========================================================================= -->
<div class="card composer-search-card mb-4" id="addLineComposerCard">
  <div class="card-body p-4">
    <div class="text-center mb-3">
      <h5 class="fw-bold mb-1" style="color: #1F2937;">
        <i class="fa-solid fa-magnifying-glass text-primary me-2"></i> إضافة بنود إنتاج
      </h5>
      <p class="text-muted small mb-0">ابحث باسم القالب أو الكود أو الرقم المرجعي لإعداده وإضافته إلى الطلب</p>
    </div>

    <!-- Search Input Group -->
    <div class="input-group input-group-lg composer-search-input-group mb-0 position-relative">
      <span class="input-group-text bg-white text-muted ps-3">
        <i class="fa-solid fa-search"></i>
      </span>
      <input
        type="text"
        id="templateSearchInput"
        class="form-control ps-1"
        placeholder="ابحث باسم القالب أو الكود أو الرقم المرجعي..."
        autocomplete="off"
      >
      <button type="button" id="clearSearchBtn" class="btn btn-link text-muted pe-3 d-none" title="مسح البحث" aria-label="مسح البحث">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Search Results Container (Directly below search input) -->
    <div id="searchResultsWrapper" class="mt-2 d-none">
      <div id="searchResultsList" class="list-group search-results-list border">
        <!-- Rendered dynamically as <button type="button" class="list-group-item list-group-item-action ..."> -->
      </div>
      <button type="button" id="templateLoadMoreBtn" class="btn btn-sm btn-outline-secondary w-100 mt-2 d-none">
        <i class="fa-solid fa-arrow-down me-1"></i> تحميل المزيد
      </button>
    </div>

    <div id="composerAlert" class="alert alert-danger d-none mt-3 mb-0" role="alert"></div>
  </div>
</div>

<!-- ========================================================================= -->
<!-- Pending Lines Section (Client-Side Staging) -->
<!-- ========================================================================= -->
<div id="pendingLinesSection" class="pending-lines-wrapper mb-5 d-none">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h5 class="fw-bold mb-0 text-dark">
        <i class="fa-solid fa-list-check me-2 text-primary"></i> بنود جاهزة للإضافة (غير محفوظة)
      </h5>
      <div class="text-muted small">حدد الكميات والخيارات لكل بند، ثم اضغط حفظ لإضافتها دفعة واحدة</div>
    </div>
    <span class="badge bg-primary px-3 py-2 rounded-pill" id="pendingLinesCountBadge">0 بند</span>
  </div>

  <!-- Pending Lines Container -->
  <div id="pendingLinesContainer" class="d-flex flex-column gap-3 mb-3">
    <!-- Populated dynamically -->
  </div>

  <!-- Global Batch Submit Button -->
  <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: 12px;">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
      <div class="text-muted small">
        <i class="fa-solid fa-shield-halved text-success me-1"></i>
        <span>تتم إضافة جميع البنود المجهزة في معاملة واحدة مترابطة ذرياً (All-or-Nothing).</span>
      </div>
      <button type="button" id="submitPendingLinesBtn" class="btn production-theme-btn px-4 py-2 d-inline-flex align-items-center gap-2" disabled>
        <span class="spinner-border spinner-border-sm d-none" id="submitPendingSpinner" role="status" aria-hidden="true"></span>
        <i class="fa-solid fa-check" id="submitPendingIcon"></i>
        <span class="fw-bold" id="submitPendingLinesBtnText">إضافة البنود إلى الطلب (0)</span>
      </button>
    </div>
  </div>
</div>

<!-- ========================================================================= -->
<!-- Existing Order Lines Section -->
<!-- ========================================================================= -->
<div class="existing-lines-container">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h5 class="fw-bold mb-0 text-dark">
        <i class="fa-solid fa-cubes me-2 text-primary"></i> البنود الحالية في الطلب
      </h5>
      <div class="text-muted small">يمكنك تعديل الكميات، تغيير الخيارات، إعادة الترتيب، أو مزامنة البنود مع تحديثات القوالب</div>
    </div>
    <span class="badge bg-secondary-subtle text-secondary-emphasis px-3 py-2 rounded-pill" id="existingLinesCountBadge">
      <%= (order.lines ? order.lines.length : 0) %> بند
    </span>
  </div>

  <!-- Existing Lines Container -->
  <div id="orderLinesContainer" class="d-flex flex-column gap-3 mb-4">
    <!-- Rendered dynamically by production-order-edit.js -->
  </div>

  <!-- Empty Lines State -->
  <div id="emptyLinesState" class="card border-0 shadow-sm text-center py-5 <%= (!order.lines || order.lines.length === 0) ? '' : 'd-none' %>" style="border-radius: 12px;">
    <div class="card-body py-4">
      <div class="mb-3 text-secondary" style="font-size: 3rem;">
        <i class="fa-solid fa-cubes-stacked"></i>
      </div>
      <h5 class="fw-bold text-dark mb-1">لا توجد بنود إنتاج في هذا الطلب بعد</h5>
      <p class="text-muted small mb-0">استخدم مربع البحث أعلاه لاختيار القالب وإعداد أول بند إنتاج.</p>
    </div>
  </div>
</div>

<!-- ========================================================================= -->
<!-- Edit Header Modal -->
<!-- ========================================================================= -->
<div class="modal fade" id="editHeaderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
      <div class="modal-header border-bottom py-3">
        <h6 class="modal-title fw-bold text-dark">تعديل بيانات طلب الإنتاج</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div id="editHeaderAlert" class="alert alert-danger d-none mb-3" role="alert"></div>
        <form id="editHeaderForm">
          <div class="mb-3">
            <label for="editDescriptionInput" class="form-label fw-bold text-dark">الوصف:</label>
            <input type="text" id="editDescriptionInput" class="form-control" maxlength="500">
          </div>
          <div class="mb-3">
            <label for="editNotesInput" class="form-label fw-bold text-dark">الملاحظات:</label>
            <textarea id="editNotesInput" class="form-control" rows="3" maxlength="2000"></textarea>
          </div>
          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" id="confirmEditHeaderBtn" class="btn production-theme-btn btn-sm">حفظ التعديلات</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/production-order-edit.js"></script>
