<link rel="stylesheet" href="/css/production-templates.css">

<!-- Header with Back Button (Matching Standard) -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-1" style="color: #1F2937;">
      تعديل قالب: <%= template.name %> <i class="fa-solid fa-pen-to-square text-muted fs-5 ms-2"></i>
    </h3>
    <p class="text-muted mb-0 small">تحديث البيانات الأساسية للقالب وحالة نشاطه</p>
  </div>
  <a href="/production/templates/<%= template.id %>" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
    <i class="fa-solid fa-arrow-right"></i>
    <span>العودة لتفاصيل القالب</span>
  </a>
</div>

<!-- Alert Container -->
<div id="formAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

<form id="editTemplateForm" class="needs-validation" novalidate>
  <div class="row g-4">
    <div class="col-12 col-lg-8 mx-auto">
      <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-header bg-white border-bottom py-3">
          <h6 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-cube me-2 text-muted"></i> البيانات الأساسية للقالب
          </h6>
        </div>
        <div class="card-body p-4">
          <!-- Template Name -->
          <div class="mb-4">
            <label for="templateName" class="form-label fw-bold text-dark">اسم القالب <span class="text-danger">*</span></label>
            <div class="input-group has-validation">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-cubes"></i></span>
              <input type="text" class="form-control" id="templateName" name="name" required maxlength="150" value="<%= template.name %>">
              <div class="invalid-feedback">يرجى إدخال اسم القالب.</div>
            </div>
          </div>

          <!-- Technical Code (Immutable) -->
          <div class="mb-4">
            <label class="form-label fw-bold text-dark">الكود التقني (Code)</label>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-barcode"></i></span>
              <input type="text" class="form-control text-uppercase font-monospace bg-light" value="<%= template.code %>" readonly disabled>
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-lock" title="غير قابل للتعديل"></i></span>
            </div>
            <div class="form-text text-danger">الكود التقني ثابت وفريد في النظام ولا يمكن تعديله بعد الإنشاء لضمان النزاهة التاريخية.</div>
          </div>

          <!-- Reference Number -->
          <div class="mb-4">
            <label for="templateReferenceNumber" class="form-label fw-bold text-dark">رقم / مرجع المنتج (Reference Number)</label>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-hashtag"></i></span>
              <input type="text" class="form-control" id="templateReferenceNumber" name="referenceNumber" maxlength="100" value="<%= template.referenceNumber || '' %>">
            </div>
            <div class="form-text text-muted">الرقم المرجعي المستخدم للتعريف في أوامر العمل والمخططات.</div>
          </div>

          <!-- Description -->
          <div class="mb-4">
            <label for="templateDescription" class="form-label fw-bold text-dark">الوصف والتفاصيل الهندسية</label>
            <textarea class="form-control" id="templateDescription" name="description" rows="3"><%= template.description || '' %></textarea>
          </div>

          <!-- Is Active -->
          <div class="mb-3">
            <label for="templateIsActive" class="form-label fw-bold text-dark">حالة القالب التشغيلية</label>
            <select class="form-select" id="templateIsActive" name="isActive">
              <option value="true" <%= template.isActive ? 'selected' : '' %>>نشط (متاح للاستخدام وتوليد المنتجات)</option>
              <option value="false" <%= !template.isActive ? 'selected' : '' %>>معطل (موقوف مؤقتاً)</option>
            </select>
          </div>
        </div>

        <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center">
          <a href="/production/templates/<%= template.id %>" class="btn btn-light px-4">إلغاء</a>
          <button type="submit" id="btnSubmitTemplate" class="btn production-theme-btn px-5 d-inline-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm d-none" id="submitSpinner" role="status" aria-hidden="true"></span>
            <i class="fa-solid fa-floppy-disk"></i>
            <span>حفظ التعديلات</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</form>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('editTemplateForm');
    const alertBox = document.getElementById('formAlert');
    const btnSubmit = document.getElementById('btnSubmitTemplate');
    const spinner = document.getElementById('submitSpinner');
    const templateId = '<%= template.id %>';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.classList.add('d-none');
      alertBox.textContent = '';

      if (!form.checkValidity()) {
        form.classList.add('was-validated');
        return;
      }

      const name = document.getElementById('templateName').value.trim();
      const referenceNumber = document.getElementById('templateReferenceNumber').value.trim();
      const description = document.getElementById('templateDescription').value.trim();
      const isActive = document.getElementById('templateIsActive').value === 'true';

      const payload = {
        name,
        referenceNumber: referenceNumber || null,
        description: description || null,
        isActive
      };

      btnSubmit.disabled = true;
      spinner.classList.remove('d-none');

      try {
        const res = await window.erpFetch(`/api/production/templates/${templateId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok && data.success) {
          sessionStorage.setItem('pendingToast', 'تم تحديث بيانات القالب بنجاح');
          window.location.href = `/production/templates/${templateId}`;
        } else {
          const msg = data.message || (data.errors ? Object.values(data.errors).flat().join('، ') : 'حدث خطأ أثناء حفظ التعديلات');
          alertBox.textContent = msg;
          alertBox.classList.remove('d-none');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      } catch {
        alertBox.textContent = 'تعذر الاتصال بالخادم. يرجى المحاولة مرة أخرى.';
        alertBox.classList.remove('d-none');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } finally {
        btnSubmit.disabled = false;
        spinner.classList.add('d-none');
      }
    });
  });
</script>
