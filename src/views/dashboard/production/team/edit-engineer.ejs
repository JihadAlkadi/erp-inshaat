<div class="row justify-content-center">
  <div class="col-lg-8 col-xl-7">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <a href="/production/departments" class="text-muted text-decoration-none small">أقسام الإنتاج</a>
          <span class="text-muted small">/</span>
          <a href="/production/departments/<%= department.id %>/team" class="text-muted text-decoration-none small"><%= department.name %></a>
          <span class="text-muted small">/</span>
          <span class="text-primary small fw-bold">تعديل ساحات المهندس</span>
        </div>
        <h3 class="fw-bold mb-1" style="color: #1F2937;">
          تعديل ساحات المهندس: <%= engineer.fullName %>
          <i class="fa-solid fa-pen-to-square text-muted fs-5 ms-2"></i>
        </h3>
        <p class="text-muted mb-0 small">
          تعديل الساحات التشغيلية المسندة للمهندس داخل قسم: <%= department.name %>
        </p>
      </div>
      <a href="/production/departments/<%= department.id %>/team" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-right"></i>
        <span>العودة للفريق</span>
      </a>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
      <div class="card-body p-4">
        <div id="formAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

        <!-- Engineer Info Card -->
        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded mb-4 border">
          <div class="rounded-circle d-flex justify-content-center align-items-center text-white fw-bold bg-success" style="width: 44px; height: 44px; font-size: 1.1rem;">
            <%= engineer.fullName ? engineer.fullName.charAt(0) : 'E' %>
          </div>
          <div>
            <div class="fw-bold text-dark"><%= engineer.fullName %></div>
            <div class="text-muted small">
              <% if (engineer.phone) { %>
                <i class="fa-solid fa-phone me-1"></i> <%= engineer.phone %>
              <% } %>
            </div>
          </div>
        </div>

        <form
          id="editEngineerYardsForm"
          class="needs-validation"
          novalidate
          data-department-id="<%= department.id %>"
          data-assignment-id="<%= engineer.assignmentId %>"
        >
          <!-- Yard Selection Checkboxes -->
          <div class="mb-4">
            <label class="form-label fw-bold mb-2">
              الساحات المسندة للمهندس في هذا القسم <span class="text-danger">*</span>
            </label>
            <div class="form-text small text-muted mb-3">
              يجب تحديد ساحة واحدة على الأقل.
            </div>

            <% 
              const assignedYardIds = (engineer.yards || []).map(y => y.id);
              const inactiveAssignedYards = (engineer.yards || []).filter(y => !y.isActive);
            %>

            <% if (inactiveAssignedYards.length > 0) { %>
              <div class="alert alert-warning py-2 px-3 mb-3 small" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                <strong>تنبيه:</strong> المهندس مرتبط حالياً بساحة معطلة (<%= inactiveAssignedYards.map(y => y.name).join('، ') %>). الساحات المعطلة لا تظهر في قائمة الاختيار وسيتم استبعادها عند حفظ التعديلات.
              </div>
            <% } %>

            <% if (departmentYards && departmentYards.length > 0) { %>
              <div class="border rounded p-3 bg-light" style="max-height: 250px; overflow-y: auto;">
                <div class="row g-2">
                  <% departmentYards.forEach(function(yard) { %>
                    <div class="col-md-6">
                      <div class="form-check p-2 bg-white rounded border">
                        <input
                          class="form-check-input ms-2 yard-checkbox"
                          type="checkbox"
                          name="yardIds"
                          value="<%= yard.id %>"
                          id="yard_<%= yard.id %>"
                          <%= assignedYardIds.includes(yard.id) ? 'checked' : '' %>
                        >
                        <label class="form-check-label w-100 cursor-pointer" for="yard_<%= yard.id %>">
                          <span class="fw-bold text-dark"><%= yard.name %></span>
                          <span class="badge bg-light text-secondary border ms-1"><%= yard.code %></span>
                          <div class="text-muted small">السعة: <%= yard.capacity %> غرفة</div>
                        </label>
                      </div>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } else { %>
              <div class="alert alert-warning mb-0" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                لا توجد ساحات نشطة في هذا القسم حالياً.
              </div>
            <% } %>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a href="/production/departments/<%= department.id %>/team" class="btn btn-light px-4">إلغاء</a>
            <button
              type="submit"
              id="submitBtn"
              class="btn btn-primary d-inline-flex align-items-center gap-2 px-4"
              style="background-color: #0984E3; border-color: #0984E3;"
              <%= !departmentYards || departmentYards.length === 0 ? 'disabled' : '' %>
            >
              <span class="spinner-border spinner-border-sm d-none" role="status"></span>
              <i class="fa-solid fa-floppy-disk"></i>
              <span id="btnText">حفظ التغييرات</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  window.currentDepartmentId = '<%= department.id %>';
</script>
<script src="/js/production-team.js"></script>
