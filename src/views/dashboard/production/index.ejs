<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="fw-bold mb-1" style="color: #1F2937;">
        إدارة الإنتاج
        <i class="fa-solid fa-industry text-muted fs-5 ms-2"></i>
      </h3>
      <p class="text-muted mb-0 small">
        الهيكل التنظيمي والتشغيلي لخطوط ومراحل الإنتاج والساحات
      </p>
    </div>
  </div>

  <div class="row g-4">
    <!-- بطاقة الأقسام -->
    <div class="col-md-6 col-lg-4">
      <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; transition: transform 0.2s;">
        <div class="card-body p-4 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div class="rounded-circle d-flex justify-content-center align-items-center text-white" style="width: 50px; height: 50px; background: linear-gradient(135deg, #0984E3 0%, #74B9FF 100%);">
                <i class="fa-solid fa-building-user fs-4"></i>
              </div>
              <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">تشغيلي</span>
            </div>
            <h5 class="fw-bold text-dark mb-2">أقسام الإنتاج</h5>
            <p class="text-muted small mb-4">
              إدارة وتعريف الأقسام التشغيلية المستقلة في المصنع (مثل الصب، الإكساء، الجودة).
            </p>
          </div>
          <a href="/production/departments" class="btn btn-outline-primary w-100 d-inline-flex justify-content-center align-items-center gap-2" style="border-radius: 8px;">
            <span>استعراض الأقسام</span>
            <i class="fa-solid fa-arrow-left"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- بطاقة الساحات -->
    <div class="col-md-6 col-lg-4">
      <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; transition: transform 0.2s;">
        <div class="card-body p-4 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div class="rounded-circle d-flex justify-content-center align-items-center text-white" style="width: 50px; height: 50px; background: linear-gradient(135deg, #00CEC9 0%, #81ECEC 100%);">
                <i class="fa-solid fa-square-parking fs-4"></i>
              </div>
              <span class="badge bg-info-subtle text-info-emphasis px-3 py-2 rounded-pill">مساحات</span>
            </div>
            <h5 class="fw-bold text-dark mb-2">ساحات الإنتاج</h5>
            <p class="text-muted small mb-4">
              إدارة الساحات التابعة لكل قسم وتحديد سعتها الاستيعابية من الغرف.
            </p>
          </div>
          <a href="/production/yards" class="btn btn-outline-info w-100 d-inline-flex justify-content-center align-items-center gap-2" style="border-radius: 8px;">
            <span>استعراض الساحات</span>
            <i class="fa-solid fa-arrow-left"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
