<!-- Product Details Page (Matching System UI Standard) -->
<div class="product-show-container pb-5">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb small mb-0">
          <li class="breadcrumb-item"><a href="/inventory" class="text-decoration-none text-muted">المستودعات</a></li>
          <li class="breadcrumb-item"><a href="/inventory/products" class="text-decoration-none text-muted">دليل المنتجات</a></li>
          <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page"><%= product.name %></li>
        </ol>
      </nav>
      <!-- Title & Badges -->
      <div class="d-flex flex-wrap align-items-center gap-2">
        <h3 class="fw-bold mb-0 text-dark">
          <%= product.name %>
          <i class="fa-solid fa-cube text-muted fs-5 ms-2"></i>
        </h3>
        <span class="badge bg-light text-dark border font-monospace px-2.5 py-1.5 fs-6" id="productCodeBadge" title="انقر لنسخ الكود" style="cursor: pointer;">
          <i class="fa-solid fa-barcode text-muted me-1"></i>
          <span><%= product.code %></span>
          <i class="fa-regular fa-copy text-muted ms-1 small"></i>
        </span>
        <span class="badge <%= product.isActive ? 'bg-success bg-opacity-10 text-success border border-success' : 'bg-secondary bg-opacity-10 text-secondary border' %> px-2.5 py-1.5 fs-6">
          <i class="fa-solid fa-<%= product.isActive ? 'circle-check' : 'circle-xmark' %> me-1"></i>
          <%= product.isActive ? 'نشط' : 'معطل' %>
        </span>
        <% if (product.categoryName) { %>
          <span class="badge bg-info bg-opacity-10 text-info border border-info px-2.5 py-1.5 fs-6">
            <i class="fa-solid fa-folder me-1"></i>
            <%= product.categoryName %>
          </span>
        <% } %>
      </div>
    </div>

    <!-- Header Actions (No print on paper) -->
    <div class="d-flex flex-wrap align-items-center gap-2 d-print-none">
      <a href="/inventory/products" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
        <i class="fa-solid fa-arrow-right"></i>
        <span>العودة للقائمة</span>
      </a>

      <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" onclick="window.print()" style="border-radius: 8px;" title="طباعة بطاقة المادة">
        <i class="fa-solid fa-print"></i>
        <span class="d-none d-sm-inline">طباعة</span>
      </button>

      <% if (typeof canUpdateProduct !== 'undefined' && canUpdateProduct) { %>
        <a href="/inventory/products/<%= product.id %>/edit" class="btn btn-primary d-inline-flex align-items-center gap-2 text-white" style="background-color: #10AC84; border-color: #10AC84; border-radius: 8px;">
          <i class="fa-solid fa-pen-to-square"></i>
          <span>تعديل المنتج</span>
        </a>
      <% } %>

      <% if (typeof canDeleteProduct !== 'undefined' && canDeleteProduct) { %>
        <button type="button" class="btn btn-outline-danger d-inline-flex align-items-center gap-2" id="btnArchiveFromShow" style="border-radius: 8px;">
          <i class="fa-solid fa-trash-can"></i>
          <span>أرشفة</span>
        </button>
      <% } %>
    </div>
  </div>

  <!-- Alert Container -->
  <div id="productShowAlertContainer" class="d-print-none"></div>

  <!-- KPI Summary Cards Row (4 Cards) -->
  <div class="row g-3 mb-4">
    <!-- Base Unit KPI -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-right: 4px solid #10AC84 !important;">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-circle d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success flex-shrink-0" style="width: 52px; height: 52px; font-size: 1.35rem;">
            <i class="fa-solid fa-scale-balanced"></i>
          </div>
          <div class="overflow-hidden">
            <span class="text-muted small d-block text-truncate">الوحدة الأساسية</span>
            <h5 class="fw-bold text-dark mb-0 text-truncate" title="<%= product.baseUnitName %>">
              <%= product.baseUnitName %>
            </h5>
            <small class="text-success small fw-semibold">مرجع القياس الذري</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Base Price KPI -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-right: 4px solid #3B82F6 !important;">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary flex-shrink-0" style="width: 52px; height: 52px; font-size: 1.35rem;">
            <i class="fa-solid fa-money-bill-wave"></i>
          </div>
          <div class="overflow-hidden">
            <span class="text-muted small d-block text-truncate">السعر المرجعي الأساسي</span>
            <h5 class="fw-bold text-dark mb-0 font-monospace text-truncate">
              <%= product.baseUnit && product.baseUnit.price ? Number(product.baseUnit.price).toLocaleString('ar-EG', { minimumFractionDigits: 2, maximumFractionDigits: 4 }) : '0.00' %>
            </h5>
            <small class="text-muted small">لكل <%= product.baseUnitName %></small>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Units Count KPI -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-right: 4px solid #06B6D4 !important;">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-circle d-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info flex-shrink-0" style="width: 52px; height: 52px; font-size: 1.35rem;">
            <i class="fa-solid fa-layer-group"></i>
          </div>
          <div class="overflow-hidden">
            <span class="text-muted small d-block text-truncate">وحدات القياس</span>
            <h5 class="fw-bold text-dark mb-0">
              <%= totalUnits %> <span class="fs-6 fw-normal text-muted">وحدات</span>
            </h5>
            <small class="text-muted small">
              <%= totalUnits > 1 ? `تتضمن ${totalUnits - 1} وحدة إضافية` : 'الوحدة الأساسية فقط' %>
            </small>
          </div>
        </div>
      </div>
    </div>

    <!-- Storage Location KPI -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-right: 4px solid #F59E0B !important;">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning flex-shrink-0" style="width: 52px; height: 52px; font-size: 1.35rem;">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div class="overflow-hidden">
            <span class="text-muted small d-block text-truncate">مكان وجود المادة</span>
            <h5 class="fw-bold text-dark mb-0 text-truncate" title="<%= product.locationName || 'غير محدد' %>">
              <%= product.locationName || 'غير محدد' %>
            </h5>
            <small class="text-muted small">موقع وصفي إرشادي</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Grid -->
  <div class="row g-4">
    <!-- Main Left Column: Units & Conversions (8 cols on lg/xl, 12 on mobile) -->
    <div class="col-12 col-lg-8">
      <!-- Units Table Card -->
      <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div class="d-flex align-items-center gap-2">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-scale-balanced me-2" style="color: #10AC84;"></i> وحدات القياس ومعادلات التحويل
            </h6>
            <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-2.5 py-1">
              <%= units.length %> وحدة
            </span>
          </div>
          <% if (typeof canUpdateProduct !== 'undefined' && canUpdateProduct) { %>
            <a href="/inventory/products/<%= product.id %>/edit#units" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" style="border-radius: 6px;">
              <i class="fa-solid fa-plus small"></i>
              <span>إدارة الوحدات</span>
            </a>
          <% } %>
        </div>

        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr class="text-muted small">
                  <th scope="col" class="py-3 px-3">اسم الوحدة</th>
                  <th scope="col" class="py-3">النوع</th>
                  <th scope="col" class="py-3">معادلة التعادل والتحويل</th>
                  <th scope="col" class="py-3">السعر المرجعي</th>
                  <th scope="col" class="py-3">الباركود</th>
                  <th scope="col" class="py-3 text-end px-3">المواصفات الفنية</th>
                </tr>
              </thead>
              <tbody>
                <% if (units && units.length > 0) { %>
                  <% units.forEach(function(unit) { %>
                    <tr class="<%= unit.isBase ? 'table-success bg-opacity-10' : '' %>">
                      <!-- Unit Name -->
                      <td class="py-3 px-3">
                        <div class="d-flex align-items-center gap-2">
                          <i class="fa-solid fa-<%= unit.isBase ? 'star text-warning' : 'tag text-muted' %>"></i>
                          <span class="fw-bold text-dark"><%= unit.name %></span>
                        </div>
                      </td>

                      <!-- Unit Type -->
                      <td class="py-3">
                        <% if (unit.isBase) { %>
                          <span class="badge bg-success bg-opacity-10 text-success border border-success px-2.5 py-1 rounded-pill">
                            الوحدة الأساسية
                          </span>
                        <% } else { %>
                          <span class="badge bg-light text-muted border px-2.5 py-1 rounded-pill">
                            وحدة إضافية
                          </span>
                        <% } %>
                      </td>

                      <!-- Conversion Formula -->
                      <td class="py-3">
                        <% if (unit.isBase) { %>
                          <span class="text-muted small">مرجع القياس الذري (معامل = 1)</span>
                        <% } else { %>
                          <div class="p-1 px-2.5 bg-light rounded border d-inline-flex align-items-center gap-1.5 font-monospace small">
                            <span class="fw-bold text-primary">1 <%= unit.name %></span>
                            <span class="text-muted">=</span>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary"><%= unit.conversionQuantity %></span>
                            <span class="text-muted">×</span>
                            <span class="text-dark fw-semibold"><%= unit.equivalentToUnitName || product.baseUnitName %></span>
                          </div>
                        <% } %>
                      </td>

                      <!-- Reference Price -->
                      <td class="py-3 font-monospace fw-bold text-dark">
                        <%= unit.price ? Number(unit.price).toLocaleString('ar-EG', { minimumFractionDigits: 2, maximumFractionDigits: 4 }) : '0.00' %>
                      </td>

                      <!-- Barcode -->
                      <td class="py-3">
                        <% if (unit.barcode) { %>
                          <span class="badge bg-light text-dark border font-monospace px-2 py-1" title="رمز الباركود">
                            <i class="fa-solid fa-barcode text-muted me-1"></i><%= unit.barcode %>
                          </span>
                        <% } else { %>
                          <span class="text-muted small">--</span>
                        <% } %>
                      </td>

                      <!-- Specifications -->
                      <td class="py-3 text-end px-3">
                        <% if (unit.specifications && unit.specifications.length > 0) { %>
                          <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                            <% unit.specifications.forEach(function(spec) { %>
                              <span class="badge bg-light text-dark border small" title="<%= spec.name %>: <%= spec.value %> <%= spec.unit || '' %>">
                                <strong class="text-muted"><%= spec.name %>:</strong> <%= spec.value %> <%= spec.unit || '' %>
                              </span>
                            <% }); %>
                          </div>
                        <% } else { %>
                          <span class="text-muted small">--</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                      لا توجد وحدات معرّفة لهذا المنتج حالياً.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Conversion DAG Tree Visualizer Card -->
      <% if (units && units.length > 1) { %>
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
          <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-diagram-project me-2 text-muted"></i> مخطط شجرة التحويل الهرمية للوحدات
            </h6>
          </div>
          <div class="card-body p-4">
            <div class="conversion-chain-flow d-flex flex-wrap align-items-center gap-2">
              <div class="flow-step base-step p-2.5 px-3 rounded-3 border border-success bg-success bg-opacity-10 d-inline-flex align-items-center gap-2">
                <i class="fa-solid fa-star text-warning"></i>
                <div class="d-flex flex-column">
                  <span class="fw-bold text-success"><%= product.baseUnitName %></span>
                  <small class="text-muted" style="font-size: 0.75rem;">الوحدة الأساسية (1.0)</small>
                </div>
              </div>

              <% units.filter(function(u) { return !u.isBase; }).forEach(function(u) { %>
                <i class="fa-solid fa-arrow-left text-muted small"></i>
                <div class="flow-step p-2.5 px-3 rounded-3 border bg-light d-inline-flex align-items-center gap-2">
                  <i class="fa-solid fa-link text-primary small"></i>
                  <div class="d-flex flex-column">
                    <span class="fw-bold text-dark"><%= u.name %></span>
                    <small class="text-muted" style="font-size: 0.75rem;">
                      = <%= u.conversionQuantity %> × <%= u.equivalentToUnitName || product.baseUnitName %>
                    </small>
                  </div>
                </div>
              <% }); %>
            </div>
            <p class="text-muted small mt-3 mb-0">
              <i class="fa-solid fa-circle-info text-info me-1"></i>
              تضمن معمارية النظام انتهاء كافة سلاسل التحويل بالوحدة الأساسية دون أي حلقات دائرية (Acyclic Conversion Graph).
            </p>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Right Sidebar Column: Metadata, Description & Base Specs (4 cols on lg/xl, 12 on mobile) -->
    <div class="col-12 col-lg-4">
      <!-- Product Details Card -->
      <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-header bg-white border-bottom py-3">
          <h6 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-circle-info me-2 text-muted"></i> بيانات بطاقة الصنف
          </h6>
        </div>
        <div class="card-body p-4">
          <ul class="list-unstyled mb-0 d-flex flex-column gap-3">
            <!-- Code -->
            <li class="d-flex justify-content-between align-items-center pb-2 border-bottom">
              <span class="text-muted small"><i class="fa-solid fa-barcode me-1.5 text-muted"></i> رمز الصنف (الكود)</span>
              <span class="fw-bold font-monospace text-dark"><%= product.code %></span>
            </li>

            <!-- Category -->
            <li class="d-flex justify-content-between align-items-center pb-2 border-bottom">
              <span class="text-muted small"><i class="fa-solid fa-folder-tree me-1.5 text-muted"></i> فئة المنتج</span>
              <span class="fw-bold text-dark"><%= product.categoryName || 'غير مصنف' %></span>
            </li>

            <!-- Location -->
            <li class="d-flex justify-content-between align-items-center pb-2 border-bottom">
              <span class="text-muted small"><i class="fa-solid fa-location-dot me-1.5 text-muted"></i> مكان التخزين</span>
              <span class="fw-semibold text-dark"><%= product.locationName || '--' %></span>
            </li>

            <!-- Status -->
            <li class="d-flex justify-content-between align-items-center pb-2 border-bottom">
              <span class="text-muted small"><i class="fa-solid fa-toggle-on me-1.5 text-muted"></i> الحالة التشغيلية</span>
              <span class="badge <%= product.isActive ? 'bg-success bg-opacity-10 text-success border border-success' : 'bg-secondary bg-opacity-10 text-secondary border' %>">
                <%= product.isActive ? 'نشط' : 'معطل' %>
              </span>
            </li>

            <!-- Created At -->
            <li class="d-flex justify-content-between align-items-center pb-2 border-bottom">
              <span class="text-muted small"><i class="fa-regular fa-calendar-plus me-1.5 text-muted"></i> تاريخ التعريف</span>
              <span class="text-muted small" title="<%= new Date(product.createdAt).toLocaleString('ar-EG') %>">
                <%= new Date(product.createdAt).toLocaleDateString('ar-EG') %>
              </span>
            </li>

            <!-- Updated At -->
            <li class="d-flex justify-content-between align-items-center">
              <span class="text-muted small"><i class="fa-regular fa-pen-to-square me-1.5 text-muted"></i> آخر تحديث</span>
              <span class="text-muted small" title="<%= new Date(product.updatedAt).toLocaleString('ar-EG') %>">
                <%= new Date(product.updatedAt).toLocaleDateString('ar-EG') %>
              </span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Description Card -->
      <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-header bg-white border-bottom py-3">
          <h6 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-align-right me-2 text-muted"></i> الوصف والملاحظات
          </h6>
        </div>
        <div class="card-body p-4">
          <% if (product.description && product.description.trim()) { %>
            <p class="mb-0 text-dark" style="white-space: pre-line; line-height: 1.7;">
              <%= product.description %>
            </p>
          <% } else { %>
            <p class="text-muted mb-0 small fst-italic">
              لا يوجد وصف مسجل لهذا المنتج حالياً.
            </p>
          <% } %>
        </div>
      </div>

      <!-- Base Unit Technical Specifications Card -->
      <% if (product.baseUnit && product.baseUnit.specifications && product.baseUnit.specifications.length > 0) { %>
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
          <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-sliders me-2 text-muted"></i> المواصفات الفنية للوحدة الأساسية
            </h6>
          </div>
          <div class="card-body p-4">
            <div class="table-responsive">
              <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light">
                  <tr class="small text-muted">
                    <th>الخاصية</th>
                    <th>القيمة</th>
                    <th>الوحدة</th>
                  </tr>
                </thead>
                <tbody>
                  <% product.baseUnit.specifications.forEach(function(spec) { %>
                    <tr>
                      <td class="fw-bold text-dark"><%= spec.name %></td>
                      <td><%= spec.value %></td>
                      <td class="text-muted"><%= spec.unit || '--' %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<style>
/* Print optimizations for official warehouse card output */
@media print {
  .breadcrumb, .d-print-none, .btn, nav, .sidebar {
    display: none !important;
  }
  .product-show-container {
    padding: 0 !important;
    background: transparent !important;
  }
  .card {
    border: 1px solid #ddd !important;
    box-shadow: none !important;
    break-inside: avoid;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // 1. Copy code to clipboard on click
  const codeBadge = document.getElementById('productCodeBadge');
  if (codeBadge) {
    codeBadge.addEventListener('click', () => {
      const codeText = '<%= product.code %>';
      navigator.clipboard.writeText(codeText).then(() => {
        if (typeof Swal !== 'undefined') {
          const Toast = Swal.mixin({
            toast: true,
            position: 'top-start',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true,
          });
          Toast.fire({ icon: 'success', title: 'تم نسخ رمز المنتج للحافظة: ' + codeText });
        }
      }).catch(() => {});
    });
  }

  // 2. Archive button with SweetAlert2
  const btnArchive = document.getElementById('btnArchiveFromShow');
  if (btnArchive) {
    btnArchive.addEventListener('click', () => {
      const actionTitle = 'أرشفة المنتج';
      const actionText = 'هل أنت متأكد من رغبتك في أرشفة منتج "<%= product.name %>"؟ سيتم نقله إلى الأرشيف ولن يظهر في القوائم النشطة.';

      if (typeof Swal !== 'undefined') {
        Swal.fire({
          title: actionTitle,
          text: actionText,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#EE5253',
          cancelButtonColor: '#6B7280',
          confirmButtonText: 'نعم، أرشفة المنتج',
          cancelButtonText: 'إلغاء',
        }).then(async (result) => {
          if (result.isConfirmed) {
            try {
              const res = await window.erpFetch('/api/inventory/products/<%= product.id %>', {
                method: 'DELETE',
              });
              const json = await res.json();

              if (json.success) {
                sessionStorage.setItem('pendingToast', 'تمت أرشفة المنتج بنجاح');
                window.location.href = '/inventory/products';
              } else {
                Swal.fire({
                  icon: 'error',
                  title: 'تعذر أرشفة المنتج',
                  text: json.message || 'حدث خطأ أثناء أرشفة المنتج',
                  confirmButtonText: 'حسناً',
                  confirmButtonColor: '#10AC84',
                });
              }
            } catch (err) {
              Swal.fire({
                icon: 'error',
                title: 'خطأ في الاتصال',
                text: 'تعذر الاتصال بالخادم أثناء أرشفة المنتج',
                confirmButtonText: 'حسناً',
                confirmButtonColor: '#10AC84',
              });
            }
          }
        });
      } else {
        if (confirm(actionText)) {
          window.erpFetch('/api/inventory/products/<%= product.id %>', { method: 'DELETE' })
            .then(res => res.json())
            .then(json => {
              if (json.success) {
                window.location.href = '/inventory/products';
              } else {
                alert(json.message || 'فشل في أرشفة المنتج');
              }
            });
        }
      }
    });
  }
});
</script>
