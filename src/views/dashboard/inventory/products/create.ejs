<div class="row justify-content-center">
  <div class="col-lg-10 col-xl-9">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1" style="color: #1F2937;">إضافة منتج جديد <i class="fa-solid fa-box-open text-muted fs-5 ms-2"></i></h3>
        <p class="text-muted mb-0 small">إضافة منتج جديد إلى كتالوج المنتجات وتحديد وحدته الأساسية ومواصفاته</p>
      </div>
      <a href="/inventory/products" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left ms-1"></i> العودة للقائمة
      </a>
    </div>

    <!-- Alert Container -->
    <div id="productFormAlertContainer"></div>

    <form id="createProductForm" novalidate>
      <div class="row g-4">
        <!-- Section 1: Basic Product Information Card -->
        <div class="col-12 col-lg-6">
          <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom py-3">
              <h6 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-cube text-muted me-2"></i> بيانات المنتج الأساسية
              </h6>
            </div>
            <div class="card-body p-4">
              <!-- Product Name -->
              <div class="mb-4">
                <label for="productName" class="form-label fw-bold text-dark">اسم المنتج <span class="text-danger">*</span></label>
                <div class="input-group has-validation">
                  <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-box"></i></span>
                  <input type="text" class="form-control" id="productName" name="name" required maxlength="150" placeholder="مثال: برغي تثبيت حديدي 10 مم">
                  <div class="invalid-feedback">يرجى إدخال اسم المنتج</div>
                </div>
              </div>

              <!-- Product Code -->
              <div class="mb-4">
                <label for="productCode" class="form-label fw-bold text-dark">رمز المنتج (الكود) <span class="text-danger">*</span></label>
                <div class="input-group has-validation">
                  <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-barcode"></i></span>
                  <input type="text" class="form-control text-uppercase font-monospace" id="productCode" name="code" required maxlength="50" placeholder="مثال: SCR-001">
                  <div class="invalid-feedback">يرجى إدخال رمز فريد للمنتج</div>
                </div>
                <div class="form-text text-muted">رمز فريد وثابت في النظام لا يمكن تعديله بعد الإنشاء.</div>
              </div>

              <!-- Category -->
              <div class="mb-4">
                <label for="productCategoryId" class="form-label fw-bold text-dark">فئة المنتج (اختياري)</label>
                <div class="input-group">
                  <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-folder"></i></span>
                  <select class="form-select" id="productCategoryId" name="categoryId">
                    <option value="">-- بدون فئة (غير مصنف) --</option>
                  </select>
                </div>
              </div>

              <!-- Location Name -->
              <div class="mb-4">
                <label for="productLocationName" class="form-label fw-bold text-dark">مكان وجود المادة (اختياري)</label>
                <div class="input-group">
                  <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-location-dot"></i></span>
                  <input type="text" class="form-control" id="productLocationName" name="locationName" maxlength="255" placeholder="مثال: مستودع الحديد - الرف A3">
                </div>
                <div class="form-text text-muted">نص وصفي إرشادي لمكان التخزين (بدون أرصدة أو حركات).</div>
              </div>

              <!-- Description -->
              <div class="mb-4">
                <label for="productDescription" class="form-label fw-bold text-dark">الوصف (اختياري)</label>
                <textarea class="form-control" id="productDescription" name="description" rows="3" placeholder="ملاحظات أو مواصفات عامة حول المنتج..."></textarea>
              </div>

              <!-- Active Status -->
              <div class="mb-2">
                <div class="form-check form-switch fs-6">
                  <input class="form-check-input" type="checkbox" role="switch" id="productIsActive" name="isActive" checked>
                  <label class="form-check-label fw-bold text-dark" for="productIsActive">منتج نشط في الكتالوج</label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 2: Base Unit Definition Card -->
        <div class="col-12 col-lg-6">
          <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
              <h6 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-scale-balanced text-muted me-2"></i> تعريف الوحدة الأساسية
              </h6>
              <span class="badge bg-secondary bg-opacity-10 text-dark border">إلزامية</span>
            </div>
            <div class="card-body p-4">
              <!-- Base Unit Name -->
              <div class="mb-4">
                <label for="baseUnitName" class="form-label fw-bold text-dark">اسم الوحدة الأساسية <span class="text-danger">*</span></label>
                <div class="input-group has-validation">
                  <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-tag"></i></span>
                  <input type="text" class="form-control" id="baseUnitName" name="baseUnitName" required maxlength="100" placeholder="مثال: قطعة، متر، كغ">
                  <div class="invalid-feedback">يرجى إدخال اسم الوحدة الأساسية</div>
                </div>
                <div class="form-text text-muted">أصغر وحدة قياس يعتمد عليها المنتج، وتكون مرجعاً لحساب الوحدات الإضافية.</div>
              </div>

              <div class="row g-3 mb-4">
                <!-- Reference Price -->
                <div class="col-12 col-sm-6">
                  <label for="baseUnitPrice" class="form-label fw-bold text-dark">السعر المرجعي <span class="text-danger">*</span></label>
                  <div class="input-group has-validation">
                    <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-coins"></i></span>
                    <input type="number" step="0.0001" min="0" class="form-control" id="baseUnitPrice" name="baseUnitPrice" required placeholder="0.00">
                  </div>
                </div>

                <!-- Barcode -->
                <div class="col-12 col-sm-6">
                  <label for="baseUnitBarcode" class="form-label fw-bold text-dark">الباركود (اختياري)</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-barcode"></i></span>
                    <input type="text" class="form-control font-monospace" id="baseUnitBarcode" name="baseUnitBarcode" maxlength="100" placeholder="مثال: 628100012345">
                  </div>
                </div>
              </div>

              <!-- Specifications Dynamic Section -->
              <div class="pt-3 border-top mt-2">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <label class="form-label fw-bold text-dark mb-0 small">المواصفات الفنية للوحدة (اختياري)</label>
                  <button type="button" class="btn btn-sm btn-outline-secondary" id="btnAddBaseSpec">
                    <i class="fa-solid fa-plus me-1"></i> إضافة خاصية
                  </button>
                </div>

                <div id="baseSpecsContainer" class="d-flex flex-column gap-2">
                  <!-- Dynamic Spec Rows will be injected here -->
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Submit Buttons Card -->
        <div class="col-12">
          <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-3 d-flex justify-content-end gap-2 align-items-center">
              <a href="/inventory/products" class="btn btn-light px-4">إلغاء</a>
              <button type="submit" id="btnSubmitProduct" class="btn btn-primary btn-module-primary px-5 d-inline-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm d-none" id="submitSpinner" role="status"></span>
                <i class="fa-solid fa-check"></i>
                <span>حفظ ومتابعة إضافة الوحدات</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="/js/inventory-products.js"></script>
