<div class="container-fluid">
  <!-- Breadcrumb & Header -->
  <div class="mb-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/inventory" class="text-decoration-none">المستودعات</a></li>
        <li class="breadcrumb-item"><a href="/inventory/products" class="text-decoration-none">المنتجات</a></li>
        <li class="breadcrumb-item active" aria-current="page">إضافة منتج جديد</li>
      </ol>
    </nav>
    <h3 class="fw-bold" style="color: #2D3436;">
      <i class="fa-solid fa-box-open me-2" style="color: #10AC84;"></i> إضافة منتج جديد
    </h3>
  </div>

  <!-- Alert Container -->
  <div id="productFormAlertContainer"></div>

  <form id="createProductForm" novalidate>
    <div class="row g-4 justify-content-center">
      <!-- Left Column: Product Info -->
      <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
          <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-cube me-2 text-muted"></i> بيانات المنتج الأساسية
            </h6>
          </div>
          <div class="card-body p-4">
            <!-- Product Name -->
            <div class="mb-3">
              <label for="productName" class="form-label fw-bold">اسم المنتج <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="productName" name="name" required maxlength="150" placeholder="مثال: برغي تثبيت حديدي">
            </div>

            <!-- Product Code -->
            <div class="mb-3">
              <label for="productCode" class="form-label fw-bold">رمز المنتج (الكود) <span class="text-danger">*</span></label>
              <input type="text" class="form-control text-uppercase" id="productCode" name="code" required maxlength="50" placeholder="مثال: SCR-001">
              <div class="form-text">رمز فريد وثابت في النظام لا يمكن تعديله بعد الإنشاء.</div>
            </div>

            <!-- Category -->
            <div class="mb-3">
              <label for="productCategoryId" class="form-label fw-bold">فئة المنتج (اختياري)</label>
              <select class="form-select" id="productCategoryId" name="categoryId">
                <option value="">-- بدون فئة (غير مصنف) --</option>
              </select>
            </div>

            <!-- Location Name (Text only) -->
            <div class="mb-3">
              <label for="productLocationName" class="form-label fw-bold">مكان وجود المادة (اختياري)</label>
              <input type="text" class="form-control" id="productLocationName" name="locationName" maxlength="255" placeholder="مثال: مستودع الحديد - الرف A3">
              <div class="form-text">نص وصفي إرشادي لمكان تخزين المادة (بدون حركات أو أرصدة).</div>
            </div>

            <!-- Description -->
            <div class="mb-3">
              <label for="productDescription" class="form-label fw-bold">الوصف (اختياري)</label>
              <textarea class="form-control" id="productDescription" name="description" rows="3" placeholder="ملاحظات أو مواصفات عامة حول المنتج..."></textarea>
            </div>

            <!-- Is Active -->
            <div class="mb-3">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="productIsActive" name="isActive" checked>
                <label class="form-check-label fw-bold" for="productIsActive">منتج نشط</label>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Base Unit & Specifications -->
      <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100" style="border-top: 3px solid #10AC84 !important;">
          <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-scale-balanced me-2 text-success"></i> تعريف الوحدة الأساسية
            </h6>
            <span class="badge bg-success bg-opacity-10 text-success border border-success">إلزامية</span>
          </div>
          <div class="card-body p-4">
            <!-- Base Unit Name -->
            <div class="mb-3">
              <label for="baseUnitName" class="form-label fw-bold">اسم الوحدة الأساسية <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="baseUnitName" name="baseUnitName" required maxlength="100" placeholder="مثال: قطعة، متر، كغ">
              <div class="form-text">أصغر وحدة قياس يعتمد عليها المنتج، وتكون مرجعاً للوحدات الإضافية.</div>
            </div>

            <div class="row g-3 mb-3">
              <!-- Price -->
              <div class="col-12 col-sm-6">
                <label for="baseUnitPrice" class="form-label fw-bold">السعر المرجعي <span class="text-danger">*</span></label>
                <input type="number" step="0.0001" min="0" class="form-control" id="baseUnitPrice" name="baseUnitPrice" required placeholder="0.00">
              </div>

              <!-- Barcode -->
              <div class="col-12 col-sm-6">
                <label for="baseUnitBarcode" class="form-label fw-bold">الباركود (اختياري)</label>
                <input type="text" class="form-control" id="baseUnitBarcode" name="baseUnitBarcode" maxlength="100" placeholder="مثال: 628100012345">
              </div>
            </div>

            <!-- Specifications Dynamic Section -->
            <div class="pt-3 border-top mt-4">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="form-label fw-bold mb-0">المواصفات الفنية للوحدة الأساسية (اختياري)</label>
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3" id="btnAddBaseSpec">
                  <i class="fa-solid fa-plus me-1"></i> إضافة خاصية
                </button>
              </div>

              <div id="baseSpecsContainer" class="d-flex flex-column gap-2">
                <!-- Dynamic Spec Rows will be injected here -->
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Submit Footer -->
      <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-body p-3 d-flex justify-content-between align-items-center">
            <a href="/inventory/products" class="btn btn-outline-secondary rounded-pill px-4">إلغاء</a>
            <button type="submit" id="btnSubmitProduct" class="btn btn-primary rounded-pill px-5 fw-bold" style="background-color: #10AC84; border-color: #10AC84;">
              <span class="spinner-border spinner-border-sm d-none me-1" id="submitSpinner" role="status"></span>
              حفظ ومتابعة إضافة الوحدات
            </button>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<script src="/js/inventory-products.js"></script>
