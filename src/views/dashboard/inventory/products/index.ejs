<div class="container-fluid">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <h3 class="fw-bold mb-1" style="color: #2D3436;">
        <i class="fa-solid fa-box-open me-2" style="color: #10AC84;"></i> دليل المنتجات والمواد
      </h3>
      <p class="text-muted mb-0">كتالوج المواد والمنتجات ووحدات القياس المرجعية</p>
    </div>
    <div class="d-flex gap-2">
      <% if (typeof canCreateProduct !== 'undefined' && canCreateProduct) { %>
        <a href="/inventory/products/create" class="btn btn-primary rounded-pill px-4 fw-bold" style="background-color: #10AC84; border-color: #10AC84;">
          <i class="fa-solid fa-plus me-1"></i> إضافة منتج جديد
        </a>
      <% } %>
    </div>
  </div>

  <!-- Filter & Search Card -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
      <div class="row g-2 align-items-center">
        <!-- Search Input -->
        <div class="col-12 col-md-5">
          <div class="input-group">
            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-search text-muted"></i></span>
            <input type="text" id="productSearchInput" class="form-control bg-light border-0" placeholder="بحث بالاسم، الرمز، الباركود، مكان الوجود...">
          </div>
        </div>

        <!-- Category Filter -->
        <div class="col-12 col-sm-6 col-md-3">
          <select id="categoryFilterSelect" class="form-select bg-light border-0">
            <option value="">-- جميع الفئات --</option>
          </select>
        </div>

        <!-- Status Filter -->
        <div class="col-12 col-sm-6 col-md-2">
          <select id="statusFilterSelect" class="form-select bg-light border-0">
            <option value="all">جميع الحالات</option>
            <option value="active" selected>نشط فقط</option>
            <option value="inactive">معطل فقط</option>
          </select>
        </div>

        <!-- Refresh Button -->
        <div class="col-12 col-md-2 d-flex justify-content-end">
          <button type="button" id="btnRefreshProducts" class="btn btn-outline-secondary rounded-pill px-3 w-100">
            <i class="fa-solid fa-rotate me-1"></i> تحديث
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Alert Container -->
  <div id="productAlertContainer"></div>

  <!-- Products Table Card -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0 text-dark">
        <i class="fa-solid fa-list me-2 text-muted"></i> قائمة المنتجات
      </h6>
      <span class="badge bg-light text-muted border" id="productsCountBadge">0 منتج</span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light text-muted" style="font-size: 0.9rem;">
            <tr>
              <th class="ps-4">اسم المنتج</th>
              <th>الرمز</th>
              <th>الفئة</th>
              <th>الوحدة الأساسية</th>
              <th>عدد الوحدات</th>
              <th>مكان وجود المادة</th>
              <th>الحالة</th>
              <th class="text-end pe-4">الإجراءات</th>
            </tr>
          </thead>
          <tbody id="productsTableBody">
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
                جاري تحميل المنتجات...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination Footer -->
    <div class="card-footer bg-white border-top py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div class="text-muted small" id="paginationInfo">عرض 0 من 0</div>
      <nav aria-label="Products Pagination">
        <ul class="pagination pagination-sm mb-0 justify-content-end" id="productsPagination"></ul>
      </nav>
    </div>
  </div>
</div>

<script>
  window.INVENTORY_PERMISSIONS = {
    canCreateProduct: <%= typeof canCreateProduct !== 'undefined' && canCreateProduct ? 'true' : 'false' %>,
    canUpdateProduct: <%= typeof canUpdateProduct !== 'undefined' && canUpdateProduct ? 'true' : 'false' %>,
    canDeleteProduct: <%= typeof canDeleteProduct !== 'undefined' && canDeleteProduct ? 'true' : 'false' %>
  };
</script>
<script src="/js/inventory-products.js"></script>
