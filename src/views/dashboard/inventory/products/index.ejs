<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1" style="color: #1F2937;">دليل المنتجات والمواد <i class="fa-solid fa-box-open text-muted fs-5 ms-2"></i></h3>
    <p class="text-muted mb-0 small">كتالوج المواد والمنتجات ووحدات القياس المرجعية</p>
  </div>
  <% if (typeof canCreateProduct !== 'undefined' && canCreateProduct) { %>
    <div>
      <a href="/inventory/products/create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm px-4 py-2" style="background-color: #10AC84; border-color: #10AC84;">
        <i class="fa-solid fa-plus"></i>
        <span>إضافة منتج جديد</span>
      </a>
    </div>
  <% } %>
</div>

<!-- Alert Container -->
<div id="productAlertContainer"></div>

<!-- Main Products Layout: Category Tree Panel + Products Table Area -->
<div class="row g-4">
  <!-- Desktop Category Tree Panel (Right Column in RTL) -->
  <div class="col-lg-3 d-none d-lg-block">
    <div class="card border-0 shadow-sm category-tree-panel" style="border-radius: 12px;">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-sitemap me-2" style="color: #10AC84;"></i> شجرة الفئات
        </h6>
        <span class="badge bg-light text-muted border" id="categoryTreeCountBadge">0</span>
      </div>
      <div class="p-2 border-bottom bg-light">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-search"></i></span>
          <input type="text" id="treeSearchInput" class="form-control border-start-0 ps-0" placeholder="بحث في الفئات...">
        </div>
      </div>
      <div class="card-body p-2">
        <ul class="category-tree-list" id="categoryTreeListDesktop">
          <li class="category-tree-node-item active" data-category-id="">
            <div class="category-tree-node-title">
              <i class="fa-solid fa-boxes-stacked me-1"></i>
              <span>جميع المنتجات</span>
            </div>
          </li>
          <li class="text-center py-4 text-muted small" id="treeLoadingDesktop">
            <span class="spinner-border spinner-border-sm me-1"></span> جاري تحميل الفئات...
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Main Products Column -->
  <div class="col-12 col-lg-9">
    <!-- Active Category Banner & Mobile Tree Trigger -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
      <!-- Mobile Offcanvas Trigger Button -->
      <button type="button" class="btn btn-outline-secondary d-lg-none d-inline-flex align-items-center gap-2" data-bs-toggle="offcanvas" data-bs-target="#categoryTreeOffcanvas">
        <i class="fa-solid fa-sitemap" style="color: #10AC84;"></i>
        <span>تصفية بالفئات</span>
        <span class="badge bg-light text-dark border ms-1" id="mobileSelectedCategoryPill">الكل</span>
      </button>

      <!-- Active Category Indicator Badge -->
      <div id="activeCategoryBanner" class="d-none">
        <div class="active-category-pill shadow-sm">
          <i class="fa-solid fa-filter small"></i>
          <span>الفئة: <strong id="activeCategoryName">--</strong></span>
          <button type="button" class="btn-clear-cat ms-2" id="btnClearActiveCategory" title="إلغاء التصفية">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
      <div class="card-body p-3">
        <div class="row g-2 align-items-center">
          <!-- Text Search -->
          <div class="col-12 col-md-7 col-xl-8">
            <div class="input-group">
              <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
              <input type="text" id="productSearchInput" class="form-control border-start-0 ps-0" placeholder="بحث بالاسم، الرمز، الباركود، مكان الوجود...">
            </div>
          </div>

          <!-- Status Filter -->
          <div class="col-12 col-sm-6 col-md-3 col-xl-2">
            <select id="statusFilterSelect" class="form-select">
              <option value="all">جميع الحالات</option>
              <option value="active" selected>نشط فقط</option>
              <option value="inactive">معطل فقط</option>
            </select>
          </div>

          <!-- Refresh Button -->
          <div class="col-12 col-sm-6 col-md-2 col-xl-2">
            <button type="button" id="btnRefreshProducts" class="btn btn-outline-secondary w-100">
              <i class="fa-solid fa-rotate me-1"></i> تحديث
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Products Table Card -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr class="text-muted small">
              <th scope="col" class="py-3 px-4">اسم المنتج</th>
              <th scope="col" class="py-3">الرمز</th>
              <th scope="col" class="py-3">الفئة</th>
              <th scope="col" class="py-3">الوحدة الأساسية</th>
              <th scope="col" class="py-3 text-center">عدد الوحدات</th>
              <th scope="col" class="py-3">مكان وجود المادة</th>
              <th scope="col" class="py-3 text-center">الحالة</th>
              <th scope="col" class="py-3 text-center px-4">الإجراءات</th>
            </tr>
          </thead>
          <tbody id="productsTableBody">
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                جاري تحميل المنتجات...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      <div class="card-footer bg-white border-top d-flex flex-wrap justify-content-between align-items-center py-3 px-4">
        <div class="text-muted small" id="paginationInfo">عرض 0 من 0</div>
        <nav aria-label="Products Pagination">
          <ul class="pagination pagination-sm mb-0 justify-content-end" id="productsPagination"></ul>
        </nav>
      </div>
    </div>
  </div>
</div>

<!-- Mobile Offcanvas Category Tree -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="categoryTreeOffcanvas" aria-labelledby="categoryTreeOffcanvasLabel">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title fw-bold" id="categoryTreeOffcanvasLabel">
      <i class="fa-solid fa-sitemap me-2" style="color: #10AC84;"></i> تصفية بفئات المنتجات
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="p-3 border-bottom bg-light">
    <div class="input-group">
      <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-search"></i></span>
      <input type="text" id="treeSearchInputMobile" class="form-control border-start-0 ps-0" placeholder="بحث في الفئات...">
    </div>
  </div>
  <div class="offcanvas-body p-2">
    <ul class="category-tree-list" id="categoryTreeListMobile">
      <li class="category-tree-node-item active" data-category-id="">
        <div class="category-tree-node-title">
          <i class="fa-solid fa-boxes-stacked me-1"></i>
          <span>جميع المنتجات</span>
        </div>
      </li>
      <li class="text-center py-4 text-muted small" id="treeLoadingMobile">
        <span class="spinner-border spinner-border-sm me-1"></span> جاري تحميل الفئات...
      </li>
    </ul>
  </div>
</div>

<script>
  window.INVENTORY_PERMISSIONS = {
    canCreateProduct: <%= typeof canCreateProduct !== 'undefined' && canCreateProduct ? 'true' : 'false' %>,
    canUpdateProduct: <%= typeof canUpdateProduct !== 'undefined' && canUpdateProduct ? 'true' : 'false' %>,
    canDeleteProduct: <%= typeof canDeleteProduct !== 'undefined' && canDeleteProduct ? 'true' : 'false' %>
  };
</script>
<script src="/js/inventory-products.js"></script>
