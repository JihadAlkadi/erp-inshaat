<!-- Page Header (Matching System UI Standard) -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1" style="color: #1F2937;">
      دليل المنتجات والمواد <i class="fa-solid fa-box-open text-muted fs-5 ms-2"></i>
    </h3>
    <p class="text-muted mb-0 small">كتالوج المواد والمنتجات ووحدات القياس المرجعية والأسعار</p>
  </div>
  <% if (typeof canCreateProduct !== 'undefined' && canCreateProduct) { %>
    <div>
      <a href="/inventory/products/create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm px-4 py-2" style="background-color: #10AC84; border-color: #10AC84; border-radius: 8px;">
        <i class="fa-solid fa-plus"></i>
        <span>إضافة منتج جديد</span>
      </a>
    </div>
  <% } %>
</div>

<!-- Filter & Search Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-3">
    <div class="row g-2 align-items-center">
      <!-- Search Input -->
      <div class="col-12 col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
          <input type="text" id="productSearchInput" class="form-control border-start-0 ps-0" placeholder="بحث بالاسم، الرمز، الباركود، مكان الوجود...">
        </div>
      </div>

      <!-- Category Filter -->
      <div class="col-12 col-sm-6 col-md-3">
        <select id="categoryFilterSelect" class="form-select bg-light border-0">
          <option value="">-- جميع الفئات --</option>
        </select>
      </div>

      <!-- Status Filter -->
      <div class="col-12 col-sm-6 col-md-2">
        <select id="statusFilterSelect" class="form-select bg-light border-0">
          <option value="all">جميع الحالات</option>
          <option value="active" selected>نشط فقط</option>
          <option value="inactive">معطل فقط</option>
        </select>
      </div>

      <!-- Refresh Button -->
      <div class="col-12 col-md-2 d-flex justify-content-end">
        <button type="button" id="btnRefreshProducts" class="btn btn-outline-secondary w-100 d-inline-flex justify-content-center align-items-center gap-2" style="border-radius: 8px;">
          <i class="fa-solid fa-rotate"></i>
          <span>تحديث</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Alert Container -->
<div id="productAlertContainer"></div>

<!-- Products Table Card -->
<div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
  <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
    <h6 class="fw-bold mb-0 text-dark">
      <i class="fa-solid fa-list me-2 text-muted"></i> قائمة المنتجات والمواد
    </h6>
    <span class="badge bg-secondary-subtle text-secondary-emphasis px-3 py-2 rounded-pill" id="productsCountBadge">0 منتج</span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr class="text-muted small">
            <th scope="col" class="py-3 px-4">اسم المنتج</th>
            <th scope="col" class="py-3">الرمز</th>
            <th scope="col" class="py-3">الفئة</th>
            <th scope="col" class="py-3">الوحدة الأساسية</th>
            <th scope="col" class="py-3 text-center">عدد الوحدات</th>
            <th scope="col" class="py-3">مكان وجود المادة</th>
            <th scope="col" class="py-3 text-center">الحالة</th>
            <th scope="col" class="py-3 text-end px-4">الإجراءات</th>
          </tr>
        </thead>
        <tbody id="productsTableBody">
          <tr>
            <td colspan="8" class="text-center py-5 text-muted">
              <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
              جاري تحميل المنتجات...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination Footer -->
  <div class="card-footer bg-white border-top py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="text-muted small" id="paginationInfo">عرض 0 من 0</div>
    <nav aria-label="Products Pagination">
      <ul class="pagination pagination-sm mb-0 justify-content-end" id="productsPagination"></ul>
    </nav>
  </div>
</div>

<script>
  window.INVENTORY_PERMISSIONS = {
    canCreateProduct: <%= typeof canCreateProduct !== 'undefined' && canCreateProduct ? 'true' : 'false' %>,
    canUpdateProduct: <%= typeof canUpdateProduct !== 'undefined' && canUpdateProduct ? 'true' : 'false' %>,
    canDeleteProduct: <%= typeof canDeleteProduct !== 'undefined' && canDeleteProduct ? 'true' : 'false' %>
  };
</script>
<script src="/js/inventory-products.js"></script>
