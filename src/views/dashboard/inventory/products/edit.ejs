<div class="container-fluid">
  <!-- Breadcrumb & Header -->
  <div class="mb-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/inventory" class="text-decoration-none">المستودعات</a></li>
        <li class="breadcrumb-item"><a href="/inventory/products" class="text-decoration-none">المنتجات</a></li>
        <li class="breadcrumb-item active" aria-current="page">تعديل المنتج</li>
      </ol>
    </nav>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <h3 class="fw-bold mb-1" style="color: #2D3436;" id="productHeaderTitle">
          <i class="fa-solid fa-box-open me-2" style="color: #10AC84;"></i> تعديل المنتج
        </h3>
        <p class="text-muted mb-0" id="productHeaderSubtitle">جاري تحميل بيانات المنتج...</p>
      </div>
      <div class="d-flex gap-2">
        <span class="badge bg-light text-dark border align-self-center py-2 px-3" id="productCodeBadge"></span>
      </div>
    </div>
  </div>

  <!-- Alert Container -->
  <div id="productFormAlertContainer"></div>

  <!-- Nav Tabs -->
  <ul class="nav nav-tabs mb-4" id="productEditTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active fw-bold" id="product-info-tab" data-bs-toggle="tab" data-bs-target="#product-info-pane" type="button" role="tab">
        <i class="fa-solid fa-cube me-1"></i> بيانات المنتج
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link fw-bold" id="units-tab" data-bs-toggle="tab" data-bs-target="#units-pane" type="button" role="tab">
        <i class="fa-solid fa-scale-balanced me-1"></i> وحدات القياس
        <span class="badge rounded-pill bg-success ms-1" id="unitsCountPill">0</span>
      </button>
    </li>
  </ul>

  <!-- Tab Content -->
  <div class="tab-content" id="productEditTabsContent" data-product-id="<%= typeof productId !== 'undefined' ? productId : '' %>">
    
    <!-- Tab 1: Product Info -->
    <div class="tab-pane fade show active" id="product-info-pane" role="tabpanel">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
          <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom py-3">
              <h6 class="fw-bold mb-0 text-dark">البيانات العامة</h6>
            </div>
            <div class="card-body p-4">
              <form id="editProductForm" novalidate>
                <!-- Code (Read-Only) -->
                <div class="mb-3">
                  <label for="editProductCode" class="form-label fw-bold text-muted">رمز المنتج (ثابت)</label>
                  <input type="text" class="form-control bg-light" id="editProductCode" readonly disabled>
                  <div class="form-text">رمز المنتج فريد وثابت في النظام ولا يمكن تعديله.</div>
                </div>

                <!-- Name -->
                <div class="mb-3">
                  <label for="editProductName" class="form-label fw-bold">اسم المنتج <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="editProductName" name="name" required maxlength="150">
                </div>

                <!-- Category -->
                <div class="mb-3">
                  <label for="editProductCategoryId" class="form-label fw-bold">فئة المنتج</label>
                  <select class="form-select" id="editProductCategoryId" name="categoryId">
                    <option value="">-- بدون فئة (غير مصنف) --</option>
                  </select>
                </div>

                <!-- Location Name -->
                <div class="mb-3">
                  <label for="editProductLocationName" class="form-label fw-bold">مكان وجود المادة (اختياري)</label>
                  <input type="text" class="form-control" id="editProductLocationName" name="locationName" maxlength="255">
                  <div class="form-text">نص إرشادي لمكان التخزين (بدون أرصدة أو حركات مخزنية).</div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                  <label for="editProductDescription" class="form-label fw-bold">الوصف</label>
                  <textarea class="form-control" id="editProductDescription" name="description" rows="3"></textarea>
                </div>

                <!-- Is Active -->
                <div class="mb-4">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="editProductIsActive" name="isActive">
                    <label class="form-check-label fw-bold" for="editProductIsActive">منتج نشط</label>
                  </div>
                </div>

                <!-- Actions -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                  <div>
                    <% if (typeof canDeleteProduct !== 'undefined' && canDeleteProduct) { %>
                      <button type="button" class="btn btn-outline-danger rounded-pill px-3" id="btnArchiveProduct">
                        <i class="fa-solid fa-box-archive me-1"></i> أرشفة المنتج
                      </button>
                    <% } %>
                  </div>
                  <div class="d-flex gap-2">
                    <a href="/inventory/products" class="btn btn-outline-secondary rounded-pill px-4">رجوع للقائمة</a>
                    <button type="submit" id="btnSaveProduct" class="btn btn-primary rounded-pill px-4 fw-bold" style="background-color: #10AC84; border-color: #10AC84;">
                      <span class="spinner-border spinner-border-sm d-none me-1" id="saveProductSpinner" role="status"></span>
                      حفظ التعديلات
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 2: Units Management -->
    <div class="tab-pane fade" id="units-pane" role="tabpanel">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-list-check me-2 text-muted"></i> وحدات القياس ومعاملات التحويل
            </h6>
            <small class="text-muted">الوحدة الأساسية هي مرجع القياس، والوحدات الإضافية ترتبط بها بشكل مباشر أو تسلسلي.</small>
          </div>
          <div>
            <% if (typeof canUpdateProduct !== 'undefined' && canUpdateProduct) { %>
              <button type="button" class="btn btn-primary rounded-pill px-3 fw-bold" id="btnOpenAddUnitModal" style="background-color: #10AC84; border-color: #10AC84;">
                <i class="fa-solid fa-plus me-1"></i> إضافة وحدة جديدة
              </button>
            <% } %>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light text-muted" style="font-size: 0.9rem;">
                <tr>
                  <th class="ps-4">اسم الوحدة</th>
                  <th>نوع الوحدة</th>
                  <th>معادلة التعادل والتحويل</th>
                  <th>السعر المرجعي</th>
                  <th>الباركود</th>
                  <th>المواصفات الفنية</th>
                  <th class="text-end pe-4">الإجراءات</th>
                </tr>
              </thead>
              <tbody id="productUnitsTableBody">
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
                    جاري تحميل الوحدات...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Add Non-Base Unit -->
<div class="modal fade" id="addUnitModal" tabindex="-1" aria-labelledby="addUnitModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-bottom py-3">
        <h5 class="modal-title fw-bold" id="addUnitModalLabel">
          <i class="fa-solid fa-plus-circle me-2 text-success"></i> إضافة وحدة قياس جديدة
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="addUnitForm" novalidate>
        <div class="modal-body p-4">
          <div id="addUnitAlertContainer"></div>

          <!-- Unit Name -->
          <div class="mb-3">
            <label for="newUnitName" class="form-label fw-bold">اسم الوحدة <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="newUnitName" name="name" required maxlength="100" placeholder="مثال: صندوق، كرتونة، لفة">
          </div>

          <!-- Conversion Formula -->
          <div class="card bg-light border-0 rounded-3 p-3 mb-3">
            <label class="form-label fw-bold text-dark mb-2">معامل ومعادلة التحويل <span class="text-danger">*</span></label>
            <div class="row g-2 align-items-center">
              <div class="col-auto">
                <span class="fw-bold">1 <span id="formulaNewUnitNamePreview" class="text-success">[الوحدة الجديدة]</span> =</span>
              </div>
              <div class="col-12 col-sm-4">
                <input type="number" step="0.000001" min="0.000001" class="form-control" id="newUnitConversionQuantity" name="conversionQuantity" required placeholder="مثال: 20">
              </div>
              <div class="col-auto">
                <span class="fw-bold">من</span>
              </div>
              <div class="col-12 col-sm-4">
                <select class="form-select" id="newUnitEquivalentToUnitId" name="equivalentToUnitId" required>
                  <option value="">-- اختر الوحدة المقابلة --</option>
                </select>
              </div>
            </div>
            <div class="form-text mt-2" id="formulaPreviewText">
              مثال: 1 صندوق = 20 قطعة (يجب أن تنتهي السلسلة بالوحدة الأساسية).
            </div>
          </div>

          <div class="row g-3 mb-3">
            <!-- Price -->
            <div class="col-12 col-sm-6">
              <label for="newUnitPrice" class="form-label fw-bold">السعر المرجعي <span class="text-danger">*</span></label>
              <input type="number" step="0.0001" min="0" class="form-control" id="newUnitPrice" name="price" required placeholder="0.00">
            </div>

            <!-- Barcode -->
            <div class="col-12 col-sm-6">
              <label for="newUnitBarcode" class="form-label fw-bold">الباركود (اختياري)</label>
              <input type="text" class="form-control" id="newUnitBarcode" name="barcode" maxlength="100" placeholder="مثال: 628100099999">
            </div>
          </div>

          <!-- Specifications Dynamic Section -->
          <div class="pt-3 border-top mt-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <label class="form-label fw-bold mb-0">المواصفات الفنية للوحدة (اختياري)</label>
              <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3" id="btnAddUnitSpec">
                <i class="fa-solid fa-plus me-1"></i> إضافة خاصية
              </button>
            </div>
            <div id="unitSpecsContainer" class="d-flex flex-column gap-2"></div>
          </div>
        </div>
        <div class="modal-footer border-top py-3">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
          <button type="submit" id="btnSubmitAddUnit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background-color: #10AC84; border-color: #10AC84;">
            <span class="spinner-border spinner-border-sm d-none me-1" id="addUnitSpinner" role="status"></span>
            إضافة الوحدة
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Edit Unit -->
<div class="modal fade" id="editUnitModal" tabindex="-1" aria-labelledby="editUnitModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-bottom py-3">
        <h5 class="modal-title fw-bold" id="editUnitModalLabel">
          <i class="fa-solid fa-pen-to-square me-2 text-success"></i> تعديل بيانات الوحدة
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editUnitForm" novalidate>
        <input type="hidden" id="editUnitId" name="unitId">
        <div class="modal-body p-4">
          <div id="editUnitAlertContainer"></div>

          <!-- Base Unit Banner (if base) -->
          <div id="editBaseUnitAlert" class="alert alert-info rounded-3 py-2 px-3 d-none mb-3">
            <i class="fa-solid fa-circle-info me-1"></i> هذه هي <strong>الوحدة الأساسية</strong> للمنتج، ومعادلة التحويل الخاصة بها ثابتة ولا يمكن تعديلها.
          </div>

          <!-- Unit Name -->
          <div class="mb-3">
            <label for="editUnitName" class="form-label fw-bold">اسم الوحدة <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="editUnitName" name="name" required maxlength="100">
          </div>

          <!-- Conversion Formula Section (Hidden for base unit) -->
          <div id="editConversionFormulaSection" class="card bg-light border-0 rounded-3 p-3 mb-3">
            <label class="form-label fw-bold text-dark mb-2">معامل ومعادلة التحويل <span class="text-danger">*</span></label>
            <div class="row g-2 align-items-center">
              <div class="col-auto">
                <span class="fw-bold">1 <span id="editFormulaUnitNamePreview" class="text-success">[الوحدة]</span> =</span>
              </div>
              <div class="col-12 col-sm-4">
                <input type="number" step="0.000001" min="0.000001" class="form-control" id="editUnitConversionQuantity" name="conversionQuantity">
              </div>
              <div class="col-auto">
                <span class="fw-bold">من</span>
              </div>
              <div class="col-12 col-sm-4">
                <select class="form-select" id="editUnitEquivalentToUnitId" name="equivalentToUnitId">
                  <option value="">-- اختر الوحدة المقابلة --</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <!-- Price -->
            <div class="col-12 col-sm-6">
              <label for="editUnitPrice" class="form-label fw-bold">السعر المرجعي <span class="text-danger">*</span></label>
              <input type="number" step="0.0001" min="0" class="form-control" id="editUnitPrice" name="price" required>
            </div>

            <!-- Barcode -->
            <div class="col-12 col-sm-6">
              <label for="editUnitBarcode" class="form-label fw-bold">الباركود (اختياري)</label>
              <input type="text" class="form-control" id="editUnitBarcode" name="barcode" maxlength="100">
            </div>
          </div>

          <!-- Specifications Dynamic Section -->
          <div class="pt-3 border-top mt-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <label class="form-label fw-bold mb-0">المواصفات الفنية للوحدة</label>
              <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3" id="btnAddEditUnitSpec">
                <i class="fa-solid fa-plus me-1"></i> إضافة خاصية
              </button>
            </div>
            <div id="editUnitSpecsContainer" class="d-flex flex-column gap-2"></div>
          </div>
        </div>
        <div class="modal-footer border-top py-3">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
          <button type="submit" id="btnSubmitEditUnit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background-color: #10AC84; border-color: #10AC84;">
            <span class="spinner-border spinner-border-sm d-none me-1" id="editUnitSpinner" role="status"></span>
            حفظ التعديلات
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  window.INVENTORY_PERMISSIONS = {
    canCreateProduct: <%= typeof canCreateProduct !== 'undefined' && canCreateProduct ? 'true' : 'false' %>,
    canUpdateProduct: <%= typeof canUpdateProduct !== 'undefined' && canUpdateProduct ? 'true' : 'false' %>,
    canDeleteProduct: <%= typeof canDeleteProduct !== 'undefined' && canDeleteProduct ? 'true' : 'false' %>
  };
</script>
<script src="/js/inventory-products.js"></script>
