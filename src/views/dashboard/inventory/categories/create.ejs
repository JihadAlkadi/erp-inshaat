<div class="container-fluid">
  <!-- Breadcrumb & Header -->
  <div class="mb-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/inventory" class="text-decoration-none">المستودعات</a></li>
        <li class="breadcrumb-item"><a href="/inventory/categories" class="text-decoration-none">الفئات</a></li>
        <li class="breadcrumb-item active" aria-current="page">إضافة فئة جديدة</li>
      </ol>
    </nav>
    <h3 class="fw-bold" style="color: #2D3436;">
      <i class="fa-solid fa-folder-plus me-2" style="color: #10AC84;"></i> إضافة فئة منتجات جديدة
    </h3>
  </div>

  <!-- Alert Container -->
  <div id="categoryFormAlertContainer"></div>

  <!-- Form Card -->
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-bottom py-3">
          <h6 class="fw-bold mb-0 text-dark">بيانات الفئة</h6>
        </div>
        <div class="card-body p-4">
          <form id="createCategoryForm" novalidate>
            <!-- Name -->
            <div class="mb-3">
              <label for="categoryName" class="form-label fw-bold">اسم الفئة <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="categoryName" name="name" required maxlength="100" placeholder="مثال: أدوات كهربائية">
              <div class="form-text">الاسم المعبر عن الفئة والمستخدم في التصفح والتقارير.</div>
            </div>

            <!-- Code -->
            <div class="mb-3">
              <label for="categoryCode" class="form-label fw-bold">رمز الفئة (الكود) <span class="text-danger">*</span></label>
              <input type="text" class="form-control text-uppercase" id="categoryCode" name="code" required maxlength="50" placeholder="مثال: ELEC-01">
              <div class="form-text">رمز فريد وثابت في النظام لا يمكن تعديله بعد الإنشاء.</div>
            </div>

            <!-- Parent Category -->
            <div class="mb-3">
              <label for="categoryParentId" class="form-label fw-bold">الفئة الأب (اختياري)</label>
              <select class="form-select" id="categoryParentId" name="parentId" data-initial-parent="<%= typeof parentId !== 'undefined' && parentId ? parentId : '' %>">
                <option value="">-- بدون فئة أب (فئة رئيسية) --</option>
              </select>
              <div class="form-text">حدد الفئة الأب لتصبح هذه الفئة فرعية ضمن الهيكل الهرمي.</div>
            </div>

            <!-- Description -->
            <div class="mb-3">
              <label for="categoryDescription" class="form-label fw-bold">الوصف (اختياري)</label>
              <textarea class="form-control" id="categoryDescription" name="description" rows="3" placeholder="وصف موجز لمحتويات وتصنيف الفئة..."></textarea>
            </div>

            <!-- Is Active -->
            <div class="mb-4">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="categoryIsActive" name="isActive" checked>
                <label class="form-check-label fw-bold" for="categoryIsActive">فئة نشطة</label>
              </div>
              <div class="form-text">الفئة النشطة تتيح ربط المنتجات بها وإنشاء فئات فرعية تحتها.</div>
            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
              <a href="/inventory/categories" class="btn btn-outline-secondary rounded-pill px-4">إلغاء</a>
              <button type="submit" id="btnSubmitCategory" class="btn btn-primary rounded-pill px-4 fw-bold" style="background-color: #10AC84; border-color: #10AC84;">
                <span class="spinner-border spinner-border-sm d-none me-1" id="submitSpinner" role="status"></span>
                حفظ الفئة
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/inventory-categories.js"></script>
