<div class="row justify-content-center">
  <div class="col-lg-8 col-xl-7">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1" style="color: #1F2937;">إضافة فئة جديدة <i class="fa-solid fa-folder-plus text-muted fs-5 ms-2"></i></h3>
        <p class="text-muted mb-0 small">إنشاء فئة منتجات جديدة وتحديد موقعها في الهيكل التصنيفي</p>
      </div>
      <a href="/inventory/categories" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left ms-1"></i> العودة للقائمة
      </a>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
      <div class="card-body p-4 p-md-5">
        <div id="categoryFormAlertContainer"></div>

        <form id="createCategoryForm" class="needs-validation" novalidate>
          <!-- Name -->
          <div class="mb-4">
            <label for="categoryName" class="form-label fw-bold text-dark">اسم الفئة <span class="text-danger">*</span></label>
            <div class="input-group has-validation">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-folder"></i></span>
              <input type="text" class="form-control" id="categoryName" name="name" required maxlength="100" placeholder="مثال: مواد البناء">
              <div class="invalid-feedback">يرجى إدخال اسم الفئة (حتى 100 محرف)</div>
            </div>
            <div class="form-text text-muted">الاسم المعبر عن الفئة والمستخدم في التصفح والتقارير.</div>
          </div>

          <!-- Code -->
          <div class="mb-4">
            <label for="categoryCode" class="form-label fw-bold text-dark">رمز الفئة (الكود) <span class="text-danger">*</span></label>
            <div class="input-group has-validation">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-tag"></i></span>
              <input type="text" class="form-control text-uppercase" id="categoryCode" name="code" required maxlength="50" placeholder="مثال: MAT-01">
              <div class="invalid-feedback">يرجى إدخال رمز الفئة الفريد</div>
            </div>
            <div class="form-text text-muted">رمز فريد وثابت في النظام لا يمكن تعديله بعد الإنشاء.</div>
          </div>

          <!-- Parent Category -->
          <div class="mb-4">
            <label for="categoryParentId" class="form-label fw-bold text-dark">الفئة الأب (اختياري)</label>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-sitemap"></i></span>
              <select class="form-select" id="categoryParentId" name="parentId" data-initial-parent="<%= typeof parentId !== 'undefined' && parentId ? parentId : '' %>">
                <option value="">-- بدون فئة أب (فئة رئيسية) --</option>
              </select>
            </div>
            <div class="form-text text-muted">حدد الفئة الأب لتصبح هذه الفئة فرعية ضمن الهيكل الهرمي.</div>
          </div>

          <!-- Description -->
          <div class="mb-4">
            <label for="categoryDescription" class="form-label fw-bold text-dark">الوصف (اختياري)</label>
            <textarea class="form-control" id="categoryDescription" name="description" rows="3" placeholder="وصف موجز لمحتويات وتصنيف الفئة..."></textarea>
          </div>

          <!-- Is Active -->
          <div class="mb-4">
            <div class="form-check form-switch fs-6">
              <input class="form-check-input" type="checkbox" role="switch" id="categoryIsActive" name="isActive" checked>
              <label class="form-check-label fw-bold text-dark" for="categoryIsActive">فئة نشطة (يمكن ربط المنتجات بها)</label>
            </div>
          </div>

          <hr class="my-4 text-muted">

          <!-- Submit Buttons -->
          <div class="d-flex justify-content-end gap-2">
            <a href="/inventory/categories" class="btn btn-light px-4">إلغاء</a>
            <button type="submit" id="btnSubmitCategory" class="btn btn-primary btn-module-primary px-5 d-inline-flex align-items-center gap-2">
              <span class="spinner-border spinner-border-sm d-none" id="submitSpinner" role="status" aria-hidden="true"></span>
              <i class="fa-solid fa-check" id="btnIcon"></i>
              <span id="btnText">حفظ الفئة</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/inventory-categories.js"></script>

