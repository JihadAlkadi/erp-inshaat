<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1" style="color: #1F2937;">إدارة الفئات <i class="fa-solid fa-folder-tree text-muted fs-5 ms-2"></i></h3>
    <p class="text-muted mb-0 small">إدارة فئات المنتجات وتنظيم الهيكل التصنيفي</p>
  </div>
  <% if (typeof canCreateCategory !== 'undefined' && canCreateCategory) { %>
    <div>
      <a href="/inventory/categories/create" class="btn btn-primary btn-module-primary d-inline-flex align-items-center gap-2 shadow-sm px-4 py-2">
        <i class="fa-solid fa-plus"></i>
        <span>إضافة فئة</span>
      </a>
    </div>
  <% } %>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-3">
    <form id="categorySearchForm" class="row g-2 align-items-center">
      <div class="col-md-5 col-lg-4">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
          <input type="text" id="categorySearchInput" class="form-control border-start-0 ps-0" placeholder="بحث باسم الفئة أو الرمز...">
        </div>
      </div>
      <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-outline-secondary px-3">بحث</button>
        <button type="button" id="btnClearSearch" class="btn btn-link text-muted text-decoration-none d-none">إلغاء البحث</button>
      </div>
    </form>
  </div>
</div>

<!-- Alert Container -->
<div id="categoryAlertContainer"></div>

<!-- Categories Table Card -->
<div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr class="text-muted small">
          <th scope="col" class="py-3 px-4">اسم الفئة</th>
          <th scope="col" class="py-3">الرمز</th>
          <th scope="col" class="py-3">الفئة الأب</th>
          <th scope="col" class="py-3 text-center">عدد المنتجات</th>
          <th scope="col" class="py-3 text-center">عدد الفئات الفرعية</th>
          <th scope="col" class="py-3 text-center">الحالة</th>
          <th scope="col" class="py-3 text-center px-4">الإجراءات</th>
        </tr>
      </thead>
      <tbody id="categoriesTableBody">
        <tr>
          <td colspan="7" class="text-center py-5 text-muted">
            <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
            جاري تحميل الفئات...
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Pagination Footer -->
  <div class="card-footer bg-white border-top d-flex flex-wrap justify-content-between align-items-center py-3 px-4" id="categoriesPaginationFooter">
    <div class="text-muted small" id="categoriesPaginationInfo">
      جاري التحميل...
    </div>
    <nav aria-label="Categories Pagination">
      <ul class="pagination pagination-sm mb-0" id="categoriesPagination"></ul>
    </nav>
  </div>
</div>

<script>
  window.INVENTORY_PERMISSIONS = {
    canCreateCategory: <%= typeof canCreateCategory !== 'undefined' && canCreateCategory ? 'true' : 'false' %>,
    canUpdateCategory: <%= typeof canUpdateCategory !== 'undefined' && canUpdateCategory ? 'true' : 'false' %>,
    canDeleteCategory: <%= typeof canDeleteCategory !== 'undefined' && canDeleteCategory ? 'true' : 'false' %>
  };
</script>
<script src="/js/inventory-categories.js"></script>

