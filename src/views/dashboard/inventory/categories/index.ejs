<!-- Page Header (Matching System UI Standard) -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1" style="color: #1F2937;">
      شجرة فئات المستودعات <i class="fa-solid fa-folder-tree text-muted fs-5 ms-2"></i>
    </h3>
    <p class="text-muted mb-0 small">إدارة وتصفح فئات المواد والمنتجات في هيكل هرمي متكامل</p>
  </div>
  <% if (typeof canCreateCategory !== 'undefined' && canCreateCategory) { %>
    <div>
      <a href="/inventory/categories/create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm px-4 py-2" style="background-color: #10AC84; border-color: #10AC84; border-radius: 8px;">
        <i class="fa-solid fa-folder-plus"></i>
        <span>إضافة فئة رئيسية</span>
      </a>
    </div>
  <% } %>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-3">
    <div class="row g-2 align-items-center">
      <div class="col-12 col-md-6 col-lg-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
          <input type="text" id="categorySearchInput" class="form-control border-start-0 ps-0" placeholder="بحث بالاسم أو الرمز...">
        </div>
      </div>
      <div class="col-12 col-md-auto ms-md-auto d-flex gap-2">
        <button type="button" id="btnRefreshTree" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
          <i class="fa-solid fa-rotate"></i>
          <span>تحديث الشجرة</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Alert Container -->
<div id="categoryAlertContainer"></div>

<!-- Tree Container -->
<div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
  <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
    <h6 class="fw-bold mb-0 text-dark">
      <i class="fa-solid fa-sitemap me-2 text-muted"></i> الهيكل الهرمي للفئات
    </h6>
    <span class="badge bg-secondary-subtle text-secondary-emphasis px-3 py-2 rounded-pill" id="treeStatusBadge">جاري التحميل...</span>
  </div>
  <div class="card-body p-3 p-md-4">
    <!-- Search Results Area (Hidden by default) -->
    <div id="searchResultsArea" class="d-none mb-4">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="fw-bold text-muted mb-0">نتائج البحث:</h6>
        <button type="button" id="btnClearSearch" class="btn btn-sm btn-link text-decoration-none">إلغاء البحث والعودة للشجرة</button>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr class="text-muted small">
              <th scope="col" class="py-3 px-3">اسم الفئة</th>
              <th scope="col" class="py-3">الرمز</th>
              <th scope="col" class="py-3">الفئة الأب</th>
              <th scope="col" class="py-3 text-center">الحالة</th>
              <th scope="col" class="py-3 text-center">المنتجات</th>
              <th scope="col" class="py-3 text-end px-3">الإجراءات</th>
            </tr>
          </thead>
          <tbody id="searchResultsTableBody"></tbody>
        </table>
      </div>
    </div>

    <!-- Tree Nodes Container -->
    <div id="categoryTreeContainer" class="category-tree">
      <div class="text-center py-5 text-muted" id="treeLoadingSpinner">
        <div class="spinner-border text-success" role="status">
          <span class="visually-hidden">جاري التحميل...</span>
        </div>
        <p class="mt-2 mb-0">جاري تحميل شجرة الفئات...</p>
      </div>
    </div>
  </div>
</div>

<style>
.category-tree {
  font-family: inherit;
}
.tree-node-item {
  border-radius: 8px;
  padding: 10px 14px;
  margin-bottom: 6px;
  background-color: #ffffff;
  border: 1px solid #f1f2f6;
  transition: all 0.15s ease-in-out;
}
.tree-node-item:hover {
  background-color: #f8fafc;
  border-color: #e2e8f0;
}
.tree-toggle-btn {
  width: 26px;
  height: 26px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: #64748b;
  cursor: pointer;
  transition: transform 0.2s ease, background-color 0.2s;
}
.tree-toggle-btn:hover {
  background-color: #f1f5f9;
}
.tree-toggle-btn.expanded i {
  transform: rotate(-90deg);
}
.tree-children-container {
  margin-right: 28px;
  border-right: 2px dashed #cbd5e1;
  padding-right: 14px;
  margin-top: 4px;
  margin-bottom: 4px;
}
</style>

<script>
  window.INVENTORY_PERMISSIONS = {
    canCreateCategory: <%= typeof canCreateCategory !== 'undefined' && canCreateCategory ? 'true' : 'false' %>,
    canUpdateCategory: <%= typeof canUpdateCategory !== 'undefined' && canUpdateCategory ? 'true' : 'false' %>,
    canDeleteCategory: <%= typeof canDeleteCategory !== 'undefined' && canDeleteCategory ? 'true' : 'false' %>
  };
</script>
<script src="/js/inventory-categories.js"></script>
