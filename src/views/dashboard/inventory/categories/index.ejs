<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1" style="color: #1F2937;">إدارة الفئات <i class="fa-solid fa-tags text-muted fs-5 ms-2"></i></h3>
    <p class="text-muted mb-0 small">إدارة فئات المنتجات وتنظيم التصنيف</p>
  </div>
  <% if (typeof canCreateCategory !== 'undefined' && canCreateCategory) { %>
    <div>
      <a href="/inventory/categories/create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm px-4 py-2" style="background-color: #10AC84; border-color: #10AC84;">
        <i class="fa-solid fa-plus"></i>
        <span>إضافة فئة</span>
      </a>
    </div>
  <% } %>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-3">
    <form method="GET" action="/inventory/categories" class="row g-2 align-items-center">
      <div class="col-md-5 col-lg-4">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
          <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="بحث باسم الفئة أو الرمز..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        </div>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary px-3">بحث</button>
        <% if (typeof search !== 'undefined' && search) { %>
          <a href="/inventory/categories" class="btn btn-link text-muted text-decoration-none">إلغاء البحث</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Alert Container -->
<div id="categoryAlertContainer"></div>

<!-- Categories Table Card -->
<div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr class="text-muted small">
          <th scope="col" class="py-3 px-4">اسم الفئة</th>
          <th scope="col" class="py-3">الرمز</th>
          <th scope="col" class="py-3">الفئة الأب</th>
          <th scope="col" class="py-3 text-center">عدد المنتجات</th>
          <th scope="col" class="py-3 text-center">عدد الفئات الفرعية</th>
          <th scope="col" class="py-3 text-center">الحالة</th>
          <th scope="col" class="py-3 text-center px-4">الإجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
          <% categories.forEach(function(cat) { %>
            <tr>
              <!-- Category Name -->
              <td class="py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                  <span class="d-inline-flex justify-content-center align-items-center rounded-circle" style="width: 34px; height: 34px; background-color: rgba(16, 172, 132, 0.1); color: #10AC84;">
                    <i class="fa-solid fa-folder"></i>
                  </span>
                  <div>
                    <span class="fw-bold text-dark"><%= cat.name %></span>
                    <% if (cat.description) { %>
                      <div class="text-muted small" style="font-size: 0.75rem;"><%= cat.description %></div>
                    <% } %>
                  </div>
                </div>
              </td>

              <!-- Code -->
              <td class="py-3">
                <span class="badge bg-light text-dark border font-monospace px-2 py-1"><%= cat.code %></span>
              </td>

              <!-- Parent Category -->
              <td class="py-3">
                <% if (cat.parentName) { %>
                  <span class="badge bg-secondary-subtle text-secondary-emphasis px-2 py-1 rounded-pill">
                    <i class="fa-solid fa-arrow-turn-up me-1 small"></i> <%= cat.parentName %>
                  </span>
                <% } else { %>
                  <span class="text-muted small">فئة رئيسية</span>
                <% } %>
              </td>

              <!-- Product Count -->
              <td class="py-3 text-center">
                <span class="badge bg-light text-muted border rounded-pill px-3 py-1">
                  <%= typeof cat.productCount === 'number' ? cat.productCount : 0 %>
                </span>
              </td>

              <!-- Children Count -->
              <td class="py-3 text-center">
                <span class="badge bg-light text-muted border rounded-pill px-3 py-1">
                  <%= typeof cat.childrenCount === 'number' ? cat.childrenCount : 0 %>
                </span>
              </td>

              <!-- Status -->
              <td class="py-3 text-center">
                <% if (cat.isActive) { %>
                  <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">
                    <i class="fa-solid fa-circle-check me-1"></i> نشط
                  </span>
                <% } else { %>
                  <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill">
                    <i class="fa-solid fa-circle-xmark me-1"></i> معطل
                  </span>
                <% } %>
              </td>

              <!-- Actions -->
              <td class="py-3 text-center px-4">
                <div class="d-inline-flex gap-1">
                  <% if (typeof canUpdateCategory !== 'undefined' && canUpdateCategory) { %>
                    <a href="/inventory/categories/<%= cat.id %>/edit" class="btn btn-sm btn-outline-primary" title="تعديل">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </a>

                    <% if (cat.isActive) { %>
                      <button type="button" class="btn btn-sm btn-outline-warning" title="تعطيل الفئة" data-action="toggle-category-status" data-category-id="<%= cat.id %>" data-category-name="<%= cat.name %>" data-new-status="false">
                        <i class="fa-solid fa-ban"></i>
                      </button>
                    <% } else { %>
                      <button type="button" class="btn btn-sm btn-outline-success" title="تفعيل الفئة" data-action="toggle-category-status" data-category-id="<%= cat.id %>" data-category-name="<%= cat.name %>" data-new-status="true">
                        <i class="fa-solid fa-check"></i>
                      </button>
                    <% } %>
                  <% } %>

                  <% if (typeof canDeleteCategory !== 'undefined' && canDeleteCategory) { %>
                    <button type="button" class="btn btn-sm btn-outline-danger" title="أرشفة الفئة" data-action="delete-category" data-category-id="<%= cat.id %>" data-category-name="<%= cat.name %>">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-5 text-muted">
              <div class="py-3">
                <i class="fa-solid fa-folder-open fs-1 text-secondary mb-3 d-block"></i>
                <p class="mb-0 fw-bold">لا توجد فئات متطابقة مع معايير البحث</p>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination Footer -->
  <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
    <div class="card-footer bg-white border-top d-flex flex-wrap justify-content-between align-items-center py-3 px-4">
      <div class="text-muted small">
        عرض الصفحة <strong><%= pagination.page %></strong> من إجمالي <strong><%= pagination.totalPages %></strong> صفحات (إجمالي الفئات: <%= pagination.total %>)
      </div>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/inventory/categories?page=<%= pagination.page - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">السابق</a>
          </li>
          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
              <a class="page-link" href="/inventory/categories?page=<%= p %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" style="<%= pagination.page === p ? 'background-color: #10AC84; border-color: #10AC84;' : '' %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/inventory/categories?page=<%= pagination.page + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">التالي</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>

<script src="/js/inventory-categories.js"></script>
