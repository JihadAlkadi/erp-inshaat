<div class="container-fluid">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <h3 class="fw-bold mb-1" style="color: #2D3436;">
        <i class="fa-solid fa-folder-tree me-2" style="color: #10AC84;"></i> شجرة فئات المستودعات
      </h3>
      <p class="text-muted mb-0">إدارة وتصفح فئات المواد والمنتجات في هيكل هرمي</p>
    </div>
    <div class="d-flex gap-2">
      <% if (typeof canCreateCategory !== 'undefined' && canCreateCategory) { %>
        <a href="/inventory/categories/create" class="btn btn-primary rounded-pill px-4 fw-bold" style="background-color: #10AC84; border-color: #10AC84;">
          <i class="fa-solid fa-plus me-1"></i> إضافة فئة رئيسية
        </a>
      <% } %>
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
      <div class="row g-2 align-items-center">
        <div class="col-12 col-md-6">
          <div class="input-group">
            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-search text-muted"></i></span>
            <input type="text" id="categorySearchInput" class="form-control bg-light border-0" placeholder="بحث بالاسم أو الرمز...">
          </div>
        </div>
        <div class="col-12 col-md-auto ms-auto d-flex gap-2">
          <button type="button" id="btnRefreshTree" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-rotate me-1"></i> تحديث الشجرة
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Alert Container -->
  <div id="categoryAlertContainer"></div>

  <!-- Tree Container -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0 text-dark">
        <i class="fa-solid fa-sitemap me-2 text-muted"></i> الهيكل الهرمي للفئات
      </h6>
      <span class="badge bg-light text-muted border" id="treeStatusBadge">جاري التحميل...</span>
    </div>
    <div class="card-body p-3 p-md-4">
      <!-- Search Results Area (Hidden by default) -->
      <div id="searchResultsArea" class="d-none mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h6 class="fw-bold text-muted mb-0">نتائج البحث:</h6>
          <button type="button" id="btnClearSearch" class="btn btn-sm btn-link text-decoration-none">إلغاء البحث والعودة للشجرة</button>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>اسم الفئة</th>
                <th>الرمز</th>
                <th>الفئة الأب</th>
                <th>الحالة</th>
                <th>المنتجات</th>
                <th class="text-end">الإجراءات</th>
              </tr>
            </thead>
            <tbody id="searchResultsTableBody"></tbody>
          </table>
        </div>
      </div>

      <!-- Tree Nodes Container -->
      <div id="categoryTreeContainer" class="category-tree">
        <div class="text-center py-5 text-muted" id="treeLoadingSpinner">
          <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
          </div>
          <p class="mt-2 mb-0">جاري تحميل شجرة الفئات...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.category-tree {
  font-family: inherit;
}
.tree-node-item {
  border-radius: 8px;
  padding: 8px 12px;
  margin-bottom: 4px;
  background-color: #ffffff;
  border: 1px solid #f1f2f6;
  transition: all 0.15s ease-in-out;
}
.tree-node-item:hover {
  background-color: #f8f9fa;
  border-color: #dfe4ea;
}
.tree-toggle-btn {
  width: 24px;
  height: 24px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  border: 1px solid #ced6e0;
  background: #ffffff;
  color: #747d8c;
  cursor: pointer;
  transition: transform 0.2s ease;
}
.tree-toggle-btn.expanded i {
  transform: rotate(90deg);
}
.tree-children-container {
  margin-right: 28px;
  border-right: 2px dashed #dfe4ea;
  padding-right: 12px;
  margin-top: 4px;
  margin-bottom: 4px;
}
</style>

<script>
  window.INVENTORY_PERMISSIONS = {
    canCreateCategory: <%= typeof canCreateCategory !== 'undefined' && canCreateCategory ? 'true' : 'false' %>,
    canUpdateCategory: <%= typeof canUpdateCategory !== 'undefined' && canUpdateCategory ? 'true' : 'false' %>,
    canDeleteCategory: <%= typeof canDeleteCategory !== 'undefined' && canDeleteCategory ? 'true' : 'false' %>
  };
</script>
<script src="/js/inventory-categories.js"></script>
