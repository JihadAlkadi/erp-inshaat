<!-- Sidebar: Offcanvas on mobile, static on desktop -->
<div class="offcanvas-md offcanvas-start module-sidebar shadow-sm" tabindex="-1" id="appSidebar">
  <div class="offcanvas-header d-md-none border-bottom pb-3 mb-2">
    <h5 class="offcanvas-title fw-bold" id="offcanvasNavbarLabel"><i class="fa-solid fa-boxes-stacked me-2"></i> كتالوج المنتجات</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar"></button>
  </div>
  
  <div class="offcanvas-body flex-column p-0 py-md-2">
    <div class="px-3 mb-2 mt-md-0 mt-2 text-muted" style="font-size: 0.85rem; font-weight: 700;">الكتالوج</div>
    <ul class="nav flex-column mb-3">
      <li class="nav-item">
        <a class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'categories' ? 'active' : '' %>" href="/inventory/categories">
          <i class="fa-solid fa-folder-tree"></i> الفئات
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'products' ? 'active' : '' %>" href="/inventory/products">
          <i class="fa-solid fa-boxes-stacked"></i> المنتجات
        </a>
      </li>
    </ul>
  </div>
</div>

