<!-- Sidebar: Offcanvas on mobile, static on desktop -->
<div class="offcanvas-md offcanvas-start inventory-sidebar shadow-sm" tabindex="-1" id="appSidebar">
  <div class="offcanvas-header d-md-none border-bottom pb-3 mb-2">
    <h5 class="offcanvas-title fw-bold" id="offcanvasNavbarLabel"><i class="fa-solid fa-boxes-stacked me-2"></i> إدارة المستودعات</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar"></button>
  </div>
  
  <div class="offcanvas-body flex-column p-0 py-md-2">
    <div class="px-3 mb-2 mt-md-0 mt-2 text-muted" style="font-size: 0.85rem; font-weight: 700;">الرئيسية</div>
    <ul class="nav flex-column mb-3">
      <li class="nav-item">
        <a class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'dashboard' ? 'active' : '' %>" href="/inventory">
          <i class="fa-solid fa-chart-line"></i> لوحة المستودعات
        </a>
      </li>
    </ul>

    <div class="px-3 mb-2 text-muted" style="font-size: 0.85rem; font-weight: 700;">كتالوج المنتجات والمواد</div>
    <ul class="nav flex-column mb-3">
      <li class="nav-item">
        <a class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'categories' ? 'active' : '' %>" href="/inventory/categories">
          <i class="fa-solid fa-folder-tree"></i> الفئات
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'products' ? 'active' : '' %>" href="/inventory/products">
          <i class="fa-solid fa-box-open"></i> المنتجات
        </a>
      </li>
    </ul>
  </div>
</div>

<style>
/* Sidebar styles for Inventory module */
.inventory-sidebar { background-color: #ffffff; border-left: 1px solid rgba(0,0,0,0.08); height: calc(100vh - 56px); padding-top: 15px; overflow-y: auto; width: 250px; flex-shrink: 0; }
.inventory-sidebar .nav-link { color: #4B5563; padding: 10px 20px; font-weight: 600; border-radius: 8px; margin: 2px 10px; transition: all 0.2s; }
.inventory-sidebar .nav-link:hover, .inventory-sidebar .nav-link.active { background-color: rgba(16, 172, 132, 0.08); color: #10AC84; }
.inventory-sidebar .nav-link i { width: 30px; text-align: center; }
@media (max-width: 767.98px) { .inventory-sidebar { border-left: none; height: 100%; padding-top: 0; } }
</style>
