<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || 'نظام ERP' %></title>
  <% if (locals.csrfToken) { %>
  <meta name="csrf-token" content="<%= locals.csrfToken %>">
  <% } %>
  
  <!-- Google Fonts: Cairo -->
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Bootstrap 5 RTL -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <style>
    :root {
      --primary-color: <%= locals.themeColor || '#714B67' %>; /* Dynamic Theme Color */
      --module-accent: <%= locals.themeColor || '#714B67' %>;
      --module-accent-subtle: <%= (locals.themeColor || '#714B67') === '#10AC84' ? 'rgba(16, 172, 132, 0.08)' : 'rgba(113, 75, 103, 0.08)' %>;
      --module-accent-hover: <%= (locals.themeColor || '#714B67') === '#10AC84' ? '#0E9B76' : '#5A3B52' %>;
    }
    body { font-family: 'Cairo', sans-serif; background-color: #F9FAFB; overflow-x: hidden; }
    .odoo-navbar { background-color: var(--primary-color); border-bottom: 1px solid rgba(0,0,0,0.1); }
    .odoo-navbar .nav-link, .odoo-navbar .navbar-brand { color: #ffffff !important; opacity: 0.9; }
    .odoo-navbar .nav-link:hover { opacity: 1; }
    .app-icon { font-size: 1.5rem; }
    
    .master-wrapper { display: flex; width: 100%; min-height: calc(100vh - 56px); }
    .main-content-area { flex-grow: 1; transition: all 0.3s; background-color: #F9FAFB; }
    
    /* Footer styles - Modern Floating Bar */
    .dashboard-footer { 
      background: rgba(255, 255, 255, 0.8); 
      backdrop-filter: blur(8px);
      border-top: 1px solid #E5E7EB; 
      padding: 8px 30px; 
      color: #6B7280; 
      font-size: 0.72rem;
      font-weight: 500;
    }
  </style>

  <% if (typeof defineContent === 'function') { %>
    <%- defineContent('style') %>
  <% } %>
</head>
