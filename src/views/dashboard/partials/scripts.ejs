<!-- Core Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Global Toast Logic -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Toast Definition
    const Toast = Swal.mixin({
      toast: true,
      position: 'top-start',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true,
      didOpen: (toast) => {
        toast.addEventListener('mouseenter', Swal.stopTimer);
        toast.addEventListener('mouseleave', Swal.resumeTimer);
      }
    });

    // 2. Handle standard URL Redirect Messages (Fallback)
    const urlParams = new URLSearchParams(window.location.search);
    const successMsg = urlParams.get('success');
    const errorMsg = urlParams.get('error');

    if (successMsg) {
      Toast.fire({ icon: 'success', title: successMsg });
      window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (errorMsg) {
      Toast.fire({ icon: 'error', title: errorMsg });
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    // 3. Handle AJAX pending messages from SessionStorage
    const ajaxMsg = sessionStorage.getItem('pendingToast');
    if (ajaxMsg) {
      Toast.fire({ icon: 'success', title: ajaxMsg });
      sessionStorage.removeItem('pendingToast');
    }
  });
</script>

<% if (typeof defineContent === 'function') { %>
  <%- defineContent('script') %>
<% } %>
