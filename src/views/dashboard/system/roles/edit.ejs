<div class="row justify-content-center">
  <div class="col-lg-8 col-xl-7">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1" style="color: #1F2937;">تعديل الدور: <%= targetRole.name %> <i class="fa-solid fa-pen-to-square text-muted fs-5 ms-2"></i></h3>
        <p class="text-muted mb-0 small">تعديل بيانات الدور الوظيفي وحالة تفعيله</p>
      </div>
      <a href="/system/roles" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-right"></i>
        <span>العودة للأدوار</span>
      </a>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
      <div class="card-body p-4">
        <div id="formAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

        <% if (isSystemAdmin) { %>
          <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
            <i class="fa-solid fa-circle-info fs-5 me-2 flex-shrink-0"></i>
            <div>هذا هو دور مدير النظام الأساسي (<code><%= targetRole.code %></code>)، لا يمكن تعديل رمزه أو تعطيله.</div>
          </div>
        <% } %>

        <form id="editRoleForm" class="needs-validation" data-role-id="<%= targetRole.id %>" novalidate>
          <div class="mb-3">
            <label for="name" class="form-label fw-bold">اسم الدور <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="name" name="name" required minlength="2" maxlength="100" value="<%= targetRole.name %>" placeholder="مثال: مدير الإنتاج">
            <div class="invalid-feedback">يرجى إدخال اسم الدور (من 2 إلى 100 حرف).</div>
          </div>

          <div class="mb-3">
            <label for="code" class="form-label fw-bold">الرمز التقني للدور</label>
            <input type="text" class="form-control font-monospace bg-light" id="code" name="code" value="<%= targetRole.code %>" disabled readonly dir="ltr" style="text-align: right;">
            <div class="form-text text-muted small">
              الرمز التقني للدور ثابت وغير قابل للتعديل للحفاظ على تكامل الصلاحيات.
            </div>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label fw-bold">الوصف <span class="text-muted small fw-normal">(اختياري)</span></label>
            <textarea class="form-control" id="description" name="description" rows="3" maxlength="500" placeholder="وصف موجز للمسؤوليات والمهام المرتبطة بهذا الدور..."><%= targetRole.description || '' %></textarea>
          </div>

          <div class="mb-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="isActive" name="isActive" <%= targetRole.isActive ? 'checked' : '' %> <%= isSystemAdmin ? 'disabled' : '' %>>
              <label class="form-check-label fw-bold" for="isActive">الدور نشط</label>
            </div>
            <% if (isSystemAdmin) { %>
              <div class="form-text text-muted small">دور مدير النظام نشط دائماً ولا يمكن تعطيله.</div>
            <% } else { %>
              <div class="form-text text-muted small">لا يمكن تعطيل الدور إذا كان مستخدماً من قبل مستخدمين حاليين في النظام.</div>
            <% } %>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a href="/system/roles" class="btn btn-light px-4">إلغاء</a>
            <button type="submit" id="submitBtn" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4" style="background-color: #714B67; border-color: #714B67;">
              <span class="spinner-border spinner-border-sm d-none" role="status"></span>
              <i class="fa-solid fa-check"></i>
              <span id="btnText">حفظ التغييرات</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/roles.js"></script>
