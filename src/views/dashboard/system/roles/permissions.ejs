<div class="row justify-content-center">
  <div class="col-lg-10 col-xl-9">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
      <div>
        <h3 class="fw-bold mb-1" style="color: #1F2937;">
          صلاحيات الدور: <%= role.name %>
          <i class="fa-solid fa-key text-muted fs-5 ms-2"></i>
        </h3>
        <p class="text-muted mb-0 small">
          إسناد الصلاحيات الشاملة (Global Permissions) الممنوحة لهذا الدور
        </p>
      </div>
      <a href="/system/roles" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-right"></i>
        <span>العودة للأدوار</span>
      </a>
    </div>

    <!-- Role Summary Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
      <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="rounded-circle d-flex justify-content-center align-items-center text-white fw-bold" style="width: 44px; height: 44px; background-color: #714B67; font-size: 1.1rem;">
            <%= role.name ? role.name.charAt(0) : 'R' %>
          </div>
          <div>
            <div class="fw-bold text-dark fs-5"><%= role.name %></div>
            <div class="text-muted small">
              الرمز: <code class="bg-light text-dark px-2 py-0.5 rounded border"><%= role.code %></code>
              <% if (role.description) { %>
                <span class="mx-2">•</span> <span><%= role.description %></span>
              <% } %>
            </div>
          </div>
        </div>
        <div>
          <% if (role.isActive) { %>
            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
              <i class="fa-solid fa-circle-check me-1"></i> نشط
            </span>
          <% } else { %>
            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">
              <i class="fa-solid fa-circle-xmark me-1"></i> معطل
            </span>
          <% } %>
        </div>
      </div>
    </div>

    <% if (isSystemAdmin) { %>
      <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
        <i class="fa-solid fa-circle-info fs-4 me-3 flex-shrink-0"></i>
        <div>
          <strong>صلاحيات مدير النظام الأساسية تُدار تلقائيًا بواسطة النظام.</strong>
          <div class="small text-muted mt-1">يحصل دور <code>SYSTEM_ADMIN</code> تلقائياً على كافة الصلاحيات النشطة من خلال التثبيت الأولي (Seed)، ولا يمكن تعديلها يدوياً من هذه الشاشة.</div>
        </div>
      </div>
    <% } %>

    <div id="formAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

    <!-- Permissions Form Card -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
      <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">قائمة الصلاحيات المتاحة</h5>
        <span class="badge bg-secondary-subtle text-secondary-emphasis px-2 py-1 rounded-pill small">
          الصلاحيات الشاملة (ALLOW ALL)
        </span>
      </div>

      <div class="card-body p-4">
        <form id="rolePermissionsForm" data-role-id="<%= role.id %>">
          <% 
            // Group permissions by prefix / application
            const groups = {};
            if (typeof permissions !== 'undefined' && permissions.length > 0) {
              permissions.forEach(function(p) {
                const parts = p.name.split('.');
                const app = parts[0] || 'عام';
                const resource = parts[1] || 'عام';
                const groupKey = app + ' / ' + resource;
                if (!groups[groupKey]) {
                  groups[groupKey] = [];
                }
                groups[groupKey].push(p);
              });
            }
          %>

          <% if (Object.keys(groups).length > 0) { %>
            <% Object.keys(groups).forEach(function(groupName, idx) { %>
              <div class="mb-4 <%= idx > 0 ? 'pt-3 border-top' : '' %>">
                <h6 class="fw-bold text-muted mb-3 d-flex align-items-center gap-2" style="font-size: 0.9rem;">
                  <i class="fa-solid fa-layer-group text-primary"></i>
                  <span>قسم: <%= groupName %></span>
                </h6>

                <div class="row g-3">
                  <% groups[groupName].forEach(function(p) { %>
                    <div class="col-md-6">
                      <div class="p-3 rounded border h-100 bg-light-subtle d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-start gap-3">
                          <div class="form-check pt-1">
                            <input
                              class="form-check-input"
                              type="checkbox"
                              name="permissionIds"
                              value="<%= p.id %>"
                              id="perm_<%= p.id %>"
                              <%= p.hasAllowAll ? 'checked' : '' %>
                              <%= (isSystemAdmin || !canManagePermissions) ? 'disabled' : '' %>
                              style="cursor: pointer; transform: scale(1.2);"
                            >
                          </div>
                          <div class="flex-grow-1">
                            <label class="form-check-label fw-bold text-dark d-block mb-1" for="perm_<%= p.id %>" style="cursor: pointer;">
                              <%= p.description || p.name %>
                            </label>
                            <code class="small text-muted d-block mb-1" style="font-size: 0.8rem;"><%= p.name %></code>
                          </div>
                        </div>

                        <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                          <span class="small text-muted">حالة الوصول:</span>
                          <div>
                            <% if (p.hasDenyAll) { %>
                              <span class="badge bg-danger-subtle text-danger small">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> محظور بقاعدة حظر (DENY)
                              </span>
                            <% } else if (p.effectiveGlobalAccess) { %>
                              <span class="badge bg-success-subtle text-success small">
                                <i class="fa-solid fa-check me-1"></i> مسموح شامل
                              </span>
                            <% } else { %>
                              <span class="badge bg-secondary-subtle text-secondary small">
                                غير مفعّل
                              </span>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="text-center py-5 text-muted">
              <i class="fa-solid fa-key fs-1 text-secondary mb-3 d-block"></i>
              <p class="mb-0 fw-bold">لا توجد صلاحيات مسجلة في النظام حالياً</p>
            </div>
          <% } %>

          <div class="d-flex justify-content-end gap-2 pt-4 mt-3 border-top">
            <a href="/system/roles" class="btn btn-light px-4">إلغاء</a>
            <% if (!isSystemAdmin && canManagePermissions) { %>
              <button type="submit" id="savePermissionsBtn" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4" style="background-color: #714B67; border-color: #714B67;">
                <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                <i class="fa-solid fa-floppy-disk"></i>
                <span id="btnText">حفظ الصلاحيات</span>
              </button>
            <% } %>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/roles.js"></script>
