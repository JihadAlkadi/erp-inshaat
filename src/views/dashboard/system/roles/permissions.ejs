<div class="row justify-content-center">
  <div class="col-12 col-xl-11">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
      <div>
        <h3 class="fw-bold mb-1" style="color: #1F2937;">
          صلاحيات الدور: <%= role.name %>
          <i class="fa-solid fa-key text-muted fs-5 ms-2"></i>
        </h3>
        <p class="text-muted mb-0 small">
          إدارة تفعيل الصلاحيات وقواعد الوصول (Access Rules) المفصلة لهذا الدور
        </p>
      </div>
      <a href="/system/roles" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-right"></i>
        <span>العودة للأدوار</span>
      </a>
    </div>

    <!-- Role Summary Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
      <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="rounded-circle d-flex justify-content-center align-items-center text-white fw-bold" style="width: 44px; height: 44px; background-color: #714B67; font-size: 1.1rem;">
            <%= role.name ? role.name.charAt(0) : 'R' %>
          </div>
          <div>
            <div class="fw-bold text-dark fs-5"><%= role.name %></div>
            <div class="text-muted small">
              الرمز: <code class="bg-light text-dark px-2 py-0.5 rounded border"><%= role.code %></code>
              <% if (role.description) { %>
                <span class="mx-2">•</span> <span><%= role.description %></span>
              <% } %>
            </div>
          </div>
        </div>
        <div>
          <% if (role.isActive) { %>
            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
              <i class="fa-solid fa-circle-check me-1"></i> نشط
            </span>
          <% } else { %>
            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">
              <i class="fa-solid fa-circle-xmark me-1"></i> معطل
            </span>
          <% } %>
        </div>
      </div>
    </div>

    <% if (isSystemAdmin) { %>
      <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
        <i class="fa-solid fa-circle-info fs-4 me-3 flex-shrink-0"></i>
        <div>
          <strong>صلاحيات مدير النظام الأساسية تُدار تلقائيًا بواسطة النظام.</strong>
          <div class="small text-muted mt-1">يحصل دور <code>SYSTEM_ADMIN</code> تلقائياً على كافة الصلاحيات النشطة، ولا يمكن تعديل قواعد وصوله يدوياً من هذه الشاشة.</div>
        </div>
      </div>
    <% } %>

    <div id="pageAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

    <!-- Permissions Container -->
    <div id="rolePermissionsContainer" data-role-id="<%= role.id %>" data-is-admin="<%= isSystemAdmin ? 'true' : 'false' %>" data-can-manage="<%= canManagePermissions ? 'true' : 'false' %>">
      <% 
        const groups = {};
        if (typeof permissions !== 'undefined' && permissions.length > 0) {
          permissions.forEach(function(p) {
            const parts = p.name.split('.');
            const app = parts[0] || 'عام';
            const resource = parts[1] || 'عام';
            const groupKey = app + ' / ' + resource;
            if (!groups[groupKey]) {
              groups[groupKey] = [];
            }
            groups[groupKey].push(p);
          });
        }
      %>

      <% if (Object.keys(groups).length > 0) { %>
        <% Object.keys(groups).forEach(function(groupName, idx) { %>
          <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden;">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
              <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="fa-solid fa-layer-group text-primary"></i>
                <span>قسم: <%= groupName %></span>
              </h6>
              <span class="badge bg-light text-secondary border px-2 py-1 rounded-pill small">
                <%= groups[groupName].length %> صلاحيات
              </span>
            </div>

            <div class="card-body p-4">
              <div class="row g-3">
                <% groups[groupName].forEach(function(p) { %>
                  <div class="col-12 col-lg-6" id="card_perm_<%= p.permissionId %>">
                    <div class="p-3 rounded border h-100 bg-light-subtle d-flex flex-column justify-content-between permission-card transition-all">
                      <div>
                        <!-- Card Header: Checkbox & Info -->
                        <div class="d-flex align-items-start gap-3">
                          <div class="form-check pt-1">
                            <input
                              class="form-check-input perm-state-toggle"
                              type="checkbox"
                              id="toggle_<%= p.permissionId %>"
                              data-permission-id="<%= p.permissionId %>"
                              <%= p.enabled ? 'checked' : '' %>
                              <%= (isSystemAdmin || !canManagePermissions) ? 'disabled' : '' %>
                              style="cursor: pointer; transform: scale(1.25);"
                              title="تفعيل / تعطيل الصلاحية"
                            >
                          </div>
                          <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                              <label class="form-check-label fw-bold text-dark mb-0 fs-6" for="toggle_<%= p.permissionId %>" style="cursor: pointer;">
                                <%= p.description || p.name %>
                              </label>
                            </div>
                            <code class="small text-muted d-block mb-2" style="font-size: 0.8rem;"><%= p.name %></code>
                          </div>
                        </div>

                        <!-- Status & Badges -->
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2 mt-1 status-badge-area">
                          <% if (!p.enabled) { %>
                            <span class="badge bg-secondary-subtle text-secondary small py-1 px-2">
                              <i class="fa-solid fa-circle-minus me-1"></i> غير مفعلة
                            </span>
                          <% } else if (p.hasDenyAll) { %>
                            <span class="badge bg-danger-subtle text-danger small py-1 px-2">
                              <i class="fa-solid fa-ban me-1"></i> محظورة بقاعدة DENY ALL
                            </span>
                          <% } else if (p.allowRuleCount === 0) { %>
                            <span class="badge bg-warning-subtle text-warning-emphasis small py-1 px-2 border border-warning-subtle" title="الصلاحية مفعلة لكن لا توجد قاعدة منح فعالة">
                              <i class="fa-solid fa-triangle-exclamation me-1"></i> مفعلة بلا قاعدة منح
                            </span>
                          <% } else if (p.hasAllowAll) { %>
                            <span class="badge bg-success-subtle text-success small py-1 px-2">
                              <i class="fa-solid fa-check-double me-1"></i> وصول شامل (ALLOW ALL)
                            </span>
                          <% } else { %>
                            <span class="badge bg-primary-subtle text-primary small py-1 px-2">
                              <i class="fa-solid fa-shield-halved me-1"></i> وصول مقيد بقواعد
                            </span>
                          <% } %>

                          <% if (p.allowRuleCount > 0) { %>
                            <span class="badge bg-success text-white small py-1 px-2 rounded-pill">
                              <%= p.allowRuleCount %> منح
                            </span>
                          <% } %>

                          <% if (p.denyRuleCount > 0) { %>
                            <span class="badge bg-danger text-white small py-1 px-2 rounded-pill">
                              <%= p.denyRuleCount %> استثناء/حظر
                            </span>
                          <% } %>
                        </div>

                        <!-- Configuration Summary -->
                        <div class="small text-muted mb-3 bg-white p-2 rounded border border-light-subtle summary-text">
                          <i class="fa-solid fa-sliders text-secondary me-1"></i>
                          <span><%= p.summary %></span>
                        </div>
                      </div>

                      <!-- Action Button -->
                      <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                        <span class="small text-muted"><%= p.rules.length %> قواعد مسجلة</span>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-primary open-rules-drawer-btn d-inline-flex align-items-center gap-1 px-3"
                          data-permission-id="<%= p.permissionId %>"
                          data-permission-name="<%= p.name %>"
                          data-permission-desc="<%= p.description || p.name %>"
                        >
                          <i class="fa-solid fa-gears"></i>
                          <span>إدارة قواعد الوصول</span>
                        </button>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 12px;">
          <i class="fa-solid fa-key fs-1 text-secondary mb-3 d-block"></i>
          <p class="mb-0 fw-bold">لا توجد صلاحيات مسجلة في النظام حالياً</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Offcanvas Drawer for Access Rules Administration -->
<div
  class="offcanvas offcanvas-start border-0 shadow-lg"
  tabindex="-1"
  id="accessRulesOffcanvas"
  aria-labelledby="accessRulesOffcanvasLabel"
  style="width: 600px; max-width: 100vw;"
>
  <div class="offcanvas-header bg-light border-bottom p-3">
    <div class="d-flex align-items-center gap-2">
      <div class="rounded p-2 text-white" style="background-color: #714B67;">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <div>
        <h5 class="offcanvas-title fw-bold text-dark mb-0 fs-6" id="accessRulesOffcanvasLabel">
          قواعد وصول الصلاحية
        </h5>
        <code class="small text-muted" id="drawerPermissionCode">permission.code</code>
      </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button>
  </div>

  <div class="offcanvas-body p-4 d-flex flex-column justify-content-between">
    <div>
      <!-- Drawer Permission State Banner -->
      <div id="drawerStateBanner" class="p-3 rounded mb-4 bg-light border d-flex align-items-center justify-content-between">
        <div>
          <div class="fw-bold text-dark small" id="drawerPermissionDesc">وصف الصلاحية</div>
          <div class="small text-muted mt-1" id="drawerRuleCountsSummary">0 قواعد منح • 0 قواعد حظر</div>
        </div>
        <div id="drawerStatusBadge"></div>
      </div>

      <div id="drawerAlert" class="alert alert-danger d-none mb-3" role="alert"></div>

      <!-- Active Rules Section -->
      <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-list-check text-primary"></i>
            <span>قواعد الوصول الحالية</span>
          </h6>
          <button type="button" id="showAddRuleFormBtn" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" style="background-color: #714B67; border-color: #714B67;">
            <i class="fa-solid fa-plus"></i>
            <span>إضافة قاعدة</span>
          </button>
        </div>

        <div id="drawerRulesList" class="d-flex flex-column gap-2">
          <!-- Populated dynamically via JS -->
          <div class="text-center py-4 text-muted small">
            <div class="spinner-border spinner-border-sm text-secondary mb-2" role="status"></div>
            <div>جاري تحميل القواعد...</div>
          </div>
        </div>
      </div>

      <!-- Add / Edit Rule Form Card (Collapsible) -->
      <div id="ruleFormContainer" class="card border border-primary-subtle bg-light-subtle mb-4 d-none" style="border-radius: 10px;">
        <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
          <span class="fw-bold small text-dark" id="ruleFormTitle">إضافة قاعدة وصول جديدة</span>
          <button type="button" id="cancelRuleFormBtn" class="btn btn-sm btn-link text-muted text-decoration-none p-0">إلغاء</button>
        </div>
        <div class="card-body p-3">
          <form id="accessRuleForm">
            <input type="hidden" id="formRuleId" value="">

            <!-- Effect -->
            <div class="mb-3">
              <label class="form-label fw-bold small text-dark mb-1">نوع التأثير (Effect)</label>
              <div class="d-flex gap-2">
                <div class="form-check form-check-inline flex-grow-1 border rounded p-2 m-0 bg-white d-flex align-items-center gap-2">
                  <input class="form-check-input ms-0 me-2" type="radio" name="ruleEffect" id="effectAllow" value="ALLOW" checked>
                  <label class="form-check-label text-success fw-bold small cursor-pointer" for="effectAllow">
                    <i class="fa-solid fa-circle-check me-1"></i> منح (ALLOW)
                  </label>
                </div>
                <div class="form-check form-check-inline flex-grow-1 border rounded p-2 m-0 bg-white d-flex align-items-center gap-2">
                  <input class="form-check-input ms-0 me-2" type="radio" name="ruleEffect" id="effectDeny" value="DENY">
                  <label class="form-check-label text-danger fw-bold small cursor-pointer" for="effectDeny">
                    <i class="fa-solid fa-ban me-1"></i> حظر / استثناء (DENY)
                  </label>
                </div>
              </div>
            </div>

            <!-- Preset Scope -->
            <div class="mb-3">
              <label class="form-label fw-bold small text-dark mb-1" for="rulePresetSelect">نطاق الوصول (Scope Preset)</label>
              <select class="form-select form-select-sm" id="rulePresetSelect" required>
                <!-- Populated dynamically from capabilities -->
              </select>
              <div class="form-text small" id="presetHelpText">اختر نطاق الصلاحية المسموح</div>
            </div>

            <!-- Searchable Target Selector (Shown for SPECIFIC_* presets) -->
            <div id="targetSelectorContainer" class="mb-3 d-none">
              <label class="form-label fw-bold small text-dark mb-1" id="targetSelectorLabel">تحديد الأهداف</label>
              
              <!-- Selected Target Chips -->
              <div id="selectedTargetChips" class="d-flex flex-wrap gap-1 mb-2 p-2 bg-white border rounded min-h-38">
                <span class="text-muted small align-self-center empty-chips-text">لم يتم تحديد أي أهداف بعد</span>
              </div>

              <!-- Search Input -->
              <div class="input-group input-group-sm mb-2">
                <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
                <input type="text" class="form-control" id="targetSearchInput" placeholder="بحث بالاسم أو الرمز...">
              </div>

              <!-- Scrollable Results Checkbox List -->
              <div id="targetSearchResults" class="border rounded bg-white p-2 overflow-auto" style="max-height: 180px;">
                <div class="text-center py-2 text-muted small">جاري جلب القائمة...</div>
              </div>
            </div>

            <!-- Description -->
            <div class="mb-3">
              <label class="form-label fw-bold small text-dark mb-1" for="ruleDescriptionInput">ملاحظات / سبب القاعدة (اختياري)</label>
              <textarea class="form-control form-control-sm" id="ruleDescriptionInput" rows="2" placeholder="أدخل سبب أو وصف القاعدة إن وجد..."></textarea>
            </div>

            <!-- Submit Buttons -->
            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
              <button type="button" id="cancelRuleFormBtn2" class="btn btn-sm btn-light px-3">إلغاء</button>
              <button type="submit" id="saveRuleSubmitBtn" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1 px-3" style="background-color: #714B67; border-color: #714B67;">
                <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                <i class="fa-solid fa-check"></i>
                <span id="saveRuleBtnText">حفظ القاعدة</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="pt-3 border-top d-flex justify-content-between align-items-center text-muted small">
      <span>تنعكس القواعد فوراً على تقييم صلاحيات النظام</span>
      <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="offcanvas">إغلاق</button>
    </div>
  </div>
</div>

<script src="/js/roles.js"></script>
