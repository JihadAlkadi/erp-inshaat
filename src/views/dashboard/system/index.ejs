<h3 class="fw-bold mb-4" style="color: #1F2937;">إحصائيات النظام العامة <i class="fa-solid fa-chart-line text-muted fs-5 ms-2"></i></h3>

<div class="row g-4 mb-4">
  <!-- Card 1 -->
  <div class="col-md-3">
    <div class="card border-0 shadow-sm" style="border-radius: 12px; border-right: 5px solid #2E86DE !important;">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 fw-bold">إجمالي المستخدمين</p>
            <h3 class="mb-0 fw-bold" style="color: #2E86DE;"><%= typeof usersCount !== 'undefined' ? usersCount : '0' %></h3>
          </div>
          <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px; background-color: rgba(46, 134, 222, 0.1);">
            <i class="fa-solid fa-users fs-4" style="color: #2E86DE;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Card 2 -->
  <div class="col-md-3">
    <div class="card border-0 shadow-sm" style="border-radius: 12px; border-right: 5px solid #10AC84 !important;">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 fw-bold">المستخدمين النشطين</p>
            <h3 class="mb-0 fw-bold" style="color: #10AC84;"><%= typeof activeUsersCount !== 'undefined' ? activeUsersCount : '0' %></h3>
          </div>
          <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px; background-color: rgba(16, 172, 132, 0.1);">
            <i class="fa-solid fa-user-check fs-4" style="color: #10AC84;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 3 -->
  <div class="col-md-3">
    <div class="card border-0 shadow-sm" style="border-radius: 12px; border-right: 5px solid #FF9F43 !important;">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 fw-bold">الأدوار المعرفة</p>
            <h3 class="mb-0 fw-bold" style="color: #FF9F43;"><%= typeof rolesCount !== 'undefined' ? rolesCount : '0' %></h3>
          </div>
          <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px; background-color: rgba(255, 159, 67, 0.1);">
            <i class="fa-solid fa-user-shield fs-4" style="color: #FF9F43;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 4 -->
  <div class="col-md-3">
    <div class="card border-0 shadow-sm" style="border-radius: 12px; border-right: 5px solid #EE5253 !important;">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 fw-bold">الآمان وتنبيهات</p>
            <h3 class="mb-0 fw-bold" style="color: #EE5253;">0</h3>
          </div>
          <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px; background-color: rgba(238, 82, 83, 0.1);">
            <i class="fa-solid fa-shield-virus fs-4" style="color: #EE5253;"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-md-8">
    <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px; min-height: 250px;">
      <h5 class="fw-bold text-muted mb-3"><i class="fa-solid fa-file-contract me-2"></i>سجل الجلسات الأخير</h5>
      <p class="text-muted text-center mt-5">لا توجد حركات مسجلة حالياً</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px; min-height: 250px;">
      <h5 class="fw-bold text-muted mb-3"><i class="fa-solid fa-mobile-screen me-2"></i>الأجهزة المتصلة</h5>
      <p class="text-muted text-center mt-5">قريباً..</p>
    </div>
  </div>
</div>
