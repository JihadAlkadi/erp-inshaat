<!-- Sidebar: Offcanvas on mobile, static on desktop -->
<div class="offcanvas-md offcanvas-start system-sidebar shadow-sm" tabindex="-1" id="appSidebar">
  <div class="offcanvas-header d-md-none border-bottom pb-3 mb-2">
    <h5 class="offcanvas-title fw-bold" id="offcanvasNavbarLabel"><i class="fa-solid fa-shield-halved me-2"></i> إدارة النظام</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar"></button>
  </div>
  
  <div class="offcanvas-body flex-column p-0 py-md-2">
    <div class="px-3 mb-2 mt-md-0 mt-2 text-muted" style="font-size: 0.85rem; font-weight: 700;">الموارد الأساسية</div>
    <ul class="nav flex-column mb-3">
      <li class="nav-item">
        <a class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'dashboard' ? 'active' : '' %>" href="/system">
          <i class="fa-solid fa-chart-line"></i> الإحصائيات
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'users' ? 'active' : '' %>" href="/system/users">
          <i class="fa-solid fa-users-gear"></i> إدارة المستخدمين
        </a>
      </li>
    </ul>

    <div class="px-3 mb-2 text-muted" style="font-size: 0.85rem; font-weight: 700;">الأمان</div>
    <ul class="nav flex-column mb-3">
      <li class="nav-item">
        <a class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'roles' ? 'active' : '' %>" href="/system/roles">
          <i class="fa-solid fa-user-shield"></i> الأدوار والصلاحيات
        </a>
      </li>
    </ul>

    <div class="px-3 mb-2 text-muted" style="font-size: 0.85rem; font-weight: 700;">التفضيلات</div>
    <ul class="nav flex-column mb-3">
      <li class="nav-item">
        <a class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'settings' ? 'active' : '' %>" href="/system/settings">
          <i class="fa-solid fa-gears"></i> الإعدادات العامة
        </a>
      </li>
    </ul>
  </div>
</div>

<style>
/* Sidebar styles for System module */
.system-sidebar { background-color: #ffffff; border-left: 1px solid rgba(0,0,0,0.08); height: calc(100vh - 56px); padding-top: 15px; overflow-y: auto; width: 250px; flex-shrink: 0; }
.system-sidebar .nav-link { color: #4B5563; padding: 10px 20px; font-weight: 600; border-radius: 8px; margin: 2px 10px; transition: all 0.2s; }
.system-sidebar .nav-link:hover, .system-sidebar .nav-link.active { background-color: rgba(113, 75, 103, 0.08); color: #714B67; }
.system-sidebar .nav-link i { width: 30px; text-align: center; }
@media (max-width: 767.98px) { .system-sidebar { border-left: none; height: 100%; padding-top: 0; } }
</style>
