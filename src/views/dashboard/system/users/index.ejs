<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1" style="color: #1F2937;">إدارة المستخدمين <i class="fa-solid fa-users-gear text-muted fs-5 ms-2"></i></h3>
    <p class="text-muted mb-0 small">إدارة حسابات المستخدمين، الأدوار، وحالة التفعيل في النظام</p>
  </div>
  <% if (typeof canCreate !== 'undefined' && canCreate) { %>
    <div>
      <a href="/system/users/create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm px-4 py-2" style="background-color: #714B67; border-color: #714B67;">
        <i class="fa-solid fa-user-plus"></i>
        <span>إضافة مستخدم</span>
      </a>
    </div>
  <% } %>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-3">
    <form method="GET" action="/system/users" class="row g-2 align-items-center">
      <div class="col-md-5 col-lg-4">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
          <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="بحث بالاسم أو رقم الهاتف..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        </div>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary px-3">بحث</button>
        <% if (typeof search !== 'undefined' && search) { %>
          <a href="/system/users" class="btn btn-link text-muted text-decoration-none">إلغاء البحث</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Users Table Card -->
<div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr class="text-muted small">
          <th scope="col" class="py-3 px-4">المستخدم</th>
          <th scope="col" class="py-3">رقم الهاتف</th>
          <th scope="col" class="py-3">الدور</th>
          <th scope="col" class="py-3 text-center">الحالة</th>
          <th scope="col" class="py-3">تاريخ الإنشاء</th>
          <th scope="col" class="py-3 text-center px-4">الإجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof users !== 'undefined' && users.length > 0) { %>
          <% users.forEach(function(u) { %>
            <tr>
              <td class="py-3 px-4">
                <div class="d-flex align-items-center gap-3">
                  <div class="rounded-circle d-flex justify-content-center align-items-center text-white fw-bold" style="width: 40px; height: 40px; background-color: #714B67; font-size: 0.95rem;">
                    <%= u.fullName ? u.fullName.charAt(0) : 'U' %>
                  </div>
                  <div>
                    <div class="fw-bold text-dark"><%= u.fullName %></div>
                    <% if (u.id === currentUserId) { %>
                      <span class="badge bg-info-subtle text-info-emphasis small" style="font-size: 0.7rem;">حسابك الحالي</span>
                    <% } %>
                  </div>
                </div>
              </td>
              <td class="py-3 text-muted" dir="ltr" style="text-align: right;"><%= u.phone %></td>
              <td class="py-3">
                <span class="badge bg-secondary-subtle text-secondary-emphasis px-2 py-1 rounded-pill">
                  <i class="fa-solid fa-shield-halved me-1 small"></i> <%= u.roleName || 'غير محدد' %>
                </span>
              </td>
              <td class="py-3 text-center">
                <% if (u.isActive) { %>
                  <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">
                    <i class="fa-solid fa-circle-check me-1"></i> نشط
                  </span>
                <% } else { %>
                  <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill">
                    <i class="fa-solid fa-circle-xmark me-1"></i> معطل
                  </span>
                <% } %>
              </td>
              <td class="py-3 text-muted small">
                <%= new Date(u.createdAt).toLocaleDateString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric' }) %>
              </td>
              <td class="py-3 text-center px-4">
                <div class="d-inline-flex gap-1">
                  <% if (typeof canUpdate !== 'undefined' && canUpdate) { %>
                    <a href="/system/users/<%= u.id %>/edit" class="btn btn-sm btn-outline-primary" title="تعديل">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <% if (u.id !== currentUserId) { %>
                      <% if (u.isActive) { %>
                        <button type="button" class="btn btn-sm btn-outline-warning" title="تعطيل المستخدم" onclick="toggleUserStatus('<%= u.id %>', false, '<%= u.fullName %>')">
                          <i class="fa-solid fa-user-slash"></i>
                        </button>
                      <% } else { %>
                        <button type="button" class="btn btn-sm btn-outline-success" title="تفعيل المستخدم" onclick="toggleUserStatus('<%= u.id %>', true, '<%= u.fullName %>')">
                          <i class="fa-solid fa-user-check"></i>
                        </button>
                      <% } %>
                    <% } %>
                  <% } %>

                  <% if (typeof canDelete !== 'undefined' && canDelete && u.id !== currentUserId) { %>
                    <button type="button" class="btn btn-sm btn-outline-danger" title="أرشفة / حذف" onclick="confirmDeleteUser('<%= u.id %>', '<%= u.fullName %>')">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              <div class="py-3">
                <i class="fa-solid fa-users-slash fs-1 text-secondary mb-3 d-block"></i>
                <p class="mb-0 fw-bold">لا يوجد مستخدمون متطابقون مع معايير البحث</p>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination Footer -->
  <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
    <div class="card-footer bg-white border-top d-flex flex-wrap justify-content-between align-items-center py-3 px-4">
      <div class="text-muted small">
        عرض الصفحة <strong><%= pagination.page %></strong> من إجمالي <strong><%= pagination.totalPages %></strong> صفحات (إجمالي المستخدمين: <%= pagination.total %>)
      </div>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/system/users?page=<%= pagination.page - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">السابق</a>
          </li>
          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
              <a class="page-link" href="/system/users?page=<%= p %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" style="<%= pagination.page === p ? 'background-color: #714B67; border-color: #714B67;' : '' %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/system/users?page=<%= pagination.page + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">التالي</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>

<script src="/js/users.js"></script>
