<% if (typeof warnings !== 'undefined' && warnings.length > 0) { %>
  <div class="user-portfolio-card">
    <div class="user-portfolio-card-header">
      <h5 class="user-portfolio-card-title text-warning-emphasis">
        <i class="fa-solid fa-triangle-exclamation text-warning"></i>
        <span>تنبيهات الوصول والحساب</span>
      </h5>
      <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2.5 py-1">
        <%= warnings.length %> تنبيه
      </span>
    </div>
    <div class="user-portfolio-card-body p-3">
      <div class="d-flex flex-column gap-2.5">
        <% warnings.forEach(function(w) { %>
          <% 
            let alertClass = 'alert-info text-info-emphasis border-info-subtle';
            let iconClass = 'fa-circle-info text-info';
            if (w.severity === 'CRITICAL') {
              alertClass = 'alert-danger text-danger-emphasis border-danger-subtle';
              iconClass = 'fa-circle-xmark text-danger';
            } else if (w.severity === 'WARNING') {
              alertClass = 'alert-warning text-warning-emphasis border-warning-subtle';
              iconClass = 'fa-triangle-exclamation text-warning';
            }
          %>
          <div class="alert <%= alertClass %> mb-0 p-3 rounded-3 d-flex align-items-start justify-content-between gap-3">
            <div class="d-flex align-items-start gap-2.5">
              <i class="fa-solid <%= iconClass %> fs-5 mt-0.5 flex-shrink-0"></i>
              <div>
                <strong class="d-block mb-1"><%= w.title %></strong>
                <div class="small"><%= w.message %></div>
              </div>
            </div>
            <% if (w.href) { %>
              <a href="<%= w.href %>" class="btn btn-sm btn-outline-dark bg-white align-self-center text-nowrap">
                <span>معاينة</span>
                <i class="fa-solid fa-chevron-left ms-1 small"></i>
              </a>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="user-portfolio-card">
    <div class="user-portfolio-card-body p-4 text-center text-muted">
      <i class="fa-solid fa-circle-check text-success fs-2 mb-2 d-block"></i>
      <h6 class="fw-bold text-dark mb-1">لا توجد تنبيهات حالياً</h6>
      <p class="small mb-0">حالة الحساب والصلاحيات والمسؤوليات التشغيلية منتظمة وسليمة.</p>
    </div>
  </div>
<% } %>
