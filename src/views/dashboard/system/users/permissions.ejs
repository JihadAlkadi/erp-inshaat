<div class="user-portfolio-container">
  <!-- Header & Navigation -->
  <%- include('./portfolio/partials/header') %>
  <%- include('./portfolio/partials/navigation') %>

  <!-- Context Strip -->
  <% if (typeof productionResponsibility !== 'undefined' && productionResponsibility && productionResponsibility.state === 'VISIBLE') { %>
    <div class="user-portfolio-context-strip">
      <div class="d-flex align-items-center flex-wrap gap-2">
        <i class="fa-solid fa-industry text-primary"></i>
        <strong class="text-dark small">السياق التشغيلي الحالي:</strong>
        <span class="badge <%= productionResponsibility.kind === 'HEAD' ? 'bg-primary' : 'bg-info-subtle text-info-emphasis' %> rounded-pill px-2 py-0.5 small">
          <%= productionResponsibility.kind === 'HEAD' ? 'رئيس قسم' : 'مهندس إنتاج' %>
        </span>
        <% if (productionResponsibility.department) { %>
          <span class="text-muted small">•</span>
          <span class="text-dark small fw-semibold"><%= productionResponsibility.department.name %></span>
        <% } %>
        <% if (productionResponsibility.kind === 'ENGINEER' && productionResponsibility.yards && productionResponsibility.yards.length > 0) { %>
          <span class="text-muted small">•</span>
          <span class="text-muted small">الساحات: <%= productionResponsibility.yards.map(y => y.name).join('، ') %></span>
        <% } %>
      </div>
      <a href="/system/users/<%= targetUser.id %>/production" class="small text-decoration-none fw-semibold">
        تفاصيل المسؤولية <i class="fa-solid fa-chevron-left small"></i>
      </a>
    </div>
  <% } %>

  <% if (isSelf) { %>
    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
      <i class="fa-solid fa-shield-halved fs-4 me-3 flex-shrink-0"></i>
      <div>
        <strong>حماية الحساب الشخصي:</strong>
        <div class="small mt-1">لا يمكنك تعديل صلاحيات حسابك المباشرة بنفسك. يتم عرض الصلاحيات في وضع القراءة فقط.</div>
      </div>
    </div>
  <% } %>

  <div id="pageAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

  <!-- Permissions Container -->
  <div id="userPermissionsContainer" data-user-id="<%= targetUser.id %>" data-is-self="<%= isSelf ? 'true' : 'false' %>" data-can-manage="<%= canManagePermissions ? 'true' : 'false' %>">
      <% 
        const groups = {};
        if (typeof permissions !== 'undefined' && permissions.length > 0) {
          permissions.forEach(function(p) {
            const parts = p.name.split('.');
            const app = parts[0] || 'عام';
            const resource = parts[1] || 'عام';
            const groupKey = app + ' / ' + resource;
            if (!groups[groupKey]) {
              groups[groupKey] = [];
            }
            groups[groupKey].push(p);
          });
        }
      %>

      <% if (Object.keys(groups).length > 0) { %>
        <% Object.keys(groups).forEach(function(groupName, idx) { %>
          <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden;">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
              <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="fa-solid fa-layer-group text-primary"></i>
                <span>قسم: <%= groupName %></span>
              </h6>
              <span class="badge bg-light text-secondary border px-2 py-1 rounded-pill small">
                <%= groups[groupName].length %> صلاحيات
              </span>
            </div>

            <div class="card-body p-4">
              <div class="row g-3">
                <% groups[groupName].forEach(function(p) { %>
                  <div class="col-12 col-lg-6" id="card_perm_<%= p.permissionId %>">
                    <div class="p-3 rounded border h-100 bg-light-subtle d-flex flex-column justify-content-between permission-card">
                      <div>
                        <!-- Title & Code -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                          <div>
                            <span class="fw-bold text-dark fs-6 d-block"><%= p.description || p.name %></span>
                            <code class="small text-muted" style="font-size: 0.8rem;"><%= p.name %></code>
                          </div>
                        </div>

                        <!-- Section 1: From Role (Inherited) -->
                        <div class="p-2 mb-2 rounded border bg-white">
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-muted d-flex align-items-center gap-1">
                              <i class="fa-solid fa-shield-halved text-info"></i>
                              <span>من الدور الأساسي:</span>
                            </span>
                            <div>
                              <% if (p.role.enabled) { %>
                                <span class="badge bg-info-subtle text-info-emphasis small py-0.5 px-2">مفعلة بالدور</span>
                              <% } else { %>
                                <span class="badge bg-light text-muted small py-0.5 px-2 border">غير مفعلة بالدور</span>
                              <% } %>
                            </div>
                          </div>
                          <div class="small text-muted" style="font-size: 0.8rem;">
                            <%= p.role.summary %>
                          </div>
                        </div>

                        <!-- Section 2: Direct User Configuration -->
                        <div class="p-2 mb-2 rounded border bg-white">
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                              <input
                                class="form-check-input direct-perm-toggle"
                                type="checkbox"
                                id="toggle_<%= p.permissionId %>"
                                data-permission-id="<%= p.permissionId %>"
                                <%= p.direct.enabled ? 'checked' : '' %>
                                <%= (isSelf || !canManagePermissions) ? 'disabled' : '' %>
                                style="cursor: pointer; transform: scale(1.15);"
                                title="تفعيل / تعطيل الصلاحية المباشرة"
                              >
                              <label class="form-check-label small fw-bold text-dark cursor-pointer mb-0" for="toggle_<%= p.permissionId %>">
                                صلاحية مباشرة للمستخدم:
                              </label>
                            </div>
                            <div>
                              <% if (p.direct.enabled) { %>
                                <span class="badge bg-primary-subtle text-primary small py-0.5 px-2">مباشرة مفعّلة</span>
                              <% } else { %>
                                <span class="badge bg-secondary-subtle text-secondary small py-0.5 px-2">غير مفعلة</span>
                              <% } %>
                            </div>
                          </div>
                          <div class="small text-muted" style="font-size: 0.8rem;">
                            <%= p.direct.summary %>
                          </div>
                        </div>

                        <!-- Section 3: Effective Combined Summary -->
                        <div class="small p-2 rounded mb-3 bg-light border border-light-subtle d-flex align-items-center justify-content-between">
                          <div>
                            <span class="fw-bold text-dark">النتيجة الفعالة:</span>
                            <span class="text-secondary ms-1"><%= p.effective.summary %></span>
                          </div>
                          <div>
                            <% if (p.effective.hasAnyDenyAll) { %>
                              <span class="badge bg-danger text-white small">محظور (DENY)</span>
                            <% } else if (p.effective.hasAnyAllow) { %>
                              <span class="badge bg-success text-white small">مسموح</span>
                            <% } else { %>
                              <span class="badge bg-secondary text-white small">لا يوجد وصول</span>
                            <% } %>
                          </div>
                        </div>
                      </div>

                      <!-- Action Button -->
                      <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                        <span class="small text-muted"><%= p.direct.rules.length %> قواعد مباشرة</span>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-primary open-user-rules-drawer-btn d-inline-flex align-items-center gap-1 px-3"
                          data-permission-id="<%= p.permissionId %>"
                          data-permission-name="<%= p.name %>"
                          data-permission-desc="<%= p.description || p.name %>"
                        >
                          <i class="fa-solid fa-gears"></i>
                          <span>إدارة القواعد المباشرة</span>
                        </button>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 12px;">
          <i class="fa-solid fa-key fs-1 text-secondary mb-3 d-block"></i>
          <p class="mb-0 fw-bold">لا توجد صلاحيات مسجلة في النظام حالياً</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Offcanvas Drawer for User Direct Access Rules Administration -->
<div
  class="offcanvas offcanvas-start border-0 shadow-lg"
  tabindex="-1"
  id="userAccessRulesOffcanvas"
  aria-labelledby="userAccessRulesOffcanvasLabel"
  style="width: 600px; max-width: 100vw;"
>
  <div class="offcanvas-header bg-light border-bottom p-3">
    <div class="d-flex align-items-center gap-2">
      <div class="rounded p-2 text-white" style="background-color: #714B67;">
        <i class="fa-solid fa-user-shield"></i>
      </div>
      <div>
        <h5 class="offcanvas-title fw-bold text-dark mb-0 fs-6" id="userAccessRulesOffcanvasLabel">
          قواعد الوصول المباشرة للمستخدم
        </h5>
        <code class="small text-muted" id="drawerPermissionCode">permission.code</code>
      </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button>
  </div>

  <div class="offcanvas-body p-4 d-flex flex-column justify-content-between">
    <div>
      <!-- Drawer Permission State Banner -->
      <div id="drawerStateBanner" class="p-3 rounded mb-4 bg-light border d-flex align-items-center justify-content-between">
        <div>
          <div class="fw-bold text-dark small" id="drawerPermissionDesc">وصف الصلاحية</div>
          <div class="small text-muted mt-1" id="drawerRuleCountsSummary">0 قواعد منح • 0 قواعد حظر</div>
        </div>
        <div id="drawerStatusBadge"></div>
      </div>

      <div id="drawerAlert" class="alert alert-danger d-none mb-3" role="alert"></div>

      <!-- Role Inherited Rules (Read-Only Preview if any) -->
      <div id="drawerRoleRulesSection" class="mb-3 d-none">
        <h6 class="fw-bold text-muted small mb-2 d-flex align-items-center gap-1">
          <i class="fa-solid fa-shield-halved text-info"></i>
          <span>قواعد موروثة من الدور (للاطلاع فقط):</span>
        </h6>
        <div id="drawerRoleRulesList" class="d-flex flex-column gap-1 mb-3"></div>
      </div>

      <!-- Direct Rules Section -->
      <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-list-check text-primary"></i>
            <span>قواعد الوصول المباشرة</span>
          </h6>
          <% if (!isSelf && canManagePermissions) { %>
            <button type="button" id="showAddRuleFormBtn" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" style="background-color: #714B67; border-color: #714B67;">
              <i class="fa-solid fa-plus"></i>
              <span>إضافة قاعدة</span>
            </button>
          <% } %>
        </div>

        <div id="drawerRulesList" class="d-flex flex-column gap-2">
          <!-- Populated dynamically via JS -->
          <div class="text-center py-4 text-muted small">
            <div class="spinner-border spinner-border-sm text-secondary mb-2" role="status"></div>
            <div>جاري تحميل القواعد...</div>
          </div>
        </div>
      </div>

      <!-- Add / Edit Rule Form Card (Collapsible) -->
      <% if (!isSelf && canManagePermissions) { %>
        <div id="ruleFormContainer" class="card border border-primary-subtle bg-light-subtle mb-4 d-none" style="border-radius: 10px;">
          <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold small text-dark" id="ruleFormTitle">إضافة قاعدة وصول مباشرة</span>
            <button type="button" id="cancelRuleFormBtn" class="btn btn-sm btn-link text-muted text-decoration-none p-0">إلغاء</button>
          </div>
          <div class="card-body p-3">
            <form id="accessRuleForm">
              <input type="hidden" id="formRuleId" value="">

              <!-- Effect -->
              <div class="mb-3">
                <label class="form-label fw-bold small text-dark mb-1">نوع التأثير (Effect)</label>
                <div class="d-flex gap-2">
                  <div class="form-check form-check-inline flex-grow-1 border rounded p-2 m-0 bg-white d-flex align-items-center gap-2">
                    <input class="form-check-input ms-0 me-2" type="radio" name="ruleEffect" id="effectAllow" value="ALLOW" checked>
                    <label class="form-check-label text-success fw-bold small cursor-pointer" for="effectAllow">
                      <i class="fa-solid fa-circle-check me-1"></i> منح (ALLOW)
                    </label>
                  </div>
                  <div class="form-check form-check-inline flex-grow-1 border rounded p-2 m-0 bg-white d-flex align-items-center gap-2">
                    <input class="form-check-input ms-0 me-2" type="radio" name="ruleEffect" id="effectDeny" value="DENY">
                    <label class="form-check-label text-danger fw-bold small cursor-pointer" for="effectDeny">
                      <i class="fa-solid fa-ban me-1"></i> حظر / استثناء (DENY)
                    </label>
                  </div>
                </div>
              </div>

              <!-- Preset Scope -->
              <div class="mb-3">
                <label class="form-label fw-bold small text-dark mb-1" for="rulePresetSelect">نطاق الوصول (Scope Preset)</label>
                <select class="form-select form-select-sm" id="rulePresetSelect" required>
                  <!-- Populated dynamically from capabilities -->
                </select>
                <div class="form-text small" id="presetHelpText">اختر نطاق الصلاحية المسموح</div>
              </div>

              <!-- Searchable Target Selector (Shown for SPECIFIC_* presets) -->
              <div id="targetSelectorContainer" class="mb-3 d-none">
                <label class="form-label fw-bold small text-dark mb-1" id="targetSelectorLabel">تحديد الأهداف</label>
                
                <!-- Selected Target Chips -->
                <div id="selectedTargetChips" class="d-flex flex-wrap gap-1 mb-2 p-2 bg-white border rounded min-h-38">
                  <span class="text-muted small align-self-center empty-chips-text">لم يتم تحديد أي أهداف بعد</span>
                </div>

                <!-- Search Input -->
                <div class="input-group input-group-sm mb-2">
                  <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
                  <input type="text" class="form-control" id="targetSearchInput" placeholder="بحث بالاسم أو الرمز...">
                </div>

                <!-- Scrollable Results Checkbox List -->
                <div id="targetSearchResults" class="border rounded bg-white p-2 overflow-auto" style="max-height: 180px;">
                  <div class="text-center py-2 text-muted small">جاري جلب القائمة...</div>
                </div>
              </div>

              <!-- Description -->
              <div class="mb-3">
                <label class="form-label fw-bold small text-dark mb-1" for="ruleDescriptionInput">ملاحظات / سبب القاعدة (اختياري)</label>
                <textarea class="form-control form-control-sm" id="ruleDescriptionInput" rows="2" placeholder="أدخل سبب أو وصف القاعدة إن وجد..."></textarea>
              </div>

              <!-- Submit Buttons -->
              <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                <button type="button" id="cancelRuleFormBtn2" class="btn btn-sm btn-light px-3">إلغاء</button>
                <button type="submit" id="saveRuleSubmitBtn" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1 px-3" style="background-color: #714B67; border-color: #714B67;">
                  <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                  <i class="fa-solid fa-check"></i>
                  <span id="saveRuleBtnText">حفظ القاعدة</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Drawer Footer -->
    <div class="pt-3 border-top d-flex justify-content-between align-items-center text-muted small">
      <span>تندمج الصلاحيات المباشرة مع صلاحيات الدور تلقائياً</span>
      <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="offcanvas">إغلاق</button>
    </div>
  </div>
</div>
</div>

<script src="/js/user-permissions.js"></script>
