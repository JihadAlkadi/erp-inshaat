<% const layoutEnabled = typeof layout_enabled !== 'undefined' ? layout_enabled : false; %>
<% if (!layoutEnabled) { %>
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>عذراً، حدث خطأ - <%= typeof statusCode !== 'undefined' ? statusCode : 500 %></title>
  
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  
  <style>
    body { 
      font-family: 'Cairo', sans-serif; 
      background-color: #714B67;
      background-image: radial-gradient(circle at 50% 0%, #8a5e7e 0%, #714b67 70%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .wrapper-class {
      width: 100%;
      max-width: 500px;
      padding: 15px;
    }
    .error-card {
      background: white;
      border-radius: 12px;
      padding: 3rem;
      box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    }
  </style>
</head>
<body>
<div class="wrapper-class">
<% } else { %>
<!-- If Layout is enabled (Dashboard view mode) -->
<style>
  .error-card {
    background: white;
    border-radius: 12px;
    padding: 3rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
  }
</style>
<div class="container mt-5" style="max-width: 600px;">
<% } %>

  <div class="error-card text-center">
    <div style="font-size: 70px; color: #714B67; margin-bottom: 1rem;">
      <% if (typeof statusCode !== 'undefined' && statusCode === 404) { %>
        <i class="fa-solid fa-map-location-dot"></i>
      <% } else if (typeof statusCode !== 'undefined' && (statusCode === 403 || statusCode === 401)) { %>
        <i class="fa-solid fa-lock"></i>
      <% } else { %>
        <i class="fa-solid fa-triangle-exclamation"></i>
      <% } %>
    </div>
    
    <h1 style="font-size: 3.5rem; font-weight: 800; color: #1F2937; margin-bottom: 0;"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %></h1>
    <h4 class="fw-bold mb-3" style="color: #4B5563;"><%= typeof message !== 'undefined' && message ? message : 'حدث خطأ غير متوقع' %></h4>
    
    <p class="text-muted" style="margin-bottom: 2.2rem; font-size: 1.05rem;">
      <% if (typeof statusCode !== 'undefined' && statusCode === 404) { %>
        يبدو أن الصفحة التي تحاول الوصول إليها غير موجودة أو تم إلغاؤها نهائياً.
      <% } else if (typeof statusCode !== 'undefined' && (statusCode === 403 || statusCode === 401)) { %>
        عذراً، لا تملك الصلاحيات الكافية للوصول، يرجى الاستمرار من الواجهة الرئيسية.
      <% } else { %>
        يبدو أن هناك مشكلة غير متوقعة، سيتم حل ذلك قريباً!
      <% } %>
    </p>
    
    <a href="/" class="btn fw-bold px-4 py-2" style="background-color: #714B67; color: white; border-radius: 50px;">
      العودة للرئيسية <i class="fa-solid fa-house ms-2"></i>
    </a>
  </div>

</div>
<% if (!layoutEnabled) { %>
</body>
</html>
<% } %>
